@* PDF Citation Viewer - Displays PDFs using browser's native PDF viewer *@

<div class="pdf-viewer-container">
    @if (!string.IsNullOrEmpty(ContentUrl))
    {
        <iframe src="@GetPdfUrl()"
                class="pdf-iframe"
                title="@FileName"
                @onload="HandleIframeLoaded"
                @onerror="HandleIframeError" />

        @if (_isLoading)
        {
            <div class="pdf-loading-overlay">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mt-2">Loading PDF...</MudText>
            </div>
        }

        @if (_loadError)
        {
            <div class="pdf-error-overlay">
                <MudIcon Icon="@Icons.Material.Outlined.Error" Size="Size.Large" Color="Color.Error" />
                <MudText Typo="Typo.h6" Class="mt-2">Unable to display PDF</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">The PDF viewer may not be available in your browser.</MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="mt-3"
                           Href="@ContentUrl"
                           Target="_blank">
                    Open in New Tab
                </MudButton>
            </div>
        }
    }
    else
    {
        <div class="pdf-placeholder">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
</div>

<style>
    .pdf-viewer-container {
        width: 100%;
        height: 100%;
        position: relative;
        background-color: #525659;
    }

    .pdf-iframe {
        width: 100%;
        height: 100%;
        border: none;
    }

    .pdf-loading-overlay,
    .pdf-error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.8);
        z-index: 5;
    }

    .pdf-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
</style>

@code {
    [Parameter]
    public string? ContentUrl { get; set; }

    [Parameter]
    public string? FileName { get; set; }

    [Parameter]
    public int? PageNumber { get; set; }

    private bool _isLoading = true;
    private bool _loadError;

    private string GetPdfUrl()
    {
        if (string.IsNullOrEmpty(ContentUrl))
            return string.Empty;

        // Add page number fragment if specified
        if (PageNumber.HasValue && PageNumber.Value > 0)
        {
            return $"{ContentUrl}#page={PageNumber.Value}";
        }

        return ContentUrl;
    }

    private void HandleIframeLoaded()
    {
        _isLoading = false;
        _loadError = false;
    }

    private void HandleIframeError()
    {
        _isLoading = false;
        _loadError = true;
    }

    protected override void OnParametersSet()
    {
        // Reset loading state when content changes
        if (!string.IsNullOrEmpty(ContentUrl))
        {
            _isLoading = true;
            _loadError = false;
        }
    }
}
