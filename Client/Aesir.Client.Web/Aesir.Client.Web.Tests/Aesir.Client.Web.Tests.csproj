    <ProjectReference Include="..\Modules\Aesir.Client.Web.Modules.Wizard\Aesir.Client.Web.Modules.Wizard.csproj" />
    <ProjectReference Include="..\Aesir.Client.Web.App\Aesir.Client.Web.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Moq" />
    <Using Include="FluentAssertions" />
    <Using Include="Bunit" />
  </ItemGroup>

</Project>
