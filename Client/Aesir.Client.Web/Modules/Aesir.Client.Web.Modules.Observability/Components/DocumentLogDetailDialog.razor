@namespace Aesir.Client.Web.Modules.Observability.Components

<MudDialog Class="document-log-detail-dialog">
    <DialogContent>
        <div class="dialog-header">
            <div class="header-icon">
                <MudIcon Icon="@GetOperationIcon()" Size="Size.Large" Class="@GetOperationClass()" />
            </div>
            <div class="header-content">
                <MudText Typo="Typo.h6" Class="dialog-title">@Log.FileName</MudText>
                <div class="header-badges">
                    <span class="operation-badge @GetOperationClass()">@Log.OperationType</span>
                    <span class="status-badge @GetStatusBadgeClass()">@Log.Status</span>
                </div>
            </div>
        </div>

        <MudDivider Class="my-3" />

        <div class="detail-grid">
            <div class="detail-item">
                <MudText Typo="Typo.caption" Class="detail-label">Started At</MudText>
                <MudText Typo="Typo.body2">@Log.StartedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
            </div>
            @if (Log.CompletedAt.HasValue)
            {
                <div class="detail-item">
                    <MudText Typo="Typo.caption" Class="detail-label">Completed At</MudText>
                    <MudText Typo="Typo.body2">@Log.CompletedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                </div>
            }
            @if (Log.ProcessingDurationMs.HasValue)
            {
                <div class="detail-item">
                    <MudText Typo="Typo.caption" Class="detail-label">Duration</MudText>
                    <MudText Typo="Typo.body2">@FormatDuration(Log.ProcessingDurationMs.Value)</MudText>
                </div>
            }
            @if (Log.FileSizeBytes.HasValue)
            {
                <div class="detail-item">
                    <MudText Typo="Typo.caption" Class="detail-label">File Size</MudText>
                    <MudText Typo="Typo.body2">@FormatFileSize(Log.FileSizeBytes.Value)</MudText>
                </div>
            }
            @if (!string.IsNullOrEmpty(Log.ContentType))
            {
                <div class="detail-item">
                    <MudText Typo="Typo.caption" Class="detail-label">Content Type</MudText>
                    <MudText Typo="Typo.body2">@Log.ContentType</MudText>
                </div>
            }
        </div>

        @if (Log.ChunkCount.HasValue || Log.EmbeddingCount.HasValue || Log.TokenCount.HasValue)
        {
            <MudText Typo="Typo.subtitle2" Class="section-title mt-4">Processing Statistics</MudText>
            <div class="stats-grid">
                @if (Log.ChunkCount.HasValue)
                {
                    <div class="stat-card">
                        <MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Medium" Class="stat-icon" />
                        <div class="stat-content">
                            <MudText Typo="Typo.caption" Class="stat-label">Chunks</MudText>
                            <MudText Typo="Typo.h6" Class="stat-value">@Log.ChunkCount</MudText>
                        </div>
                    </div>
                }
                @if (Log.EmbeddingCount.HasValue)
                {
                    <div class="stat-card">
                        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Medium" Class="stat-icon" />
                        <div class="stat-content">
                            <MudText Typo="Typo.caption" Class="stat-label">Embeddings</MudText>
                            <MudText Typo="Typo.h6" Class="stat-value">@Log.EmbeddingCount</MudText>
                        </div>
                    </div>
                }
                @if (Log.TokenCount.HasValue)
                {
                    <div class="stat-card">
                        <MudIcon Icon="@Icons.Material.Filled.Token" Size="Size.Medium" Class="stat-icon" />
                        <div class="stat-content">
                            <MudText Typo="Typo.caption" Class="stat-label">Tokens</MudText>
                            <MudText Typo="Typo.h6" Class="stat-value">@Log.TokenCount.Value.ToString("N0")</MudText>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(Log.FilePath))
        {
            <MudText Typo="Typo.subtitle2" Class="section-title mt-4">File Path</MudText>
            <MudPaper Class="code-block" Elevation="0">
                <code>@Log.FilePath</code>
            </MudPaper>
        }

        @if (!string.IsNullOrEmpty(Log.ErrorMessage))
        {
            <MudText Typo="Typo.subtitle2" Class="section-title mt-4 error-title">Error</MudText>
            <MudPaper Class="error-block" Elevation="0">
                <MudText Class="error-text">@Log.ErrorMessage</MudText>
            </MudPaper>
        }

        @if (Log.Metadata != null && Log.Metadata.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="section-title mt-4">Metadata</MudText>
            <MudPaper Class="metadata-block" Elevation="0">
                @foreach (var item in Log.Metadata)
                {
                    <div class="metadata-item">
                        <span class="metadata-key">@item.Key:</span>
                        <span class="metadata-value">@item.Value</span>
                    </div>
                }
            </MudPaper>
        }

        <div class="id-section mt-4">
            <MudText Typo="Typo.caption" Class="id-label">Log ID: @Log.Id</MudText>
            @if (Log.ConversationId.HasValue)
            {
                <MudText Typo="Typo.caption" Class="id-label">Conversation ID: @Log.ConversationId</MudText>
            }
            @if (Log.ChatSessionId.HasValue)
            {
                <MudText Typo="Typo.caption" Class="id-label">Chat Session ID: @Log.ChatSessionId</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .document-log-detail-dialog {
        min-width: 500px;
    }

    .dialog-header {
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

    .header-icon {
        padding: 12px;
        border-radius: 12px;
        background-color: rgba(255, 255, 255, 0.05);
    }

    .header-icon .op-upload { color: var(--aesir-op-upload); }
    .header-icon .op-embed { color: var(--aesir-op-embed); }
    .header-icon .op-update { color: var(--aesir-op-update); }
    .header-icon .op-delete { color: var(--aesir-op-delete); }

    .header-content {
        flex: 1;
    }

    .dialog-title {
        margin-bottom: 8px;
        word-break: break-word;
    }

    .header-badges {
        display: flex;
        gap: 8px;
    }

    .operation-badge {
        font-size: 0.75rem;
        padding: 2px 10px;
        border-radius: 12px;
        text-transform: uppercase;
        font-weight: 500;
    }

    .operation-badge.op-upload {
        background-color: rgba(var(--aesir-op-upload-rgb), 0.15);
        color: var(--aesir-op-upload);
    }

    .operation-badge.op-embed {
        background-color: rgba(var(--aesir-op-embed-rgb), 0.15);
        color: var(--aesir-op-embed);
    }

    .operation-badge.op-update {
        background-color: rgba(var(--aesir-op-update-rgb), 0.15);
        color: var(--aesir-op-update);
    }

    .operation-badge.op-delete {
        background-color: rgba(var(--aesir-op-delete-rgb), 0.15);
        color: var(--aesir-op-delete);
    }

    .status-badge {
        font-size: 0.75rem;
        padding: 2px 10px;
        border-radius: 12px;
        font-weight: 500;
    }

    .status-badge.status-completed {
        background-color: rgba(var(--aesir-success-rgb), 0.15);
        color: var(--aesir-success-light);
    }

    .status-badge.status-failed {
        background-color: rgba(var(--aesir-error-rgb), 0.15);
        color: var(--aesir-error);
    }

    .status-badge.status-inprogress {
        background-color: rgba(var(--aesir-primary-rgb), 0.15);
        color: var(--aesir-primary);
    }

    .section-title {
        color: var(--mud-palette-text-secondary);
        margin-bottom: 8px;
    }

    .error-title {
        color: var(--mud-palette-error) !important;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
    }

    .detail-item {
        padding: 8px 0;
    }

    .detail-label {
        color: var(--mud-palette-text-secondary);
        display: block;
        margin-bottom: 4px;
    }

    .stats-grid {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background-color: rgba(255, 255, 255, 0.03);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .stat-icon {
        color: var(--mud-palette-primary);
    }

    .stat-content {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        color: var(--mud-palette-text-secondary);
    }

    .stat-value {
        color: var(--mud-palette-text-primary);
        font-family: 'Consolas', 'Monaco', monospace;
    }

    .code-block {
        padding: 12px;
        background-color: rgba(0, 0, 0, 0.2);
        border-radius: 6px;
        overflow-x: auto;
    }

    .code-block code {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.85rem;
        color: var(--mud-palette-text-primary);
    }

    .error-block {
        padding: 12px;
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 6px;
    }

    .error-text {
        color: var(--mud-palette-error);
        font-size: 0.85rem;
    }

    .metadata-block {
        padding: 12px;
        background-color: rgba(255, 255, 255, 0.03);
        border-radius: 6px;
    }

    .metadata-item {
        display: flex;
        gap: 8px;
        padding: 4px 0;
        font-size: 0.85rem;
    }

    .metadata-key {
        color: var(--mud-palette-text-secondary);
        font-weight: 500;
    }

    .metadata-value {
        color: var(--mud-palette-text-primary);
        font-family: 'Consolas', 'Monaco', monospace;
    }

    .id-section {
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .id-label {
        color: var(--mud-palette-text-secondary);
        display: block;
        font-family: 'Consolas', 'Monaco', monospace;
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public required AesirDocumentLog Log { get; set; }

    private void Close() => MudDialog.Close();

    private string GetOperationClass() => Log.OperationType switch
    {
        DocumentOperationType.FileUploaded => "op-upload",
        DocumentOperationType.EmbeddingsGenerated => "op-embed",
        DocumentOperationType.EmbeddingsUpdated => "op-update",
        DocumentOperationType.FileDeleted => "op-delete",
        _ => "op-upload"
    };

    private string GetOperationIcon() => Log.OperationType switch
    {
        DocumentOperationType.FileUploaded => Icons.Material.Filled.Upload,
        DocumentOperationType.EmbeddingsGenerated => Icons.Material.Filled.Memory,
        DocumentOperationType.EmbeddingsUpdated => Icons.Material.Filled.Refresh,
        DocumentOperationType.FileDeleted => Icons.Material.Filled.Delete,
        _ => Icons.Material.Filled.Description
    };

    private string GetStatusBadgeClass() => Log.Status switch
    {
        DocumentLogStatus.Completed => "status-completed",
        DocumentLogStatus.Failed => "status-failed",
        DocumentLogStatus.InProgress => "status-inprogress",
        _ => "status-completed"
    };

    private static string FormatDuration(long ms)
    {
        if (ms < 1000) return $"{ms}ms";
        if (ms < 60000) return $"{ms / 1000.0:F1}s";
        return $"{ms / 60000.0:F1}m";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024.0):F1} MB";
        return $"{bytes / (1024.0 * 1024.0 * 1024.0):F1} GB";
    }
}
