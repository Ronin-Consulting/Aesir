@namespace Aesir.Client.Web.Modules.Observability.Components

<span class="status-indicator @GetStatusClass()" title="@GetStatusLabel()">
    <MudIcon Icon="@GetStatusIcon()" Size="Size.Small" Class="status-icon" />
    <span class="status-text">@GetStatusLabel()</span>
</span>

<style>
    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .status-icon {
        font-size: 0.85rem !important;
    }

    .status-completed {
        background-color: rgba(var(--aesir-success-rgb), 0.15);
        color: var(--aesir-success-light);
    }

    .status-failed {
        background-color: rgba(var(--aesir-error-rgb), 0.15);
        color: var(--aesir-error-light);
    }

    .status-cancelled {
        background-color: rgba(var(--aesir-warning-rgb), 0.15);
        color: var(--aesir-warning-light);
    }

    .status-inprogress {
        background-color: rgba(var(--aesir-primary-rgb), 0.15);
        color: var(--aesir-primary-light);
    }

    .status-text {
        white-space: nowrap;
    }
</style>

@code {
    /// <summary>
    /// Gets or sets the inference status to display.
    /// </summary>
    [Parameter]
    public InferenceStatus? Status { get; set; }

    /// <summary>
    /// Gets or sets the document log status to display (alternative to inference status).
    /// </summary>
    [Parameter]
    public DocumentLogStatus? DocumentStatus { get; set; }

    private string GetStatusClass()
    {
        if (DocumentStatus.HasValue)
        {
            return DocumentStatus.Value switch
            {
                DocumentLogStatus.Completed => "status-completed",
                DocumentLogStatus.Failed => "status-failed",
                DocumentLogStatus.InProgress => "status-inprogress",
                _ => "status-completed"
            };
        }

        return Status switch
        {
            InferenceStatus.Completed => "status-completed",
            InferenceStatus.Failed => "status-failed",
            InferenceStatus.Cancelled => "status-cancelled",
            InferenceStatus.InProgress => "status-inprogress",
            _ => "status-completed"
        };
    }

    private string GetStatusIcon()
    {
        if (DocumentStatus.HasValue)
        {
            return DocumentStatus.Value switch
            {
                DocumentLogStatus.Completed => Icons.Material.Filled.CheckCircle,
                DocumentLogStatus.Failed => Icons.Material.Filled.Error,
                DocumentLogStatus.InProgress => Icons.Material.Filled.Autorenew,
                _ => Icons.Material.Filled.CheckCircle
            };
        }

        return Status switch
        {
            InferenceStatus.Completed => Icons.Material.Filled.CheckCircle,
            InferenceStatus.Failed => Icons.Material.Filled.Error,
            InferenceStatus.Cancelled => Icons.Material.Filled.Cancel,
            InferenceStatus.InProgress => Icons.Material.Filled.Autorenew,
            _ => Icons.Material.Filled.CheckCircle
        };
    }

    private string GetStatusLabel()
    {
        if (DocumentStatus.HasValue)
        {
            return DocumentStatus.Value switch
            {
                DocumentLogStatus.Completed => "Done",
                DocumentLogStatus.Failed => "Failed",
                DocumentLogStatus.InProgress => "Running",
                _ => "Done"
            };
        }

        return Status switch
        {
            InferenceStatus.Completed => "Done",
            InferenceStatus.Failed => "Failed",
            InferenceStatus.Cancelled => "Cancelled",
            InferenceStatus.InProgress => "Running",
            _ => "Done"
        };
    }
}
