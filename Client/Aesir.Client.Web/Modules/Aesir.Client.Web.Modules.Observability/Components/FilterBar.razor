@namespace Aesir.Client.Web.Modules.Observability.Components
@using Aesir.Common.Models
@using Aesir.Client.Web.Modules.Observability.Models

<div class="filter-bar">
    <!-- Row 1: Search (full width) -->
    <div class="filter-row filter-row-search">
        <MudTextField @bind-Value="_searchText"
                      Placeholder="Search user queries..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="search-field"
                      Immediate="false"
                      DebounceInterval="500"
                      OnDebounceIntervalElapsed="OnSearchChanged" />
    </div>

    <!-- Row 2: Status Chips, Tool Chips, Date Range, Actions -->
    <div class="filter-row filter-row-filters">
        <div class="filter-group">
            <span class="filter-label">Status</span>
            <div class="filter-chips">
                <MudChip T="string"
                         Color="@(IsStatusSelected(InferenceStatus.Completed) ? Color.Success : Color.Default)"
                         Variant="@(IsStatusSelected(InferenceStatus.Completed) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ToggleStatus(InferenceStatus.Completed))"
                         Size="Size.Small"
                         Class="filter-chip">
                    Completed
                </MudChip>
                <MudChip T="string"
                         Color="@(IsStatusSelected(InferenceStatus.Failed) ? Color.Error : Color.Default)"
                         Variant="@(IsStatusSelected(InferenceStatus.Failed) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ToggleStatus(InferenceStatus.Failed))"
                         Size="Size.Small"
                         Class="filter-chip">
                    Failed
                </MudChip>
                <MudChip T="string"
                         Color="@(IsStatusSelected(InferenceStatus.Cancelled) ? Color.Warning : Color.Default)"
                         Variant="@(IsStatusSelected(InferenceStatus.Cancelled) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => ToggleStatus(InferenceStatus.Cancelled))"
                         Size="Size.Small"
                         Class="filter-chip">
                    Cancelled
                </MudChip>
            </div>
        </div>
        <div class="filter-group">
            <span class="filter-label">Tools</span>
            <div class="filter-chips">
                <MudChip T="string"
                         Color="@(_hasToolCallsFilter == true ? Color.Info : Color.Default)"
                         Variant="@(_hasToolCallsFilter == true ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => SetHasToolCallsFilter(true))"
                         Size="Size.Small"
                         Class="filter-chip">
                    With Tools
                </MudChip>
                <MudChip T="string"
                         Color="@(_hasToolCallsFilter == false ? Color.Info : Color.Default)"
                         Variant="@(_hasToolCallsFilter == false ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => SetHasToolCallsFilter(false))"
                         Size="Size.Small"
                         Class="filter-chip">
                    No Tools
                </MudChip>
            </div>
        </div>
        <div class="date-picker-wrapper">
            <MudDateRangePicker @bind-DateRange="_dateRange"
                                @bind-DateRange:after="OnDateRangeChangedAsync"
                                Label="Select Date Range"
                                Variant="Variant.Outlined"
                                Margin="Margin.Dense"
                                Clearable="true" />
        </div>
        <div class="filter-actions">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           OnClick="OnRefreshClicked"
                           Disabled="IsLoading"
                           aria-label="Refresh logs" />
            @if (HasActiveFilters)
            {
                <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                               Color="Color.Secondary"
                               OnClick="OnClearFiltersClicked"
                               aria-label="Clear filters" />
            }
        </div>
    </div>
</div>

<style>
    .filter-bar {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 12px 16px;
        background-color: rgba(255, 255, 255, 0.02);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        margin-bottom: 16px;
    }

    /* Row 1: Search (full width) */
    .filter-row-search {
        display: flex;
    }

    .filter-row-search .search-field {
        flex: 1;
    }

    /* Row 2: Filters + Date + Actions */
    .filter-row-filters {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px 20px;
    }

    .filter-group {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--mud-palette-text-secondary);
    }

    .filter-chips {
        display: flex;
        gap: 6px;
    }

    .filter-chip {
        cursor: pointer !important;
    }

    .date-picker-wrapper {
        width: 240px;
        flex-shrink: 0;
    }

    .filter-actions {
        display: flex;
        gap: 4px;
        align-items: center;
        margin-left: auto;
    }

    /* Responsive: Adjust for smaller screens */
    @@media (max-width: 900px) {
        .date-picker-wrapper {
            width: 200px;
        }
    }

    @@media (max-width: 600px) {
        .date-picker-wrapper {
            width: 100%;
        }

        .filter-actions {
            margin-left: auto;
        }
    }
</style>

@code {
    private DateRange? _dateRange;
    private string? _searchText;
    private bool? _hasToolCallsFilter;

    /// <summary>
    /// Gets or sets the current filter state.
    /// </summary>
    [Parameter]
    public LogFilter Filter { get; set; } = new();

    /// <summary>
    /// Gets or sets whether loading is in progress.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Event callback when filter changes.
    /// </summary>
    [Parameter]
    public EventCallback<LogFilter> FilterChanged { get; set; }

    /// <summary>
    /// Event callback when refresh is requested.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>
    /// Event callback when clear filters is requested.
    /// </summary>
    [Parameter]
    public EventCallback OnClearFilters { get; set; }

    private bool HasActiveFilters =>
        Filter.Statuses.Count > 0 ||
        Filter.From.HasValue ||
        Filter.To.HasValue ||
        Filter.HasToolCalls.HasValue ||
        !string.IsNullOrWhiteSpace(Filter.SearchText);

    protected override void OnParametersSet()
    {
        // Sync local state with filter
        if (Filter.From.HasValue && Filter.To.HasValue)
        {
            _dateRange = new DateRange(
                Filter.From.Value.LocalDateTime,
                Filter.To.Value.LocalDateTime);
        }
        else
        {
            _dateRange = null;
        }

        _searchText = Filter.SearchText;
        _hasToolCallsFilter = Filter.HasToolCalls;
    }

    private bool IsStatusSelected(InferenceStatus status) => Filter.Statuses.Contains(status);

    private async Task ToggleStatus(InferenceStatus status)
    {
        var newFilter = Filter.Clone();
        if (newFilter.Statuses.Contains(status))
            newFilter.Statuses.Remove(status);
        else
            newFilter.Statuses.Add(status);

        await FilterChanged.InvokeAsync(newFilter);
    }

    private async Task SetHasToolCallsFilter(bool? hasTools)
    {
        var newFilter = Filter.Clone();

        // Toggle off if clicking the same filter
        if (_hasToolCallsFilter == hasTools)
        {
            newFilter.HasToolCalls = null;
            _hasToolCallsFilter = null;
        }
        else
        {
            newFilter.HasToolCalls = hasTools;
            _hasToolCallsFilter = hasTools;
        }

        await FilterChanged.InvokeAsync(newFilter);
    }

    private async Task OnDateRangeChangedAsync()
    {
        var newFilter = Filter.Clone();
        if (_dateRange?.Start != null && _dateRange?.End != null)
        {
            newFilter.From = new DateTimeOffset(_dateRange.Start.Value, TimeSpan.Zero);
            newFilter.To = new DateTimeOffset(_dateRange.End.Value.AddDays(1).AddSeconds(-1), TimeSpan.Zero);
        }
        else
        {
            newFilter.From = null;
            newFilter.To = null;
        }

        await FilterChanged.InvokeAsync(newFilter);
    }

    private async Task OnSearchChanged(string? value)
    {
        var newFilter = Filter.Clone();
        newFilter.SearchText = string.IsNullOrWhiteSpace(value) ? null : value;

        await FilterChanged.InvokeAsync(newFilter);
    }

    private async Task OnRefreshClicked()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task OnClearFiltersClicked()
    {
        _dateRange = null;
        _searchText = null;
        _hasToolCallsFilter = null;
        await OnClearFilters.InvokeAsync();
    }
}
