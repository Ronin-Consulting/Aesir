@namespace Aesir.Client.Web.Modules.Observability.Components
@inject IObservabilityService ObservabilityService
@implements IDisposable

<div class="observability-content">
    <div class="observability-header">
        <div class="header-main">
            <div class="header-icon-wrapper">
                <div class="header-icon-bg"></div>
                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Large" Class="header-icon" />
            </div>
            <div class="header-text">
                <div class="header-title-row">
                    <MudText Typo="Typo.h4" Class="header-title">Observability</MudText>
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="header-description">
                    Monitor AI operations, document processing, and function executions.
                </MudText>
            </div>
        </div>
        @if (ObservabilityService.CurrentUnifiedResponse != null)
        {
            <div class="header-stats">
                <div class="stat-item">
                    <span class="stat-value">@ObservabilityService.CurrentUnifiedResponse.TotalCount</span>
                    <span class="stat-label">Total Logs</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-value">@ObservabilityService.CurrentUnifiedResponse.Page</span>
                    <span class="stat-label">of @ObservabilityService.CurrentUnifiedResponse.TotalPages pages</span>
                </div>
            </div>
        }
    </div>

    <UnifiedFilterBar Filter="_unifiedFilter"
                      FilterChanged="OnUnifiedFilterChanged"
                      OnRefresh="OnRefresh"
                      OnClearFilters="OnClearFilters"
                      IsLoading="ObservabilityService.IsLoading" />

    @if (ObservabilityService.IsLoading && ObservabilityService.UnifiedGroupedLogs.Count == 0)
    {
        <div class="loading-state">
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
            <p class="loading-text">Loading logs...</p>
        </div>
    }
    else if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="error-alert">
            <MudText>@_error</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="OnRefresh" Class="mt-2">
                Try Again
            </MudButton>
        </MudAlert>
    }
    else if (ObservabilityService.UnifiedGroupedLogs.Count == 0)
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Class="empty-icon" />
            <h3 class="empty-title">No logs found</h3>
            <p class="empty-text">
                @if (_unifiedFilter.HasActiveFilters)
                {
                    <span>No logs match your current filters. Try adjusting your filter criteria.</span>
                }
                else
                {
                    <span>No logs have been recorded yet. Start a chat or upload a document to generate some logs!</span>
                }
            </p>
            @if (_unifiedFilter.HasActiveFilters)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnClearFilters" Class="mt-4">
                    Clear Filters
                </MudButton>
            }
        </div>
    }
    else
    {
        <div class="timeline-container">
            @foreach (var group in ObservabilityService.UnifiedGroupedLogs)
            {
                <UnifiedTimelineGroup Group="group" />
            }
        </div>

        @if (ObservabilityService.CurrentUnifiedResponse?.TotalPages > 1)
        {
            <div class="pagination-bar">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="OnPreviousPage"
                           Disabled="!ObservabilityService.CurrentUnifiedResponse.HasPreviousPage || ObservabilityService.IsLoading"
                           StartIcon="@Icons.Material.Filled.ChevronLeft">
                    Previous
                </MudButton>
                <span class="pagination-info">
                    Page @ObservabilityService.CurrentUnifiedResponse.Page of @ObservabilityService.CurrentUnifiedResponse.TotalPages
                </span>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="OnNextPage"
                           Disabled="!ObservabilityService.CurrentUnifiedResponse.HasNextPage || ObservabilityService.IsLoading"
                           EndIcon="@Icons.Material.Filled.ChevronRight">
                    Next
                </MudButton>
            </div>
        }
    }
</div>

<style>
    .observability-content {
        padding: var(--aesir-space-6, 24px);
        max-width: 100%;
    }

    /* ==========================================================================
       Header Styles (matching SettingsContentHeader pattern)
       ========================================================================== */
    .observability-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: var(--aesir-space-8, 32px) 0 var(--aesir-space-6, 24px);
        gap: var(--aesir-space-6, 24px);
        flex-wrap: wrap;
    }

    .header-main {
        display: flex;
        align-items: flex-start;
        gap: var(--aesir-space-5, 20px);
        flex: 1;
        min-width: 280px;
    }

    .header-icon-wrapper {
        position: relative;
        flex-shrink: 0;
        width: 64px;
        height: 64px;
    }

    .header-icon-bg {
        width: 64px;
        height: 64px;
        border-radius: var(--aesir-radius-lg, 14px);
        background: linear-gradient(135deg,
            rgba(84, 169, 255, 0.15) 0%,
            rgba(123, 111, 255, 0.08) 100%
        );
        position: absolute;
        top: 0;
        left: 0;
    }

    .header-icon {
        position: relative;
        z-index: 1;
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mud-palette-primary);
    }

    .header-text {
        flex: 1;
        min-width: 0;
    }

    .header-title-row {
        display: flex;
        align-items: center;
        gap: var(--aesir-space-3, 12px);
        margin-bottom: var(--aesir-space-1, 4px);
    }

    .header-title {
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .header-description {
        line-height: 1.5;
        max-width: 500px;
    }

    /* ==========================================================================
       Stats Display
       ========================================================================== */
    .header-stats {
        display: flex;
        align-items: center;
        gap: var(--aesir-space-5, 20px);
        padding: var(--aesir-space-4, 16px) var(--aesir-space-5, 20px);
        background: rgba(255, 255, 255, 0.03);
        border-radius: var(--aesir-radius-lg, 14px);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--aesir-space-1, 4px);
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--mud-palette-primary);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat-divider {
        width: 1px;
        height: 32px;
        background: rgba(255, 255, 255, 0.1);
    }

    /* ==========================================================================
       Content States
       ========================================================================== */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        gap: 16px;
    }

    .loading-text {
        color: var(--mud-palette-text-secondary);
        font-size: 0.95rem;
    }

    .error-alert {
        margin-top: 20px;
    }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        text-align: center;
    }

    .empty-icon {
        font-size: 4rem !important;
        color: var(--mud-palette-text-secondary);
        opacity: 0.5;
        margin-bottom: 16px;
    }

    .empty-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--mud-palette-text-primary);
        margin: 0 0 8px 0;
    }

    .empty-text {
        font-size: 0.95rem;
        color: var(--mud-palette-text-secondary);
        max-width: 400px;
        margin: 0;
    }

    .timeline-container {
        position: relative;
    }

    .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-top: 24px;
        padding: 16px 0;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .pagination-info {
        font-size: 0.9rem;
        color: var(--mud-palette-text-secondary);
    }

    /* ==========================================================================
       Responsive - Tablet and Mobile
       ========================================================================== */
    @@media (max-width: 768px) {
        .observability-content {
            padding: var(--aesir-space-4, 16px);
        }

        .observability-header {
            padding: var(--aesir-space-6, 24px) 0 var(--aesir-space-4, 16px);
        }

        .header-main {
            flex-direction: column;
            gap: var(--aesir-space-3, 12px);
        }

        .header-icon-wrapper {
            display: none;
        }

        .header-stats {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@code {
    private UnifiedLogFilter _unifiedFilter = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        ObservabilityService.OnLogsChanged += OnLogsChanged;
        await LoadUnifiedLogsAsync();
    }

    private void OnLogsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadUnifiedLogsAsync()
    {
        _error = null;
        var result = await ObservabilityService.LoadUnifiedLogsAsync(_unifiedFilter);
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Failed to load logs";
        }
    }

    private async Task OnUnifiedFilterChanged(UnifiedLogFilter newFilter)
    {
        _unifiedFilter = newFilter;
        _error = null;
        var result = await ObservabilityService.ApplyUnifiedFilterAsync(_unifiedFilter);
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Failed to apply filter";
        }
    }

    private async Task OnRefresh()
    {
        _error = null;
        var result = await ObservabilityService.RefreshUnifiedAsync();
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Failed to refresh logs";
        }
    }

    private async Task OnClearFilters()
    {
        _unifiedFilter = new UnifiedLogFilter();
        _error = null;
        var result = await ObservabilityService.ClearUnifiedFilterAsync();
        if (!result.IsSuccess)
        {
            _error = result.Error ?? "Failed to clear filters";
        }
    }

    private async Task OnNextPage()
    {
        _error = null;
        _unifiedFilter.Page++;
        var result = await ObservabilityService.LoadUnifiedLogsAsync(_unifiedFilter);
        if (!result.IsSuccess)
        {
            _unifiedFilter.Page--;
            _error = result.Error ?? "Failed to load next page";
        }
    }

    private async Task OnPreviousPage()
    {
        _error = null;
        if (_unifiedFilter.Page > 1)
        {
            _unifiedFilter.Page--;
            var result = await ObservabilityService.LoadUnifiedLogsAsync(_unifiedFilter);
            if (!result.IsSuccess)
            {
                _unifiedFilter.Page++;
                _error = result.Error ?? "Failed to load previous page";
            }
        }
    }

    public void Dispose()
    {
        ObservabilityService.OnLogsChanged -= OnLogsChanged;
    }
}
