@namespace Aesir.Client.Web.Modules.Observability.Components
@using Aesir.Common.Models

<span class="log-type-chip @GetTypeClass()">
    <MudIcon Icon="@GetTypeIcon()" Size="Size.Small" Class="chip-icon" />
    <span class="chip-text">@GetTypeLabel()</span>
</span>

<style>
    .log-type-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .chip-icon {
        width: 14px !important;
        height: 14px !important;
    }

    .chip-text {
        line-height: 1.2;
    }

    /* Type-specific colors */
    .log-type-chip.type-function {
        background-color: rgba(16, 185, 129, 0.15);
        color: #10B981;
    }

    .log-type-chip.type-auto-function {
        background-color: rgba(245, 158, 11, 0.15);
        color: #F59E0B;
    }

    .log-type-chip.type-prompt {
        background-color: rgba(156, 39, 176, 0.15);
        color: #9C27B0;
    }
</style>

@code {
    /// <summary>
    /// Gets or sets the log type to display.
    /// </summary>
    [Parameter]
    public KernelLogType? Type { get; set; }

    private string GetTypeClass() => Type switch
    {
        KernelLogType.FunctionInvocation => "type-function",
        KernelLogType.AutoFunctionInvocation => "type-auto-function",
        KernelLogType.PromptRender => "type-prompt",
        _ => "type-function"
    };

    private string GetTypeIcon() => Type switch
    {
        KernelLogType.FunctionInvocation => Icons.Material.Filled.Functions,
        KernelLogType.AutoFunctionInvocation => Icons.Material.Filled.AutoAwesome,
        KernelLogType.PromptRender => Icons.Material.Filled.TextFields,
        _ => Icons.Material.Filled.Code
    };

    private string GetTypeLabel() => Type switch
    {
        KernelLogType.FunctionInvocation => "Function",
        KernelLogType.AutoFunctionInvocation => "Auto Function",
        KernelLogType.PromptRender => "Prompt",
        _ => "Unknown"
    };
}
