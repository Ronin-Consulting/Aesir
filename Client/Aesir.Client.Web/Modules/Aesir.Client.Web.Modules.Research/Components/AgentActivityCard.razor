@* Card showing individual agent activity during research *@

<div class="agent-activity-card @GetStatusClass()">
    <div class="agent-header">
        <div class="agent-icon-container">
            <MudIcon Icon="@GetRoleIcon()" Size="Size.Small" Class="role-icon" />
        </div>
        <div class="agent-info">
            <span class="agent-role">@GetRoleName()</span>
            @if (!string.IsNullOrEmpty(AgentName))
            {
                <span class="agent-name">@AgentName</span>
            }
        </div>
        <div class="status-indicator">
            @switch (Status)
            {
                case AgentActivityStatus.Pending:
                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" />
                    break;
                case AgentActivityStatus.Working:
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" StrokeWidth="3" />
                    break;
                case AgentActivityStatus.Completed:
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    break;
                case AgentActivityStatus.Error:
                    <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" />
                    break;
            }
        </div>
    </div>

    @if (Status == AgentActivityStatus.Working && !string.IsNullOrEmpty(CurrentTask))
    {
        <div class="current-task">
            <MudIcon Icon="@Icons.Material.Filled.ArrowRight" Size="Size.Small" />
            <span>@CurrentTask</span>
        </div>
    }

    @if (Status == AgentActivityStatus.Completed)
    {
        <div class="completion-info">
            @if (TokensUsed.HasValue)
            {
                <div class="stat">
                    <MudIcon Icon="@Icons.Material.Filled.Token" Size="Size.Small" />
                    <span>@TokensUsed.Value.ToString("N0") tokens</span>
                </div>
            }
            @if (Duration.HasValue)
            {
                <div class="stat">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Size="Size.Small" />
                    <span>@FormatDuration(Duration.Value)</span>
                </div>
            }
        </div>
    }

    @if (Status == AgentActivityStatus.Error && !string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-info">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
            <span>@ErrorMessage</span>
        </div>
    }
</div>

<style>
    .agent-activity-card {
        background-color: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        padding: 12px;
        transition: all 0.2s ease;
    }

    .agent-activity-card.pending {
        opacity: 0.6;
    }

    .agent-activity-card.working {
        background-color: rgba(var(--aesir-accent-rgb), 0.05);
        border-color: rgba(156, 39, 176, 0.2);
    }

    .agent-activity-card.completed {
        background-color: rgba(76, 175, 80, 0.05);
        border-color: rgba(76, 175, 80, 0.2);
    }

    .agent-activity-card.error {
        background-color: rgba(244, 67, 54, 0.05);
        border-color: rgba(244, 67, 54, 0.2);
    }

    .agent-header {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .agent-icon-container {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(var(--aesir-accent-rgb), 0.1);
    }

    .role-icon {
        color: var(--aesir-accent);
    }

    .agent-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .agent-role {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--mud-palette-text-primary);
    }

    .agent-name {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
    }

    .status-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
    }

    .agent-activity-card.pending .status-indicator {
        color: var(--mud-palette-text-disabled);
    }

    .agent-activity-card.working .status-indicator {
        color: var(--aesir-accent);
    }

    .agent-activity-card.completed .status-indicator {
        color: var(--aesir-success);
    }

    .agent-activity-card.error .status-indicator {
        color: var(--aesir-error);
    }

    .current-task {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding: 8px;
        background-color: rgba(var(--aesir-accent-rgb), 0.05);
        border-radius: 4px;
        font-size: 0.8rem;
        color: var(--aesir-accent);
    }

    .completion-info {
        display: flex;
        gap: 16px;
        margin-top: 8px;
        padding-top: 8px;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .stat {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
    }

    .stat .mud-icon-root {
        font-size: 0.9rem;
    }

    .error-info {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding: 8px;
        background-color: rgba(244, 67, 54, 0.1);
        border-radius: 4px;
        font-size: 0.8rem;
        color: var(--aesir-error);
    }
</style>

@code {
    /// <summary>
    /// The research role of the agent.
    /// </summary>
    [Parameter]
    public ResearchRoleBase Role { get; set; }

    /// <summary>
    /// The name of the agent.
    /// </summary>
    [Parameter]
    public string? AgentName { get; set; }

    /// <summary>
    /// The current activity status.
    /// </summary>
    [Parameter]
    public AgentActivityStatus Status { get; set; } = AgentActivityStatus.Pending;

    /// <summary>
    /// The current task being performed (when working).
    /// </summary>
    [Parameter]
    public string? CurrentTask { get; set; }

    /// <summary>
    /// Number of tokens used (when completed).
    /// </summary>
    [Parameter]
    public int? TokensUsed { get; set; }

    /// <summary>
    /// Duration of the agent's work (when completed).
    /// </summary>
    [Parameter]
    public TimeSpan? Duration { get; set; }

    /// <summary>
    /// Error message (when error).
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }

    private string GetStatusClass()
    {
        return Status switch
        {
            AgentActivityStatus.Pending => "pending",
            AgentActivityStatus.Working => "working",
            AgentActivityStatus.Completed => "completed",
            AgentActivityStatus.Error => "error",
            _ => "pending"
        };
    }

    private string GetRoleIcon()
    {
        return Role switch
        {
            ResearchRoleBase.DeepDiver => Icons.Material.Filled.Search,
            ResearchRoleBase.Synthesizer => Icons.Material.Filled.AutoAwesome,
            ResearchRoleBase.DevilsAdvocate => Icons.Material.Filled.Psychology,
            ResearchRoleBase.Chairman => Icons.Material.Filled.Gavel,
            _ => Icons.Material.Filled.SmartToy
        };
    }

    private string GetRoleName()
    {
        return Role switch
        {
            ResearchRoleBase.DeepDiver => "Deep Diver",
            ResearchRoleBase.Synthesizer => "Synthesizer",
            ResearchRoleBase.DevilsAdvocate => "Devil's Advocate",
            ResearchRoleBase.Chairman => "Chairman",
            _ => Role.ToString()
        };
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1)
            return $"{(int)duration.TotalSeconds}s";
        if (duration.TotalHours < 1)
            return $"{(int)duration.TotalMinutes}m {duration.Seconds}s";
        return $"{(int)duration.TotalHours}h {duration.Minutes}m";
    }
}

@code {
    /// <summary>
    /// Status of an agent's activity.
    /// </summary>
    public enum AgentActivityStatus
    {
        Pending,
        Working,
        Completed,
        Error
    }
}
