@* Phase progress bar showing research workflow stages *@

<div class="phase-progress-bar">
    @foreach (var (phase, index) in _phases.Select((p, i) => (p, i)))
    {
        var status = GetPhaseStatus(phase.Phase);
        var isLast = index == _phases.Count - 1;

        <div class="phase-step @status">
            <div class="step-indicator">
                @if (status == "completed")
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                }
                else if (status == "active")
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" StrokeWidth="3" />
                }
                else
                {
                    <div class="step-circle">@(index + 1)</div>
                }
            </div>
            <span class="step-label">@phase.Name</span>
            @if (!isLast)
            {
                <div class="step-connector @status"></div>
            }
        </div>
    }
</div>

<style>
    .phase-progress-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 16px 0;
        position: relative;
    }

    .phase-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        flex: 1;
        position: relative;
        z-index: 1;
    }

    .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background-color: var(--mud-palette-background);
    }

    .step-circle {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid var(--mud-palette-text-disabled);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--mud-palette-text-disabled);
        background-color: var(--mud-palette-background);
    }

    .phase-step.pending .step-indicator {
        color: var(--mud-palette-text-disabled);
    }

    .phase-step.active .step-indicator {
        color: #9C27B0;
    }

    .phase-step.active .step-circle {
        border-color: #9C27B0;
        color: #9C27B0;
    }

    .phase-step.completed .step-indicator {
        color: #4CAF50;
    }

    .step-label {
        font-size: 0.7rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        text-align: center;
        white-space: nowrap;
    }

    .phase-step.pending .step-label {
        color: var(--mud-palette-text-disabled);
    }

    .phase-step.active .step-label {
        color: #9C27B0;
        font-weight: 600;
    }

    .phase-step.completed .step-label {
        color: var(--mud-palette-text-primary);
    }

    .step-connector {
        position: absolute;
        top: 16px;
        left: calc(50% + 20px);
        right: calc(-50% + 20px);
        height: 2px;
        background-color: var(--mud-palette-text-disabled);
        z-index: 0;
    }

    .step-connector.completed {
        background-color: #4CAF50;
    }

    .step-connector.active {
        background: linear-gradient(90deg, #4CAF50 0%, #9C27B0 100%);
    }

    /* Responsive adjustments */
    @@media (max-width: 600px) {
        .step-label {
            font-size: 0.6rem;
        }

        .step-circle {
            width: 24px;
            height: 24px;
            font-size: 0.65rem;
        }

        .step-indicator {
            width: 28px;
            height: 28px;
        }
    }
</style>

@code {
    /// <summary>
    /// The current phase of the research.
    /// </summary>
    [Parameter]
    public ResearchPhaseBase? CurrentPhase { get; set; }

    /// <summary>
    /// Whether the research is completed.
    /// </summary>
    [Parameter]
    public bool IsCompleted { get; set; }

    /// <summary>
    /// Whether the research has failed.
    /// </summary>
    [Parameter]
    public bool IsFailed { get; set; }

    private readonly List<(ResearchPhaseBase Phase, string Name)> _phases =
    [
        (ResearchPhaseBase.Planning, "Planning"),
        (ResearchPhaseBase.Research, "Research"),
        (ResearchPhaseBase.Anonymization, "Anonymize"),
        (ResearchPhaseBase.PeerReview, "Review"),
        (ResearchPhaseBase.Synthesis, "Synthesis")
    ];

    private string GetPhaseStatus(ResearchPhaseBase phase)
    {
        if (IsCompleted)
            return "completed";

        if (IsFailed)
        {
            var failedPhaseOrder = CurrentPhase.HasValue ? GetPhaseOrder(CurrentPhase.Value) : -1;
            var phaseOrder = GetPhaseOrder(phase);
            return phaseOrder < failedPhaseOrder ? "completed" : "pending";
        }

        if (!CurrentPhase.HasValue)
            return "pending";

        var currentOrder = GetPhaseOrder(CurrentPhase.Value);
        var thisOrder = GetPhaseOrder(phase);

        if (thisOrder < currentOrder)
            return "completed";
        if (thisOrder == currentOrder)
            return "active";

        return "pending";
    }

    private int GetPhaseOrder(ResearchPhaseBase phase)
    {
        return phase switch
        {
            ResearchPhaseBase.Clarification => 0,
            ResearchPhaseBase.Planning => 1,
            ResearchPhaseBase.Research => 2,
            ResearchPhaseBase.Anonymization => 3,
            ResearchPhaseBase.PeerReview => 4,
            ResearchPhaseBase.Synthesis => 5,
            _ => 0
        };
    }
}
