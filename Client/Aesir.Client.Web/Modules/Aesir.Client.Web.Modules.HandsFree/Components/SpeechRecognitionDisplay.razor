@inject IMarkdownService MarkdownService

<div class="speech-display">
    @if (!string.IsNullOrEmpty(Transcription))
    {
        <div class="transcription-container">
            <div class="label">You said:</div>
            <div class="text transcription @(IsFinal ? "final" : "partial")">
                @Transcription
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Response))
    {
        <div class="response-container">
            <div class="label">Assistant:</div>
            <div class="text response markdown-body">
                @((MarkupString)MarkdownService.ToHtml(Response))
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error-container">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Class="error-icon" />
            <div class="text error">@ErrorMessage</div>
        </div>
    }
</div>

@code {
    /// <summary>
    /// The transcribed user speech.
    /// </summary>
    [Parameter]
    public string? Transcription { get; set; }

    /// <summary>
    /// Indicates if the transcription is final.
    /// </summary>
    [Parameter]
    public bool IsFinal { get; set; }

    /// <summary>
    /// The assistant's response text.
    /// </summary>
    [Parameter]
    public string? Response { get; set; }

    /// <summary>
    /// Error message to display.
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }
}

<style>
    .speech-display {
        width: 100%;
        max-width: 600px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: 24px;
        max-height: calc(100vh - 400px);
        overflow-y: auto;
    }

    .transcription-container,
    .response-container,
    .error-container {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: rgba(255, 255, 255, 0.5);
        margin-bottom: 8px;
    }

    .text {
        font-size: 16px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.9);
    }

    .transcription.partial {
        opacity: 0.7;
        font-style: italic;
    }

    .transcription.final {
        opacity: 1;
    }

    .response-container {
        border-color: rgba(156, 39, 176, 0.3);
        background: rgba(156, 39, 176, 0.1);
        max-height: 300px;
        overflow-y: auto;
    }

    .response-container .label {
        color: rgba(156, 39, 176, 0.8);
    }

    /* Markdown body styles for response */
    .response.markdown-body {
        font-size: 16px;
        line-height: 1.6;
    }

    .response.markdown-body p {
        margin: 0 0 1em 0;
    }

    .response.markdown-body p:last-child {
        margin-bottom: 0;
    }

    .response.markdown-body h1,
    .response.markdown-body h2,
    .response.markdown-body h3,
    .response.markdown-body h4 {
        margin: 1em 0 0.5em 0;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.95);
    }

    .response.markdown-body h1 { font-size: 1.5em; }
    .response.markdown-body h2 { font-size: 1.3em; }
    .response.markdown-body h3 { font-size: 1.1em; }

    .response.markdown-body ul,
    .response.markdown-body ol {
        margin: 0.5em 0;
        padding-left: 1.5em;
    }

    .response.markdown-body li {
        margin: 0.25em 0;
    }

    .response.markdown-body code {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        font-family: 'Monaco', 'Menlo', 'Consolas', monospace;
        font-size: 0.9em;
    }

    .response.markdown-body pre {
        background: rgba(0, 0, 0, 0.3);
        padding: 1em;
        border-radius: 8px;
        overflow-x: auto;
        margin: 0.5em 0;
    }

    .response.markdown-body pre code {
        background: none;
        padding: 0;
    }

    .response.markdown-body blockquote {
        border-left: 3px solid rgba(156, 39, 176, 0.5);
        margin: 0.5em 0;
        padding-left: 1em;
        color: rgba(255, 255, 255, 0.7);
    }

    .response.markdown-body a {
        color: #BB86FC;
        text-decoration: none;
    }

    .response.markdown-body a:hover {
        text-decoration: underline;
    }

    .response.markdown-body table {
        border-collapse: collapse;
        margin: 0.5em 0;
        width: 100%;
    }

    .response.markdown-body th,
    .response.markdown-body td {
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 0.5em;
        text-align: left;
    }

    .response.markdown-body th {
        background: rgba(0, 0, 0, 0.2);
        font-weight: 600;
    }

    .error-container {
        display: flex;
        align-items: center;
        gap: 8px;
        border-color: rgba(244, 67, 54, 0.3);
        background: rgba(244, 67, 54, 0.1);
    }

    .error-icon {
        color: #F44336;
    }

    .error {
        color: rgba(244, 67, 54, 0.9);
    }

    /* Custom scrollbar styling */
    .speech-display::-webkit-scrollbar,
    .response-container::-webkit-scrollbar {
        width: 6px;
    }

    .speech-display::-webkit-scrollbar-track,
    .response-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .speech-display::-webkit-scrollbar-thumb,
    .response-container::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }

    .speech-display::-webkit-scrollbar-thumb:hover,
    .response-container::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }
</style>
