@using Aesir.Client.Web.Modules.HandsFree.Models

<div class="ptt-container">
    <button class="ptt-button @GetButtonClass()"
            @onmousedown="OnPressStart"
            @onmouseup="OnPressEnd"
            @onmouseleave="OnPressEnd"
            @ontouchstart="OnPressStart"
            @ontouchend="OnPressEnd"
            @ontouchcancel="OnPressEnd"
            disabled="@IsDisabled">
        <MudIcon Icon="@Icons.Material.Filled.Mic" Size="Size.Large" Class="ptt-icon" />
        <span class="ptt-label">@GetLabel()</span>
    </button>
    <div class="ptt-hint">@GetHint()</div>
</div>

@code {
    /// <summary>
    /// The current hands-free state.
    /// </summary>
    [Parameter]
    public HandsFreeState State { get; set; } = HandsFreeState.Idle;

    /// <summary>
    /// Callback when button is pressed (start listening).
    /// </summary>
    [Parameter]
    public EventCallback OnPress { get; set; }

    /// <summary>
    /// Callback when button is released (stop listening).
    /// </summary>
    [Parameter]
    public EventCallback OnRelease { get; set; }

    private bool IsDisabled => State == HandsFreeState.Processing;
    private bool IsPressed => State == HandsFreeState.Listening;

    private string GetButtonClass()
    {
        var classes = new List<string>();

        if (IsPressed)
            classes.Add("pressed");

        if (IsDisabled)
            classes.Add("disabled");

        classes.Add(State switch
        {
            HandsFreeState.Listening => "state-listening",
            HandsFreeState.Processing => "state-processing",
            HandsFreeState.Speaking => "state-speaking",
            HandsFreeState.Error => "state-error",
            _ => "state-idle"
        });

        return string.Join(" ", classes);
    }

    private string GetLabel() => State switch
    {
        HandsFreeState.Idle => "Hold to Speak",
        HandsFreeState.Listening => "Listening...",
        HandsFreeState.Processing => "Processing...",
        HandsFreeState.Speaking => "Tap to Interrupt",
        HandsFreeState.Error => "Try Again",
        _ => "Hold to Speak"
    };

    private string GetHint() => State switch
    {
        HandsFreeState.Idle => "Press and hold, or use Space bar",
        HandsFreeState.Listening => "Release when done speaking",
        HandsFreeState.Processing => "Analyzing your speech...",
        HandsFreeState.Speaking => "Tap button or Space to stop",
        HandsFreeState.Error => "Something went wrong. Try again.",
        _ => ""
    };

    private async Task OnPressStart()
    {
        if (State == HandsFreeState.Speaking)
        {
            // Interrupt current speech
            await OnRelease.InvokeAsync();
            return;
        }

        if (State == HandsFreeState.Idle || State == HandsFreeState.Error)
        {
            await OnPress.InvokeAsync();
        }
    }

    private async Task OnPressEnd()
    {
        if (State == HandsFreeState.Listening)
        {
            await OnRelease.InvokeAsync();
        }
    }
}

<style>
    .ptt-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        margin-top: 40px;
    }

    .ptt-button {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        border: 3px solid rgba(255, 255, 255, 0.2);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.2s ease;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .ptt-button:hover:not(.disabled) {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.1) 100%);
        border-color: rgba(255, 255, 255, 0.3);
        transform: scale(1.05);
    }

    .ptt-button:active:not(.disabled),
    .ptt-button.pressed {
        transform: scale(0.95);
    }

    .ptt-button.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .ptt-icon {
        color: rgba(255, 255, 255, 0.9);
    }

    .ptt-label {
        color: rgba(255, 255, 255, 0.7);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .ptt-hint {
        color: rgba(255, 255, 255, 0.4);
        font-size: 12px;
        text-align: center;
        max-width: 200px;
    }

    /* State-specific styles */
    .ptt-button.state-listening {
        border-color: rgba(76, 175, 80, 0.7);
        background: linear-gradient(135deg, rgba(76, 175, 80, 0.3) 0%, rgba(76, 175, 80, 0.15) 100%);
        box-shadow: 0 0 30px rgba(76, 175, 80, 0.4);
    }

    .ptt-button.state-listening .ptt-icon {
        color: #4CAF50;
        animation: iconPulse 0.8s ease-in-out infinite;
    }

    .ptt-button.state-processing {
        border-color: rgba(255, 193, 7, 0.7);
        background: linear-gradient(135deg, rgba(255, 193, 7, 0.2) 0%, rgba(255, 193, 7, 0.1) 100%);
    }

    .ptt-button.state-processing .ptt-icon {
        color: #FFC107;
        animation: iconSpin 1.5s linear infinite;
    }

    .ptt-button.state-speaking {
        border-color: rgba(156, 39, 176, 0.7);
        background: linear-gradient(135deg, rgba(156, 39, 176, 0.2) 0%, rgba(156, 39, 176, 0.1) 100%);
    }

    .ptt-button.state-speaking .ptt-icon {
        color: #9C27B0;
    }

    .ptt-button.state-error {
        border-color: rgba(244, 67, 54, 0.7);
        background: linear-gradient(135deg, rgba(244, 67, 54, 0.2) 0%, rgba(244, 67, 54, 0.1) 100%);
    }

    .ptt-button.state-error .ptt-icon {
        color: #F44336;
    }

    @@keyframes iconPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.1); }
    }

    @@keyframes iconSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>
