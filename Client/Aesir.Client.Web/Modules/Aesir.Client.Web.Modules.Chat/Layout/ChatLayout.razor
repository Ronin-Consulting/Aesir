@inherits LayoutComponentBase
@using Aesir.Client.Web.Modules.Chat.Components
@using Aesir.Client.Web.Modules.Chat.Models
@using Aesir.Client.Web.Modules.Chat.Services
@inject INavigationRegistry NavigationRegistry
@inject NavigationManager NavigationManager
@inject IChatStateService ChatState
@inject IChatHistoryService HistoryService
@inject IDialogService DialogService
@inject IThemeService ThemeService
@inject IAgentToolsService AgentToolsService
@inject IDocumentApiService DocumentService
@implements IDisposable

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Never"
               Elevation="0"
               Width="280px"
               Class="chat-drawer">
        @* Navigation Items with New Chat Button *@
        <div class="nav-header pt-3 px-2">
            <div class="chats-nav-item @(IsOnChatsPage ? "active" : "")" @onclick="NavigateToChats">
                <div class="nav-item-content">
                    <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Small" />
                    <span>Chats</span>
                </div>
                <div class="new-chat-btn-wrapper" @onclick:stopPropagation>
                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   OnClick="@StartNewChat"
                                   Title="New chat"
                                   Class="new-chat-btn-small" />
                </div>
            </div>
        </div>

        @* Recents Section - Show starred chats first, then recent chats grouped by date *@
        @if (_recentSessions.Any())
        {
            <div class="recents-section px-2 mt-2">
                <div class="recents-list">
                    @{
                        var starredSessions = _recentSessions.Where(s => s.IsStarred).ToList();
                        var nonStarredSessions = _recentSessions.Where(s => !s.IsStarred).Take(_displayCount).ToList();
                        var groupedSessions = GroupSessionsByDate(nonStarredSessions);
                    }
                    @* Starred Section - Always visible *@
                    @if (starredSessions.Any())
                    {
                        <div class="starred-section-header px-2 py-1 mt-2">
                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                     Size="Size.Small"
                                     Color="Color.Warning"
                                     Class="starred-icon" />
                            <span class="section-label">Starred</span>
                        </div>
                        <div class="starred-items">
                            @foreach (var session in starredSessions)
                            {
                                <ChatHistoryItem Session="session"
                                                 IsSelected="@(ChatState.CurrentSessionId == session.Id)"
                                                 IsStarred="@session.IsStarred"
                                                 ShowTimestamp="false"
                                                 OnClick="HandleSessionClick"
                                                 OnDelete="HandleSessionDelete"
                                                 OnRename="HandleSessionRename"
                                                 OnStarChanged="HandleSessionStarChanged" />
                            }
                        </div>
                    }
                    @* Recents Section - Collapsible with Hide/Show toggle *@
                    @if (nonStarredSessions.Any())
                    {
                        <div class="recents-section-header px-2 py-1 mt-2">
                            <span class="section-label">Recents</span>
                            <span class="hide-show-toggle @(_recentsSectionCollapsed ? "collapsed" : "")" @onclick="ToggleRecentsSection">
                                @(_recentsSectionCollapsed ? "Show" : "Hide")
                            </span>
                        </div>
                        @if (!_recentsSectionCollapsed)
                        {
                            <div class="recents-items">
                                @foreach (var group in groupedSessions)
                                {
                                    <MudText Typo="Typo.overline" Class="px-2 py-1 mt-2 mud-text-secondary date-group-header">
                                        @group.Key
                                    </MudText>
                                    @foreach (var session in group.Value)
                                    {
                                        <ChatHistoryItem Session="session"
                                                         IsSelected="@(ChatState.CurrentSessionId == session.Id)"
                                                         IsStarred="@session.IsStarred"
                                                         ShowTimestamp="false"
                                                         OnClick="HandleSessionClick"
                                                         OnDelete="HandleSessionDelete"
                                                         OnRename="HandleSessionRename"
                                                         OnStarChanged="HandleSessionStarChanged" />
                                    }
                                }
                            </div>
                        }
                    }
                </div>
                @{
                    var totalNonStarred = _recentSessions.Count(s => !s.IsStarred);
                }
                @if (totalNonStarred > _displayCount)
                {
                    <div class="load-more-container">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@LoadMore"
                                   Class="load-more-btn">
                            Load More (@(totalNonStarred - _displayCount) more)
                        </MudButton>
                    </div>
                }
            </div>
        }

        @* User Section with Popup Menu - wrapped to stick to bottom *@
        <div class="user-section-wrapper">
            <MudDivider Class="user-divider" />
            <MudMenu AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter" Class="user-menu-container">
            <ActivatorContent>
                <div class="user-menu-activator pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 140px;">
                                @_userId
                            </MudText>
                        </MudStack>
                        <MudIcon Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" Class="mud-text-secondary" />
                    </MudStack>
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="user-popup-menu">
                    <MudText Typo="Typo.body2" Class="px-4 py-2 mud-text-secondary">
                        @_userId
                    </MudText>
                    <MudDivider Class="my-1" />
                    <MudMenuItem Href="/settings" Icon="@Icons.Material.Filled.Settings">
                        Settings
                    </MudMenuItem>
                    <MudMenuItem Href="/settings/inference-engines" Icon="@Icons.Material.Filled.Memory">
                        Inference Engines
                    </MudMenuItem>
                    <MudMenuItem Href="/settings/agents" Icon="@Icons.Material.Filled.SmartToy">
                        Agents
                    </MudMenuItem>
                    <MudDivider Class="my-1" />
                    <MudMenuItem Icon="@Icons.Material.Filled.HelpOutline">
                        Get Help
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Info">
                        About ÆSIR
                    </MudMenuItem>
                </div>
            </ChildContent>
            </MudMenu>
        </div>
    </MudDrawer>

    <MudMainContent Class="chat-main-content">
        @* Floating Sidebar Toggle - Always visible at left edge of main content *@
        <div class="sidebar-toggle-container">
            <MudIconButton Icon="@Icons.Material.Filled.ViewSidebar"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="@ToggleDrawer"
                           Title="@(_drawerOpen ? "Close sidebar" : "Open sidebar")"
                           Class="sidebar-toggle-btn" />
        </div>

        @* Centered Title with Dropdown Menu - Between sidebar toggle and theme toggle *@
        <div class="title-container">
            @if (ChatState.CurrentSessionId.HasValue)
            {
                <MudMenu AnchorOrigin="Origin.BottomCenter"
                         TransformOrigin="Origin.TopCenter"
                         Class="title-menu">
                    <ActivatorContent>
                        <div class="title-button">
                            <span class="session-title @(string.IsNullOrEmpty(ChatState.CurrentSessionTitle) ? "untitled" : "")">
                                @(string.IsNullOrEmpty(ChatState.CurrentSessionTitle) ? "Untitled Chat" : TruncateTitle(ChatState.CurrentSessionTitle, 40))
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Size="Size.Small"
                                     Class="dropdown-icon" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem OnClick="@ToggleCurrentSessionStar" Class="menu-item">
                            <div class="menu-item-content">
                                <MudIcon Icon="@(IsCurrentSessionStarred ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                         Size="Size.Small"
                                         Color="@(IsCurrentSessionStarred ? Color.Warning : Color.Default)" />
                                <span>@(IsCurrentSessionStarred ? "Unstar" : "Star")</span>
                            </div>
                        </MudMenuItem>
                        <MudMenuItem OnClick="@ShowRenameDialog" Class="menu-item">
                            <div class="menu-item-content">
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                                <span>Rename</span>
                            </div>
                        </MudMenuItem>
                        <MudDivider Class="my-1" />
                        <MudMenuItem OnClick="@ShowDeleteConfirmation" Class="menu-item delete-item">
                            <div class="menu-item-content">
                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" />
                                <span class="delete-text">Delete</span>
                            </div>
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
        </div>

        @* Top Right Controls *@
        <div class="top-right-controls">
            @if (_showDocumentsButton && ChatState.CurrentSessionId.HasValue)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.FolderOpen"
                               Color="Color.Default"
                               Size="Size.Small"
                               OnClick="@ToggleDocumentsDrawer"
                               Title="@(_documentsDrawerOpen ? "Hide documents" : "Show documents")"
                               Class="@($"control-btn {(_documentsDrawerOpen ? "active" : "")}")" />
            }
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="@ToggleThemeAsync"
                           Title="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")"
                           Class="control-btn" />
        </div>
        <CascadingValue Name="ConversationFiles" Value="_conversationFiles">
            <CascadingValue Name="ConversationFilesLoaded" Value="_conversationFilesLoaded">
                @Body
            </CascadingValue>
        </CascadingValue>
    </MudMainContent>

    @* Right Drawer for Documents *@
    <MudDrawer @bind-Open="_documentsDrawerOpen"
               Anchor="Anchor.End"
               Variant="DrawerVariant.Temporary"
               Elevation="1"
               Width="320px"
               Class="documents-drawer">
        <div class="documents-drawer-header">
            <MudText Typo="Typo.subtitle1" Class="drawer-title">
                <MudIcon Icon="@Icons.Material.Outlined.Folder" Size="Size.Small" Class="mr-2" />
                Documents
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="@(() => _documentsDrawerOpen = false)"
                           Class="close-btn" />
        </div>
        <ConversationDocumentsList @ref="_documentsListRef"
                                   ConversationId="@ChatState.CurrentSessionId"
                                   OnFilesChanged="@HandleFilesChanged" />
    </MudDrawer>
</MudLayout>

@* Citation Viewer Modal - Displays when a citation link is clicked *@
<CitationViewer />

@* Citation Handler - Receives citation click events from JavaScript *@
<CitationHandler />

