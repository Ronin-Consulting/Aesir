@code {
    private const int InitialDisplayCount = 25;
    private const int LoadMoreIncrement = 25;

    [CascadingParameter(Name = "IsDarkMode")]
    private bool _isDarkMode { get; set; } = true;

    private bool _drawerOpen = true;
    private bool _documentsDrawerOpen;
    private bool _showDocumentsButton;
    private string _userId = "blangford@gmail.com";
    private List<AesirChatSessionItem> _recentSessions = new();
    private int _displayCount = InitialDisplayCount;
    private bool _recentsSectionCollapsed;
    private ConversationDocumentsList? _documentsListRef;

    // Compute IsStarred from the actual session data
    private bool IsCurrentSessionStarred =>
        ChatState.CurrentSessionId.HasValue &&
        _recentSessions.FirstOrDefault(s => s.Id == ChatState.CurrentSessionId.Value)?.IsStarred == true;

    // Only highlight Chats nav item when on /chats page (not /chat or /chat?session=...)
    private bool IsOnChatsPage => NavigationManager.Uri.TrimEnd('/').EndsWith("/chats", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        HistoryService.OnSessionsChanged += HandleSessionsChanged;
        ChatState.OnConversationChanged += HandleConversationChanged;
        ChatState.OnAgentChanged += HandleAgentChangedAsync;
        ChatState.OnSessionChanged += HandleSessionChangedAsync;
        ChatState.OnDocumentDeleted += HandleDocumentDeleted;

        // Load all sessions on startup for recents (pagination handled via _displayCount)
        await HistoryService.LoadSessionsAsync();
        _recentSessions = HistoryService.Sessions.ToList();

        // Check if the current agent has RAG enabled
        await UpdateDocumentsButtonVisibilityAsync();
    }

    private void HandleSessionsChanged()
    {
        _recentSessions = HistoryService.Sessions.ToList();
        InvokeAsync(StateHasChanged);
    }

    private void HandleConversationChanged()
    {
        // Refresh sessions and files when a conversation changes (new message sent)
        InvokeAsync(async () =>
        {
            await HistoryService.LoadSessionsAsync();
            _recentSessions = HistoryService.Sessions.ToList();

            // Also refresh conversation files (new files may have been uploaded with the message)
            if (ChatState.CurrentSessionId.HasValue)
            {
                try
                {
                    var files = await DocumentService.GetFilesAsync(ChatState.CurrentSessionId.Value);
                    _conversationFiles = files;
                    _conversationFilesLoaded = true;
                }
                catch
                {
                    // Ignore - files will refresh when drawer is opened
                }
            }

            StateHasChanged();
        });
    }

    private void LoadMore()
    {
        _displayCount += LoadMoreIncrement;
    }

    private static Dictionary<string, List<AesirChatSessionItem>> GroupSessionsByDate(List<AesirChatSessionItem> sessions)
    {
        var result = new Dictionary<string, List<AesirChatSessionItem>>();
        var now = DateTimeOffset.Now;
        var today = now.Date;
        var yesterday = today.AddDays(-1);
        var thisWeekStart = today.AddDays(-(int)today.DayOfWeek);
        var lastWeekStart = thisWeekStart.AddDays(-7);
        var thisMonthStart = new DateTime(today.Year, today.Month, 1);
        var lastMonthStart = thisMonthStart.AddMonths(-1);

        foreach (var session in sessions)
        {
            var sessionDate = session.UpdatedAt.Date;
            var groupName = GetFriendlyDateGroup(sessionDate, today, yesterday, thisWeekStart, lastWeekStart, thisMonthStart, lastMonthStart);

            if (!result.ContainsKey(groupName))
            {
                result[groupName] = new List<AesirChatSessionItem>();
            }
            result[groupName].Add(session);
        }

        return result;
    }

    private static string GetFriendlyDateGroup(
        DateTime sessionDate,
        DateTime today,
        DateTime yesterday,
        DateTime thisWeekStart,
        DateTime lastWeekStart,
        DateTime thisMonthStart,
        DateTime lastMonthStart)
    {
        if (sessionDate == today)
            return "Today";

        if (sessionDate == yesterday)
            return "Yesterday";

        if (sessionDate >= thisWeekStart)
            return "This Week";

        if (sessionDate >= lastWeekStart)
            return "Last Week";

        if (sessionDate >= thisMonthStart)
            return "This Month";

        if (sessionDate >= lastMonthStart)
            return "Last Month";

        // For older dates, show the month and year
        return sessionDate.ToString("MMMM yyyy");
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void NavigateToChats()
    {
        NavigationManager.NavigateTo("/chats", forceLoad: false);
    }

    private void StartNewChat()
    {
        ChatState.StartNewChat();
        // Use replace: true to clear URL history and prevent back button returning to old session
        NavigationManager.NavigateTo("/chat", forceLoad: false, replace: true);
    }

    private static string TruncateTitle(string title, int maxLength)
    {
        if (string.IsNullOrEmpty(title)) return title;
        return title.Length <= maxLength ? title : title[..(maxLength - 3)] + "...";
    }

    private void HandleSessionClick(AesirChatSessionItem session)
    {
        ChatState.SetCurrentSession(session.Id, session.Title);
        NavigationManager.NavigateTo($"/chat?session={session.Id}", forceLoad: false);
    }

    private async Task HandleSessionDelete(AesirChatSessionItem session)
    {
        var result = await HistoryService.DeleteSessionAsync(session.Id);
        if (result.IsSuccess)
        {
            // If we deleted the current session, start a new chat
            if (ChatState.CurrentSessionId == session.Id)
            {
                ChatState.StartNewChat();
                NavigationManager.NavigateTo("/chat", forceLoad: false);
            }
        }
    }

    private async Task HandleSessionRename((AesirChatSessionItem Session, string NewTitle) args)
    {
        await HistoryService.UpdateSessionTitleAsync(args.Session.Id, args.NewTitle);
    }

    private async Task HandleSessionStarChanged((AesirChatSessionItem Session, bool IsStarred) args)
    {
        await HistoryService.UpdateSessionStarredAsync(args.Session.Id, args.IsStarred);
    }

    private void ToggleRecentsSection()
    {
        _recentsSectionCollapsed = !_recentsSectionCollapsed;
    }

    // Title dropdown menu actions for current session
    private async Task ToggleCurrentSessionStar()
    {
        if (!ChatState.CurrentSessionId.HasValue) return;

        var newStarredState = !IsCurrentSessionStarred;
        await HistoryService.UpdateSessionStarredAsync(ChatState.CurrentSessionId.Value, newStarredState);
    }

    private async Task ShowRenameDialog()
    {
        if (!ChatState.CurrentSessionId.HasValue) return;

        var parameters = new DialogParameters<RenameDialog>
        {
            { x => x.CurrentTitle, ChatState.CurrentSessionTitle ?? "" }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<RenameDialog>("Rename Chat", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string newTitle } && !string.IsNullOrWhiteSpace(newTitle))
        {
            var updateResult = await HistoryService.UpdateSessionTitleAsync(ChatState.CurrentSessionId.Value, newTitle);
            if (updateResult.IsSuccess)
            {
                ChatState.SetCurrentSessionTitle(newTitle);
            }
        }
    }

    private async Task ShowDeleteConfirmation()
    {
        if (!ChatState.CurrentSessionId.HasValue) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, "Are you sure you want to delete this chat? This action cannot be undone." },
            { x => x.ConfirmButtonText, "Delete" },
            { x => x.ConfirmButtonColor, Color.Error }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Chat", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var sessionId = ChatState.CurrentSessionId.Value;
            var deleteResult = await HistoryService.DeleteSessionAsync(sessionId);
            if (deleteResult.IsSuccess)
            {
                ChatState.StartNewChat();
                NavigationManager.NavigateTo("/chat", forceLoad: false);
            }
        }
    }

    private async void HandleAgentChangedAsync()
    {
        await UpdateDocumentsButtonVisibilityAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleSessionChangedAsync()
    {
        // Load files directly when session changes (don't rely on drawer being open)
        if (ChatState.CurrentSessionId.HasValue)
        {
            try
            {
                var files = await DocumentService.GetFilesAsync(ChatState.CurrentSessionId.Value);
                _conversationFiles = files;
                _conversationFilesLoaded = true;
            }
            catch
            {
                // Failed to load files, keep existing list or empty
                _conversationFiles = [];
                _conversationFilesLoaded = false;
            }

            // Also refresh the drawer component if it's open
            if (_documentsListRef != null)
            {
                await _documentsListRef.RefreshAsync();
            }
        }
        else
        {
            _conversationFiles = [];
            _conversationFilesLoaded = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void HandleDocumentDeleted(Guid documentId)
    {
        // Remove the deleted document from the cached files
        var updatedFiles = _conversationFiles.Where(f => f.Id != documentId).ToList();
        _conversationFiles = updatedFiles;
        InvokeAsync(StateHasChanged);
    }

    private async Task UpdateDocumentsButtonVisibilityAsync()
    {
        if (ChatState.SelectedAgent?.Id == null)
        {
            _showDocumentsButton = false;
            return;
        }

        try
        {
            _showDocumentsButton = await AgentToolsService.AgentHasRagToolAsync(ChatState.SelectedAgent.Id.Value);
        }
        catch
        {
            _showDocumentsButton = false;
        }
    }

    private async Task ToggleDocumentsDrawer()
    {
        _documentsDrawerOpen = !_documentsDrawerOpen;

        // Refresh documents when opening the drawer
        if (_documentsDrawerOpen && _documentsListRef != null)
        {
            await _documentsListRef.RefreshAsync();
        }
    }

    /// <summary>
    /// Current list of files in the conversation. Cascaded to child components.
    /// </summary>
    private IReadOnlyList<ConversationFile> _conversationFiles = [];

    /// <summary>
    /// Whether the conversation files have been loaded from the API.
    /// Used to distinguish between "not loaded yet" and "loaded but empty".
    /// </summary>
    private bool _conversationFilesLoaded;

    private Task HandleFilesChanged(IReadOnlyList<ConversationFile> files)
    {
        // Update the cached files and notify children
        _conversationFiles = files;
        _conversationFilesLoaded = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        HistoryService.OnSessionsChanged -= HandleSessionsChanged;
        ChatState.OnConversationChanged -= HandleConversationChanged;
        ChatState.OnAgentChanged -= HandleAgentChangedAsync;
        ChatState.OnSessionChanged -= HandleSessionChangedAsync;
        ChatState.OnDocumentDeleted -= HandleDocumentDeleted;
    }
}
