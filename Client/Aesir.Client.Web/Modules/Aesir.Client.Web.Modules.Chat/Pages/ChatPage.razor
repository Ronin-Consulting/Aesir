    // Drag-and-drop handlers
    private void HandleDragEnter(DragEventArgs e)
    {
        _dragCounter++;
        if (HasFiles(e))
        {
            _isDragging = true;
            _isDragOver = true;
            StateHasChanged();
        }
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        _dragCounter--;
        if (_dragCounter <= 0)
        {
            _dragCounter = 0;
            _isDragging = false;
            _isDragOver = false;
            StateHasChanged();
        }
    }

    private void HandleDragOver(DragEventArgs e)
    {
        if (HasFiles(e))
        {
            _isDragOver = true;
        }
    }

    private void HandleDrop(DragEventArgs e)
    {
        // Reset drag state - the JS interop handles the actual file capture
        _isDragging = false;
        _isDragOver = false;
        _dragCounter = 0;
        StateHasChanged();
    }

    /// <summary>
    /// Handles files dropped via the hidden InputFile (populated by JS interop).
    /// </summary>
    private async Task HandleDroppedFiles(InputFileChangeEventArgs e)
    {
        // Reset drag state
        _isDragging = false;
        _isDragOver = false;
        _dragCounter = 0;

        foreach (var file in e.GetMultipleFiles())
        {
            await HandleFileDropped(file);
        }
    }

    private async Task HandleFileDropped(IBrowserFile file)
    {
        // Hide the overlay (drop handling is now done by InputFile in DropZoneOverlay)
        _isDragging = false;
        _isDragOver = false;
        _dragCounter = 0;
        StateHasChanged();

        // Determine which view is active and check RAG status
        var isRagEnabled = _hasMessages
            ? _messageInput?.IsRagEnabled ?? false
            : _chatWelcome?.IsRagEnabled ?? false;

        if (!isRagEnabled)
        {
            Snackbar.Add("File uploads are not enabled for this agent. Assign the RAG tool to enable file uploads.", Severity.Warning);
            return;
        }

        // Validate file type
        if (!DocumentService.IsFileTypeSupported(file.Name))
        {
            Snackbar.Add($"File type not supported: {Path.GetExtension(file.Name)}", Severity.Warning);
            return;
        }

        // Add the file to the appropriate component's pending files based on view state
        if (_hasMessages && _messageInput != null)
        {
            await _messageInput.AddFileAsync(file);
        }
        else if (!_hasMessages && _chatWelcome != null)
        {
            await _chatWelcome.AddFileAsync(file);
        }
    }

    private static bool HasFiles(DragEventArgs e)
    {
        // Check for "Files" (case-insensitive) as different browsers may report differently
        return e.DataTransfer?.Types?.Any(t => t.Equals("Files", StringComparison.OrdinalIgnoreCase)) == true;
    }

    public void Dispose()
    {
        ChatState.OnAgentChanged -= HandleAgentChanged;
        ChatState.OnNewChat -= HandleNewChat;
        HistoryService.OnSessionSelected -= HandleSessionSelected;
        ToolCallStateService.OnToolCallsChanged -= HandleToolCallsChanged;
        ResearchState.OnSessionChanged -= HandleResearchSessionChanged;
        ResearchState.OnResearchCompleted -= HandleResearchCompleted;
        ResearchState.OnResearchError -= HandleResearchError;
        ResearchState.OnTeamChanged -= HandleResearchTeamChanged;
        _streamingCts?.Cancel();
        _streamingCts?.Dispose();
        _scrollListenerRef?.Dispose();
    }

