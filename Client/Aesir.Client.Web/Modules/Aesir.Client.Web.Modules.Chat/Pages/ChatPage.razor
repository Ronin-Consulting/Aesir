    /// <summary>
    /// Gets the research session associated with a research team message.
    /// Returns the active session if it matches, cached session if available,
    /// or triggers a background load for historical messages.
    /// </summary>
    private ResearchSessionBase? GetResearchSessionForMessage(AesirChatMessage message)
    {
        if (!message.IsResearchTeamMessage || !message.ResearchSessionId.HasValue)
            return null;

        var sessionId = message.ResearchSessionId.Value;

        // Return active session if it matches this message
        if (ResearchState.ActiveSession?.Id == sessionId)
            return ResearchState.ActiveSession;

        // Check cache for previously loaded sessions
        if (_researchSessionCache.TryGetValue(sessionId, out var cachedSession))
            return cachedSession;

        // Trigger background load if not already loading
        if (!_researchSessionsLoading.Contains(sessionId))
        {
            _researchSessionsLoading.Add(sessionId);
            _ = LoadResearchSessionAsync(sessionId);
        }

        // Return null while loading - UI will update when load completes
        return null;
    }

    /// <summary>
    /// Loads a research session from the API and caches it.
    /// Triggers a UI update when complete.
    /// </summary>
    private async Task LoadResearchSessionAsync(Guid sessionId)
    {
        try
        {
            var result = await ResearchSessionApi.GetSessionAsync(sessionId);

            if (result.IsSuccess && result.Value != null)
            {
                _researchSessionCache[sessionId] = result.Value;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load research session {sessionId}: {ex.Message}");
        }
        finally
        {
            _researchSessionsLoading.Remove(sessionId);
        }
    }

    /// <summary>
    /// Clears the research session cache. Called when switching conversations.
    /// </summary>
    private void ClearResearchSessionCache()
    {
        _researchSessionCache.Clear();
        _researchSessionsLoading.Clear();
    }
