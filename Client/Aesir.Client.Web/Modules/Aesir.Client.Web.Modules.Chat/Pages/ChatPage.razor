    /// <summary>
    /// Handles editing a user message and re-running the conversation from that point.
    /// Removes the edited message and all following messages, then submits the new content.
    /// </summary>
    private async Task HandleEditMessage((int Index, string NewContent) args)
    {
        if (string.IsNullOrWhiteSpace(args.NewContent) || ChatState.SelectedAgent == null)
            return;

        // Get the non-system messages to find the correct index
        var nonSystemMessages = _conversation.Messages
            .Where(m => m.Role != "system")
            .ToList();

        if (args.Index < 0 || args.Index >= nonSystemMessages.Count)
            return;

        // Find the original message being edited
        var originalMessage = nonSystemMessages[args.Index];

        // Find the index in the full message list (including system)
        var fullIndex = _conversation.Messages.IndexOf(originalMessage);
        if (fullIndex < 0)
            return;

        // Remove all messages from this index onwards
        // This removes: the edited user message + the following assistant response + any subsequent messages
        var messagesToRemove = _conversation.Messages.Skip(fullIndex).ToList();
        foreach (var msg in messagesToRemove)
        {
            _conversation.Messages.Remove(msg);
        }

        // Update hasMessages flag
        _hasMessages = _conversation.Messages.Any(m => m.Role != "system");

        // Create new user message with edited content
        var newUserMessage = AesirChatMessage.NewUserMessage(args.NewContent);

        // Preserve file attachments from original message
        var fileNames = originalMessage.GetFileNames();
        foreach (var fileName in fileNames)
        {
            newUserMessage.AddFile(fileName);
        }

        // Send the new message (this adds it to conversation and streams response)
        await SendMessageWithFileAsync(newUserMessage);
    }

    /// <summary>
    /// Handles re-running a user message without editing.
    /// Removes the message and all following messages, then re-submits with the same content.
    /// </summary>
    private async Task HandleRerunMessage(int index)
    {
        if (ChatState.SelectedAgent == null)
            return;

        // Get the non-system messages to find the correct index
        var nonSystemMessages = _conversation.Messages
            .Where(m => m.Role != "system")
            .ToList();

        if (index < 0 || index >= nonSystemMessages.Count)
            return;

        // Find the original message
        var originalMessage = nonSystemMessages[index];

        // Find the index in the full message list (including system)
        var fullIndex = _conversation.Messages.IndexOf(originalMessage);
        if (fullIndex < 0)
            return;

        // Remove all messages from this index onwards
        var messagesToRemove = _conversation.Messages.Skip(fullIndex).ToList();
        foreach (var msg in messagesToRemove)
        {
            _conversation.Messages.Remove(msg);
        }

        // Update hasMessages flag
        _hasMessages = _conversation.Messages.Any(m => m.Role != "system");

        // Create new message with same content (preserving files)
        var newUserMessage = AesirChatMessage.NewUserMessage(
            originalMessage.GetContentWithoutFileName() ?? originalMessage.Content);

        // Preserve file attachments from original message
        foreach (var fileName in originalMessage.GetFileNames())
        {
            newUserMessage.AddFile(fileName);
        }

        // Send the new message
        await SendMessageWithFileAsync(newUserMessage);
    }

    private async Task SendMessageAsync(string message)
    {
        if (string.IsNullOrWhiteSpace(message)) return;

        // Handle Research Team messages differently
        if (ResearchState.IsTeamSelected && ResearchState.SelectedTeam != null)
        {
            await SendResearchMessageAsync(message);
            return;
        }

        if (ChatState.SelectedAgent == null) return;

        var userMessage = AesirChatMessage.NewUserMessage(message);
        await SendMessageWithFileAsync(userMessage);
    }

    private async Task SendMessageWithFileAsync(AesirChatMessage userMessage)
    {
        if (ChatState.SelectedAgent == null) return;

        _errorMessage = null;
        _isWaitingForResponse = true;
        _isStreaming = false;
        _isThinking = false;
        _hasMessages = true;
        _streamingContent = string.Empty;
        _currentThinkingContent = null;

        // Clear tool calls for new message
        ToolCallStateService.Clear();
        _currentToolCalls = [];

        try
        {
            // Add user message (which may already have file reference via AddFile())
            _conversation.Messages.Add(userMessage);

            StateHasChanged();
            await ScrollToBottomAsync();

            // Notify that conversation changed so ChatLayout can refresh file list immediately
            // This ensures files show correctly in user messages before the streaming completes
            if (userMessage.GetFileNames().Count > 0)
            {
                ChatState.NotifyConversationChanged();
            }

            // Create the chat request
            // Use the client's conversation ID - server will honor it (??= only assigns if null)
            var conversationGuid = Guid.TryParse(_conversation.Id, out var convId) ? convId : (Guid?)null;
            var request = new AesirAgentChatRequestBase
            {
                AgentId = ChatState.SelectedAgent.Id,
                ChatSessionId = conversationGuid ?? ChatState.CurrentSessionId,
                User = UserId,
                Conversation = _conversation,
                EnableThinking = GetEffectiveThinkingEnabled(),
                ThinkValue = GetEffectiveThinkLevel(),
                Title = _sessionTitle ?? string.Empty
            };

            // Add enabled agent tools to the request (enables RAG, web search, MCP tools)
            // The backend checks request.Tools for RagTool to enable document search
            // Filter out tools that are disabled by the user in the toggle menu
            foreach (var toolRequest in _agentToolRequests)
            {
                // Find the matching tool to check if it's disabled
                var tool = _agentTools.FirstOrDefault(t =>
                    (t.Type == ToolType.McpServer ? t.Name : t.ToolName) == toolRequest.ToolName);

                // Only add tool if it's not in the disabled set
                if (tool?.Id == null || !ChatState.DisabledToolIds.Contains(tool.Id.Value))
                {
                    request.WithTool(toolRequest);
                }
            }

            // Create cancellation token for streaming
            _streamingCts?.Cancel();
            _streamingCts = new CancellationTokenSource();

            // Stream the response
            await foreach (var chunk in ChatApiService.StreamChatAsync(request, _streamingCts.Token))
            {
                if (_streamingCts.IsCancellationRequested) break;

                // First chunk received - no longer waiting, now streaming
                // CRITICAL: Set _isStreaming = true BEFORE any state operations that might trigger re-renders
                // This ensures IsActivelyProcessing remains true to prevent state resets during the streaming loop
                _isWaitingForResponse = false;
                _isStreaming = true;

                // Update session ID if this is a new session
                if (chunk.ChatSessionId.HasValue && !ChatState.CurrentSessionId.HasValue)
                {
                    // Store the old conversation ID before updating (for file migration)
                    var oldConversationId = _conversation.Id;

                    ChatState.SetCurrentSession(chunk.ChatSessionId.Value);
                    _previousSessionId = chunk.ChatSessionId.Value;

                    // CRITICAL: Sync _conversation.Id with the new session ID
                    // This ensures all future file uploads use the same ID as the session
                    _conversation.Id = chunk.ChatSessionId.Value.ToString();

                    // If files were uploaded with the old conversation ID, migrate them
                    if (oldConversationId != _conversation.Id && Guid.TryParse(oldConversationId, out var oldId))
                    {
                        await MigrateFilesAsync(oldId, chunk.ChatSessionId.Value);
                    }

                    // Update URL with new session ID without forcing navigation
                    var newUrl = NavigationManager.GetUriWithQueryParameter("session", chunk.ChatSessionId.Value.ToString());
                    NavigationManager.NavigateTo(newUrl, forceLoad: false, replace: true);

                    // Notify history service that a new session was created
                    await HistoryService.NotifySessionCreatedAsync(chunk.ChatSessionId.Value);
                }

                // Update title if it comes back in the stream
                if (!string.IsNullOrEmpty(chunk.Title) && chunk.Title != _sessionTitle)
                {
                    _sessionTitle = chunk.Title;
                    ChatState.SetCurrentSessionTitle(_sessionTitle);
                    // Notify history service that the session was updated
                    if (ChatState.CurrentSessionId.HasValue)
                    {
                        await HistoryService.NotifySessionUpdatedAsync(ChatState.CurrentSessionId.Value);
                    }
                }

                // Handle tool call events
                if (chunk.EventType == StreamEventType.ToolCallStart || chunk.EventType == StreamEventType.ToolCallResult)
                {
                    if (chunk.ToolCall != null)
                    {
                        ToolCallStateService.ProcessToolCallEvent(chunk.ToolCall);
                    }
                }
                // Handle thinking state
                else if (chunk.IsThinking)
                {
                    _isThinking = true;
                    _isStreaming = false;
                    // Thinking content is in ThoughtsContent, not Content
                    if (!string.IsNullOrEmpty(chunk.Delta?.ThoughtsContent))
                    {
                        _currentThinkingContent = (_currentThinkingContent ?? string.Empty) + chunk.Delta.ThoughtsContent;
                    }
                }
                else
                {
                    _isThinking = false;
                    _isStreaming = true;
                    if (!string.IsNullOrEmpty(chunk.Delta?.Content))
                    {
                        _streamingContent += chunk.Delta.Content;
                    }
                }

                StateHasChanged();
                await ScrollToBottomAsync();
            }

            // Add the completed assistant message
            if (!string.IsNullOrEmpty(_streamingContent))
            {
                var assistantMessage = AesirChatMessage.NewAssistantMessage(_streamingContent);
                if (!string.IsNullOrEmpty(_currentThinkingContent))
                {
                    assistantMessage.ThoughtsContent = _currentThinkingContent;
                }
                if (_currentToolCalls.Count > 0)
                {
                    assistantMessage.ToolCalls = _currentToolCalls.ToList();
                }
                _conversation.Messages.Add(assistantMessage);
            }

            ChatState.NotifyConversationChanged();
        }
        catch (OperationCanceledException)
        {
            // User cancelled the stream - this is expected
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = $"Connection error: {ex.Message}. Please check your network connection.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isWaitingForResponse = false;
            _isStreaming = false;
            _isThinking = false;
            _streamingContent = string.Empty;
            StateHasChanged();
            await ScrollToBottomAsync();
        }
    }

    /// <summary>
    /// Sends a message to a Research Team, initiating a multi-agent research session.
    /// Links the research to a ChatSession for persistence and title generation.
    /// </summary>
    private async Task SendResearchMessageAsync(string message)
    {
        if (ResearchState.SelectedTeam?.Id == null) return;
        var selectedTeam = ResearchState.SelectedTeam;

        _errorMessage = null;
        _isWaitingForResponse = true;
        _hasMessages = true;

        try
        {
            // Get or create conversation ID - same as normal chat flow
            // This ensures research sessions are linked to a ChatSession for:
            // - Persistence in sidebar history
            // - Title generation
            // - Ability to continue conversation after research completes
            var conversationId = GetOrCreateConversationId();

            // Add user message to conversation
            var userMessage = AesirChatMessage.NewUserMessage(message);
            _conversation.Messages.Add(userMessage);
            StateHasChanged();
            await ScrollToBottomAsync();

            // Start the research session with the ChatSession ID
            var session = await ResearchState.StartResearchAsync(
                message,
                selectedTeam.Id!.Value,
                conversationId: conversationId);

            if (session != null)
            {
                // Create a team message to show the research is in progress
                var teamMessage = AesirChatMessage.NewResearchTeamMessage(
                    $"Research started: {message}",
                    session.Id,
                    selectedTeam.Id!.Value,
                    selectedTeam.Name ?? "Research Team");

                _conversation.Messages.Add(teamMessage);
                StateHasChanged();
                await ScrollToBottomAsync();
            }
            else
            {
                Snackbar.Add("Failed to start research session", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Research error: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isWaitingForResponse = false;
            StateHasChanged();
        }
    }

    private async Task SendMessageWithFilesAsync((string Message, List<PendingFileUpload> Files) data)
    {
        var (message, files) = data;

        if (string.IsNullOrWhiteSpace(message)) return;

        // Handle Research Team messages - files not supported yet for research
        if (ResearchState.IsTeamSelected && ResearchState.SelectedTeam != null)
        {
            if (files.Count > 0)
            {
                Snackbar.Add("File attachments are not yet supported for Research Teams", Severity.Warning);
            }
            await SendResearchMessageAsync(message);
            return;
        }

        if (ChatState.SelectedAgent == null) return;

        // Get conversation ID (may already exist from immediate upload)
        var conversationId = GetOrCreateConversationId();

        // Upload any files that haven't been uploaded yet (immediate upload may have already uploaded them)
        var filesToUpload = files.Where(f => f.Status == UploadStatus.Pending).ToList();
        if (filesToUpload.Count > 0)
        {
            _isUploadingFiles = true;
            StateHasChanged();

            var uploadedCount = 0;

            try
            {
                foreach (var file in filesToUpload)
                {
                    try
                    {
                        file.Status = UploadStatus.Uploading;
                        StateHasChanged();

                        var progress = new Progress<int>(p =>
                        {
                            file.Progress = p;
                            InvokeAsync(StateHasChanged);
                        });

                        await DocumentService.UploadFileAsync(
                            conversationId,
                            file.File,
                            progress,
                            file.CancellationTokenSource.Token);

                        file.Status = UploadStatus.Completed;
                        uploadedCount++;
                    }
                    catch (OperationCanceledException)
                    {
                        file.Status = UploadStatus.Cancelled;
                    }
                    catch (Exception ex)
                    {
                        file.Status = UploadStatus.Failed;
                        file.ErrorMessage = ex.Message;
                        Snackbar.Add($"Failed to upload '{file.FileName}': {ex.Message}", Severity.Error);
                    }
                }

                if (uploadedCount > 0)
                {
                    Snackbar.Add($"Uploaded {uploadedCount} file(s) successfully.", Severity.Success);
                }
            }
            finally
            {
                _isUploadingFiles = false;
                StateHasChanged();
            }
        }

        // Create user message and add file reference using the existing AddFile method
        // This matches how the desktop client handles file attachments
        var userMessage = AesirChatMessage.NewUserMessage(message);

        // Add file references for all successfully uploaded files
        var successfullyUploadedFiles = files.Where(f => f.Status == UploadStatus.Completed).ToList();
        foreach (var uploadedFile in successfullyUploadedFiles)
        {
            userMessage.AddFile(uploadedFile.FileName);

            // Add to recently uploaded set to prevent "deleted" display race condition
            _recentlyUploadedFiles.Add(uploadedFile.FileName);
            _ = RemoveFromRecentlyUploadedAfterDelayAsync(uploadedFile.FileName, TimeSpan.FromSeconds(5));
        }

        await SendMessageWithFileAsync(userMessage);
    }

    /// <summary>
    /// Gets the current conversation ID or creates a new one if none exists.
    /// Used by MessageInput for immediate file upload on selection.
    /// </summary>
    private Guid GetOrCreateConversationId()
    {
        if (ChatState.CurrentSessionId.HasValue)
        {
            return ChatState.CurrentSessionId.Value;
        }

        // For new conversations, use the conversation ID from _conversation
        // This will be associated with the session when created
        if (Guid.TryParse(_conversation.Id, out var conversationId))
        {
            return conversationId;
        }

        // Generate a new conversation ID
        conversationId = Guid.NewGuid();
        _conversation.Id = conversationId.ToString();
        return conversationId;
    }

    /// <summary>
    /// Removes a filename from the recently uploaded set after a delay.
    /// This provides a grace period for the API to sync before we mark files as deleted.
    /// </summary>
    private async Task RemoveFromRecentlyUploadedAfterDelayAsync(string fileName, TimeSpan delay)
    {
        await Task.Delay(delay);
        _recentlyUploadedFiles.Remove(fileName);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Migrates files from an old conversation ID to a new session ID.
    /// This ensures files uploaded before the session was created are accessible.
    /// </summary>
    private async Task MigrateFilesAsync(Guid oldConversationId, Guid newSessionId)
    {
        try
        {
            // Check if there are any files in the old conversation
            var oldFiles = await DocumentService.GetFilesAsync(oldConversationId);
            if (!oldFiles.Any())
            {
                return; // No files to migrate
            }

            // Call the server API to move files from old conversation to new session
            var success = await DocumentService.MoveFilesAsync(oldConversationId, newSessionId);
            if (success)
            {
                Console.WriteLine($"Migrated {oldFiles.Count} files from {oldConversationId} to {newSessionId}");
            }
            else
            {
                Console.WriteLine($"Failed to migrate files from {oldConversationId} to {newSessionId}");
            }
        }
        catch (Exception ex)
        {
            // Log but don't block the chat flow
            Console.WriteLine($"Error migrating files: {ex.Message}");
        }
    }

