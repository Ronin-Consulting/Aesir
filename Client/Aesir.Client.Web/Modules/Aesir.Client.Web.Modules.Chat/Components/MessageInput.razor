@using Aesir.Client.Web.Modules.Chat.Models
@inject IChatStateService ChatState
@inject IAgentToolsService AgentToolsService
@inject IDocumentApiService DocumentService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@implements IAsyncDisposable

@* Event callback to request conversation ID from parent when needed for immediate upload *@

<div class="message-input-wrapper">
    <div class="message-input-container">
        @* Pending Files Display - Horizontal scrolling container *@
        @if (_pendingFiles.Count > 0)
        {
            <div class="pending-files-container">
                <div class="pending-files">
                    @foreach (var file in _pendingFiles)
                    {
                        @if (FileTypeHelper.IsImage(file.FileName) && !string.IsNullOrEmpty(file.ObjectUrl))
                        {
                            @* Image files show a thumbnail with the card *@
                            <div class="pending-file-item @(file.IsRemoving ? "removing" : "")">
                                <ImageThumbnail FileName="@file.FileName"
                                                FileObjectUrl="@file.ObjectUrl"
                                                Size="ImageThumbnail.ThumbnailSize.Medium"
                                                ShowOverlay="false" />
                                <div class="thumbnail-overlay-actions @(file.Status == UploadStatus.Uploading || file.Status == UploadStatus.Processing ? "active" : "")">
                                    @if (file.Status == UploadStatus.Uploading || file.Status == UploadStatus.Processing)
                                    {
                                        @* Show indeterminate spinner for Processing status, or when progress <= 0 *@
                                        <MudProgressCircular Size="Size.Small"
                                                             Indeterminate="@(file.Status == UploadStatus.Processing || file.Progress <= 0)"
                                                             Value="@Math.Max(0, file.Progress)"
                                                             Color="Color.Primary" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Size="Size.Small"
                                                       OnClick="@(async () => await RemovePendingFileAsync(file))"
                                                       Class="remove-btn"
                                                       aria-label="Remove file" />
                                    }
                                </div>
                                @if (file.Status == UploadStatus.Completed)
                                {
                                    <div class="thumbnail-success-badge">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                    </div>
                                }
                                @if (file.Status == UploadStatus.Failed)
                                {
                                    <div class="thumbnail-error-badge" title="@file.ErrorMessage">
                                        <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="Color.Error" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* Non-image files use the FileCard component *@
                            <FileCard FileName="@file.FileName"
                                      FileSize="@file.FileSize"
                                      Size="FileCard.FileCardSize.Compact"
                                      IsUploading="@(file.Status == UploadStatus.Uploading)"
                                      IsProcessing="@(file.Status == UploadStatus.Processing)"
                                      Progress="@file.Progress"
                                      HasError="@(file.Status == UploadStatus.Failed)"
                                      ShowSuccess="@(file.Status == UploadStatus.Completed)"
                                      IsRemoving="@file.IsRemoving"
                                      ErrorMessage="@file.ErrorMessage"
                                      OnRemove="@(async () => await RemovePendingFileAsync(file))" />
                        }
                    }
                </div>
            </div>
        }

        @* Input Area - No outline, clean look *@
        <div @ref="_textFieldWrapper" class="text-field-wrapper">
            <MudTextField @bind-Value="_message"
                          @ref="_textField"
                          Placeholder="@Placeholder"
                          Variant="Variant.Text"
                          Lines="@Lines"
                          AutoGrow="true"
                          MaxLines="10"
                          FullWidth="true"
                          Immediate="true"
                          Disabled="@IsDisabled"
                          OnKeyDown="@HandleKeyDown"
                          DisableUnderLine="true"
                          Class="message-input" />
        </div>

        @* Action Bar *@
        <div class="action-bar">
            <div class="left-actions">
                <FileUploadButton IsDisabled="@(!_isRagEnabled || _isCheckingRag || IsLoading)"
                                  TooltipText="@AttachButtonTooltip"
                                  OnFileSelected="@HandleFileSelected"
                                  OnError="@HandleFileError"
                                  @ref="_fileUploadButton" />
                <ToolToggleMenu Tools="@AvailableTools"
                                DisabledToolIds="@DisabledToolIds"
                                OnToolToggled="@HandleToolToggled"
                                IsDisabled="@IsLoading" />
                @if (AllowThinking)
                {
                    <ThinkMenu SelectedLevel="@SelectedThinkLevel"
                               DefaultLevel="@DefaultThinkLevel"
                               OnLevelChanged="@HandleThinkLevelChanged"
                               IsDisabled="@IsLoading" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.History"
                               Size="Size.Small"
                               Color="Color.Default"
                               Disabled="true"
                               Title="History" />
            </div>

            <div class="right-actions">
                @* Agent Selector (Claude-style) *@
                <AgentSelectorCompact OnAgentSelected="HandleAgentSelected" />

                <MudIconButton Icon="@Icons.Material.Filled.Mic"
                               Size="Size.Small"
                               Color="Color.Default"
                               OnClick="NavigateToHandsFree"
                               Disabled="@HasPendingUnsubmittedFiles"
                               Title="@HandsFreeButtonTooltip"
                               Class="hands-free-button" />

                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                               Size="Size.Small"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="@SendMessage"
                               Disabled="@(!CanSend)"
                               Title="Send message"
                               Class="send-button" />
            </div>
        </div>
    </div>
</div>

<style>
    .message-input-wrapper {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 16px 48px 24px 48px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            color-mix(in srgb, var(--mud-palette-surface) 75%, transparent) 16px
        );
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        z-index: 5;
    }

    .message-input-container {
        background-color: var(--mud-palette-background-grey);
        border-radius: 16px;
        padding: 12px 16px;
        border: 1px solid var(--mud-palette-lines-default);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    /* Focus glow effect */
    .message-input-container:focus-within {
        border-color: var(--aesir-primary);
        box-shadow:
            0 0 0 3px rgba(84, 169, 255, 0.15),
            0 4px 16px rgba(84, 169, 255, 0.1);
    }

    /* Hover state before focus */
    .message-input-container:hover:not(:focus-within) {
        border-color: rgba(84, 169, 255, 0.4);
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    }

    /* Text field wrapper for tab key handling */
    .text-field-wrapper {
        width: 100%;
    }

    /* Pending files horizontal scroll container */
    .pending-files-container {
        margin-bottom: 8px;
        padding-bottom: 8px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
        scrollbar-color: var(--mud-palette-lines-default) transparent;
    }

    .pending-files-container::-webkit-scrollbar {
        height: 6px;
    }

    .pending-files-container::-webkit-scrollbar-track {
        background: transparent;
    }

    .pending-files-container::-webkit-scrollbar-thumb {
        background-color: var(--mud-palette-lines-default);
        border-radius: 3px;
    }

    .pending-files {
        display: flex;
        flex-wrap: nowrap;
        gap: 8px;
        padding: 4px 0;
    }

    /* Animation for new pending files */
    @@keyframes fileSlideIn {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Image thumbnail in pending files */
    .pending-file-item {
        position: relative;
        flex-shrink: 0;
        animation: fileSlideIn 0.2s ease-out;
    }

    .pending-file-item.removing {
        animation: fileSlideOut 0.2s ease-in forwards;
    }

    /* Apply animation to FileCard components too */
    .pending-files > :global(.file-card) {
        animation: fileSlideIn 0.2s ease-out;
    }

    .pending-files > :global(.file-card.removing) {
        animation: fileSlideOut 0.2s ease-in forwards;
    }

    @@keyframes fileSlideOut {
        from {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
        to {
            opacity: 0;
            transform: translateY(-8px) scale(0.95);
        }
    }

    .thumbnail-overlay-actions {
        position: absolute;
        top: 4px;
        right: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.6);
        border-radius: 50%;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .pending-file-item:hover .thumbnail-overlay-actions,
    .thumbnail-overlay-actions.active {
        opacity: 1;
    }

    .thumbnail-overlay-actions .remove-btn {
        color: white;
        width: 24px;
        height: 24px;
        padding: 2px;
    }

    .thumbnail-overlay-actions .remove-btn:hover {
        color: var(--mud-palette-error);
    }

    .thumbnail-error-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background-color: var(--mud-palette-surface);
        border-radius: 50%;
        padding: 2px;
    }

    .thumbnail-success-badge {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background-color: var(--mud-palette-surface);
        border-radius: 50%;
        padding: 2px;
        animation: successCheckPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes successCheckPop {
        0% {
            opacity: 0;
            transform: scale(0);
        }
        50% {
            transform: scale(1.2);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    .message-input {
        font-size: 1rem;
    }

    .message-input .mud-input-root {
        padding: 0 !important;
    }

    .message-input .mud-input {
        padding: 0 !important;
    }

    .message-input .mud-input-slot {
        padding: 0 !important;
    }

    /* Remove underline completely */
    .message-input .mud-input-underline::before,
    .message-input .mud-input-underline::after {
        display: none !important;
        border: none !important;
    }

    .action-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 8px;
    }

    .left-actions {
        display: flex;
        gap: 4px;
    }

    .left-actions .mud-icon-button {
        opacity: 0.6;
    }

    .left-actions .mud-icon-button:hover {
        opacity: 1;
    }

    .right-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .send-button {
        border-radius: 50% !important;
        width: 36px !important;
        height: 36px !important;
        min-width: 36px !important;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        background: linear-gradient(135deg, var(--aesir-primary) 0%, var(--aesir-primary-dark) 100%) !important;
        box-shadow: 0 2px 8px rgba(84, 169, 255, 0.3);
    }

    .send-button:hover:not(:disabled) {
        transform: scale(1.08);
        box-shadow: 0 4px 16px rgba(84, 169, 255, 0.4);
    }

    .send-button:active:not(:disabled) {
        transform: scale(0.95);
        box-shadow: 0 2px 6px rgba(84, 169, 255, 0.3);
    }

    .send-button:disabled {
        opacity: 0.35;
        background: var(--mud-palette-action-disabled-background) !important;
        box-shadow: none;
    }

    /* Subtle pulse when enabled and ready */
    .send-button:not(:disabled) {
        animation: sendButtonReady 2s ease-in-out infinite;
    }

    @@keyframes sendButtonReady {
        0%, 100% { box-shadow: 0 2px 8px rgba(84, 169, 255, 0.3); }
        50% { box-shadow: 0 2px 12px rgba(84, 169, 255, 0.5); }
    }

    .hands-free-button {
        opacity: 0.6;
        transition: opacity 0.15s ease, color 0.15s ease;
    }

    .hands-free-button:hover {
        opacity: 1;
        color: var(--mud-palette-primary);
    }

    .rag-disabled {
        opacity: 0.3 !important;
        cursor: not-allowed !important;
    }
</style>

@code {
    [Parameter]
    public string Placeholder { get; set; } = "How can I help you today?";

    [Parameter]
    public int Lines { get; set; } = 1;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public EventCallback<(string Message, List<PendingFileUpload> Files)> OnSendWithFiles { get; set; }

    [Parameter]
    public EventCallback<AesirAgentBase> OnAgentSelected { get; set; }

    /// <summary>
    /// Callback to get the conversation ID from the parent component.
    /// Used for immediate file upload on selection.
    /// </summary>
    [Parameter]
    public Func<Guid>? GetConversationId { get; set; }

    /// <summary>
    /// The list of available tools for the current agent.
    /// </summary>
    [Parameter]
    public IReadOnlyList<AesirToolBase> AvailableTools { get; set; } = [];

    /// <summary>
    /// The set of tool IDs that are currently disabled.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid> DisabledToolIds { get; set; } = new HashSet<Guid>();

    /// <summary>
    /// Event callback when a tool is toggled on/off.
    /// </summary>
    [Parameter]
    public EventCallback<(Guid ToolId, bool Enabled)> OnToolToggled { get; set; }

    /// <summary>
    /// Whether the agent supports thinking mode.
    /// </summary>
    [Parameter]
    public bool AllowThinking { get; set; }

    /// <summary>
    /// The currently selected think level.
    /// </summary>
    [Parameter]
    public ThinkValue? SelectedThinkLevel { get; set; }

    /// <summary>
    /// The agent's default think level.
    /// </summary>
    [Parameter]
    public ThinkValue? DefaultThinkLevel { get; set; }

    /// <summary>
    /// Event callback when the think level changes.
    /// </summary>
    [Parameter]
    public EventCallback<ThinkValue?> OnThinkLevelChanged { get; set; }

    private string _message = string.Empty;
    private MudTextField<string>? _textField;
    private FileUploadButton? _fileUploadButton;
    private bool _isRagEnabled;
    private bool _isCheckingRag;
    private readonly List<PendingFileUpload> _pendingFiles = new();

    private bool CanSend => !string.IsNullOrWhiteSpace(_message) &&
                            !IsDisabled &&
                            !IsLoading &&
                            ChatState.SelectedAgent != null &&
                            !_pendingFiles.Any(f => f.Status == UploadStatus.Uploading);

    private string AttachButtonTooltip => _isRagEnabled
        ? "Attach files"
        : "Assign RagTool to this agent to enable file uploads";

    /// <summary>
    /// Returns true if there are files attached that haven't been submitted with a message.
    /// This prevents navigation to hands-free mode until files are either submitted or removed.
    /// </summary>
    private bool HasPendingUnsubmittedFiles => _pendingFiles.Any(f =>
        f.Status == UploadStatus.Pending ||
        f.Status == UploadStatus.Uploading ||
        f.Status == UploadStatus.Completed);

    private string HandsFreeButtonTooltip => HasPendingUnsubmittedFiles
        ? "Submit or remove attached files before using hands-free mode"
        : "Hands-Free Mode";

    private ElementReference _textFieldWrapper;
    private bool _tabInsertionEnabled;

    protected override void OnInitialized()
    {
        ChatState.OnAgentChanged += HandleAgentChangedAsync;
        // Check RAG status for currently selected agent
        _ = CheckRagEnabledAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_tabInsertionEnabled)
        {
            // Enable tab key insertion in the text field
            try
            {
                await JSRuntime.InvokeVoidAsync("aesirTextInput.enableTabInsertion", _textFieldWrapper);
                _tabInsertionEnabled = true;
            }
            catch
            {
                // Silently ignore if we can't enable tab insertion
            }
        }
    }

    private async void HandleAgentChangedAsync()
    {
        await CheckRagEnabledAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckRagEnabledAsync()
    {
        var agent = ChatState.SelectedAgent;
        if (agent?.Id == null)
        {
            _isRagEnabled = false;
            return;
        }

        _isCheckingRag = true;
        try
        {
            _isRagEnabled = await AgentToolsService.AgentHasRagToolAsync(agent.Id.Value);
        }
        catch
        {
            _isRagEnabled = false;
        }
        finally
        {
            _isCheckingRag = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && CanSend)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        var message = _message.Trim();
        _message = string.Empty;

        // If we have files, use the OnSendWithFiles callback
        if (_pendingFiles.Count > 0 && OnSendWithFiles.HasDelegate)
        {
            var filesToSend = _pendingFiles.ToList();
            _pendingFiles.Clear();
            await OnSendWithFiles.InvokeAsync((message, filesToSend));
        }
        else
        {
            await OnSend.InvokeAsync(message);
        }

        StateHasChanged();
    }

    private async Task HandleAgentSelected(AesirAgentBase agent)
    {
        if (OnAgentSelected.HasDelegate)
        {
            await OnAgentSelected.InvokeAsync(agent);
        }
    }

    private async Task HandleToolToggled((Guid ToolId, bool Enabled) args)
    {
        if (OnToolToggled.HasDelegate)
        {
            await OnToolToggled.InvokeAsync(args);
        }
    }

    private async Task HandleThinkLevelChanged(ThinkValue? level)
    {
        if (OnThinkLevelChanged.HasDelegate)
        {
            await OnThinkLevelChanged.InvokeAsync(level);
        }
    }

    private void NavigateToHandsFree()
    {
        // Build URL with current agent and conversation context
        var agentId = ChatState.SelectedAgent?.Id;
        var conversationId = GetConversationId?.Invoke();

        var url = agentId.HasValue
            ? $"/hands-free/{agentId}"
            : "/hands-free";

        if (conversationId.HasValue && conversationId != Guid.Empty)
        {
            url += $"?conversation={conversationId}";
        }

        NavigationManager.NavigateTo(url);
    }

    private async Task HandleFileSelected(IBrowserFile file)
    {
        // Check for duplicate files
        if (_pendingFiles.Any(f => f.FileName == file.Name))
        {
            Snackbar.Add($"File '{file.Name}' is already attached.", Severity.Warning);
            return;
        }

        var pendingFile = new PendingFileUpload { File = file };
        _pendingFiles.Add(pendingFile);

        // Clear the file input to allow selecting the same file again
        if (_fileUploadButton != null)
        {
            await _fileUploadButton.ClearAsync();
        }

        // Generate object URL for image files for thumbnail preview
        if (FileTypeHelper.IsImage(file.Name))
        {
            try
            {
                pendingFile.ObjectUrl = await CreateObjectUrlAsync(file);
            }
            catch
            {
                // Thumbnail generation failed, will show fallback icon
            }
        }

        StateHasChanged();

        // Start immediate upload in background (like the Avalonia client)
        // This uploads and indexes the file right away, not waiting for message send
        _ = UploadFileImmediatelyAsync(pendingFile);
    }

    /// <summary>
    /// Creates a JavaScript object URL for a browser file to enable client-side preview.
    /// </summary>
    private async Task<string?> CreateObjectUrlAsync(IBrowserFile file)
    {
        try
        {
            // Read file into memory (limit to 10MB for thumbnails)
            const long maxSize = 10 * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var mimeType = file.ContentType;
            return $"data:{mimeType};base64,{base64}";
        }
        catch
        {
            return null;
        }
    }

    /// <summary>
    /// Uploads a file immediately after selection (background task).
    /// This matches the Avalonia client behavior where files are uploaded and indexed
    /// as soon as they are selected, showing a spinner while processing.
    /// </summary>
    private async Task UploadFileImmediatelyAsync(PendingFileUpload pendingFile)
    {
        // Get the conversation ID from the parent component
        if (GetConversationId == null)
        {
            // If no callback provided, fall back to waiting for send
            return;
        }

        var conversationId = GetConversationId();

        try
        {
            pendingFile.Status = UploadStatus.Uploading;
            await InvokeAsync(StateHasChanged);

            var progress = new Progress<int>(p =>
            {
                pendingFile.Progress = p;

                // Detect processing signal and update status accordingly
                if (p == DocumentApiService.ProcessingProgressSignal)
                {
                    pendingFile.Status = UploadStatus.Processing;
                }

                InvokeAsync(StateHasChanged);
            });

            await DocumentService.UploadFileAsync(
                conversationId,
                pendingFile.File,
                progress,
                pendingFile.CancellationTokenSource.Token);

            pendingFile.Status = UploadStatus.Completed;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            pendingFile.Status = UploadStatus.Cancelled;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            pendingFile.Status = UploadStatus.Failed;
            pendingFile.ErrorMessage = ex.Message;
            await InvokeAsync(StateHasChanged);
            Snackbar.Add($"Failed to upload '{pendingFile.FileName}': {ex.Message}", Severity.Error);
        }
    }

    private void HandleFileError(string error)
    {
        Snackbar.Add(error, Severity.Error);
    }

    private async Task RemovePendingFileAsync(PendingFileUpload file)
    {
        // If upload is in progress, cancel it (server-side cleanup handled by cancellation)
        if (file.Status == UploadStatus.Uploading)
        {
            file.CancellationTokenSource.Cancel();
        }
        // If upload completed successfully, delete from server (storage + vector store)
        else if (file.Status == UploadStatus.Completed && GetConversationId != null)
        {
            try
            {
                var conversationId = GetConversationId();
                await DocumentService.DeleteFileAsync(conversationId, file.FileName);
            }
            catch (Exception ex)
            {
                // Log but don't block removal from UI - file is already "gone" from user's perspective
                Console.WriteLine($"Failed to delete file from server: {ex.Message}");
            }
        }

        // Trigger exit animation
        file.IsRemoving = true;
        StateHasChanged();

        // Wait for animation to complete (200ms)
        await Task.Delay(200);

        _pendingFiles.Remove(file);
        StateHasChanged();
    }

    public void Focus()
    {
        _textField?.FocusAsync();
    }

    public void Clear()
    {
        _message = string.Empty;
        _pendingFiles.Clear();
        StateHasChanged();
    }

    /// <summary>
    /// Gets the pending files for external access.
    /// </summary>
    public IReadOnlyList<PendingFileUpload> PendingFiles => _pendingFiles.AsReadOnly();

    /// <summary>
    /// Adds a file to the pending files list (used by drag-and-drop).
    /// </summary>
    public async Task AddFileAsync(IBrowserFile file)
    {
        await HandleFileSelected(file);
    }

    /// <summary>
    /// Gets whether RAG is enabled for the current agent.
    /// </summary>
    public bool IsRagEnabled => _isRagEnabled;

    public async ValueTask DisposeAsync()
    {
        ChatState.OnAgentChanged -= HandleAgentChangedAsync;

        // Disable tab key insertion handler
        if (_tabInsertionEnabled)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("aesirTextInput.disableTabInsertion", _textFieldWrapper);
            }
            catch
            {
                // Ignore cleanup errors
            }
        }

        // Cancel any pending uploads and clean up object URLs
        foreach (var file in _pendingFiles)
        {
            file.CancellationTokenSource.Cancel();
            file.CancellationTokenSource.Dispose();
        }

        // Clear the list
        _pendingFiles.Clear();
    }
}
