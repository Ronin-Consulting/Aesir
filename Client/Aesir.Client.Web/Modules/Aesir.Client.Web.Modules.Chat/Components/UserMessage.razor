@inject IDocumentApiService DocumentService
@inject IMarkdownService MarkdownService
@inject IJSRuntime JSRuntime

<div class="user-message @ThemeClass">
    <div class="message-wrapper">
        <div class="message-bubble">
            @* Main content row *@
            <div class="message-main">
            <div class="message-content">
                @if (_isEditing)
                {
                    @* Edit Mode *@
                    <div class="edit-mode">
                        <MudTextField @bind-Value="_editedContent"
                                      Variant="Variant.Outlined"
                                      Lines="3"
                                      AutoGrow="true"
                                      MaxLines="10"
                                      FullWidth="true"
                                      Immediate="true"
                                      Class="edit-textarea"
                                      OnKeyDown="HandleEditKeyDown" />
                        <div class="edit-actions">
                            <MudButton Size="Size.Small"
                                       Color="Color.Default"
                                       Variant="Variant.Text"
                                       OnClick="CancelEdit">
                                Cancel
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Color="Color.Primary"
                                       Variant="Variant.Filled"
                                       OnClick="SubmitEdit"
                                       Disabled="@string.IsNullOrWhiteSpace(_editedContent)">
                                Submit
                            </MudButton>
                        </div>
                    </div>
                }
                else
                {
                    @* Display Mode *@
                    @if (Message.HasFile())
                    {
                        @* Image attachments displayed as thumbnails *@
                        @if (ImageFiles.Any())
                        {
                            <div class="attached-images @(ImageFiles.Count == 1 ? "single" : ImageFiles.Count == 2 ? "double" : "grid")">
                                @foreach (var fileName in ImageFiles)
                                {
                                    var isDeleted = IsFileDeleted(fileName);
                                    <div class="image-attachment @(isDeleted ? "deleted" : "")">
                                        @if (!isDeleted && ConversationId.HasValue)
                                        {
                                            <ImageThumbnail FileName="@fileName"
                                                            ImageUrl="@DocumentService.GetDownloadUrl(ConversationId.Value, fileName)"
                                                            Size="ImageThumbnail.ThumbnailSize.Large"
                                                            OnClick="@(() => HandleFileClick(fileName))" />
                                        }
                                        else
                                        {
                                            <div class="deleted-image-placeholder">
                                                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="MudBlazor.Size.Medium" />
                                                <span class="deleted-text">Deleted</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @* Non-image files displayed as cards *@
                        @if (OtherFiles.Any())
                        {
                            <div class="attached-files">
                                @foreach (var fileName in OtherFiles)
                                {
                                    var thumbnailUrl = GetThumbnailUrl(fileName);
                                    <FileCard FileName="@fileName"
                                              Size="FileCard.FileCardSize.Compact"
                                              ShowFileSize="false"
                                              IsDeleted="@IsFileDeleted(fileName)"
                                              ThumbnailUrl="@thumbnailUrl"
                                              ShowThumbnail="@(!string.IsNullOrEmpty(thumbnailUrl))"
                                              OnClick="@(() => HandleFileClick(fileName))" />
                                }
                            </div>
                        }
                    }
                    <div class="message-text markdown-body user-markdown">
                        @((MarkupString)MarkdownService.ToHtmlPreservingWhitespace(GetDisplayContent()))
                    </div>
                }
            </div>
        </div>
    </div>
    @* Message metadata - outside bubble, right-aligned, visible on row hover *@
    @if (!_isEditing)
    {
        <div class="message-metadata">
            @if (Message.CreatedAt.HasValue)
            {
                <span class="message-timestamp">@FormatTimestamp()</span>
            }
            <div class="message-actions">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Size="Size.Small"
                               Class="action-btn"
                               Title="Edit message"
                               Disabled="@IsStreaming"
                               OnClick="StartEdit" />
                <MudIconButton Icon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)"
                               Size="Size.Small"
                               Class="@GetCopyButtonClass()"
                               Title="@(_copied ? "Copied!" : "Copy message")"
                               OnClick="CopyToClipboard" />
                <MudText Typo="Typo.body2" Class="action-text" @onclick="HandleRerun" title="Re-run">Re-run</MudText>
            </div>
        </div>
    }
    </div>
</div>

<style>
    .user-message {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        margin-bottom: 16px;
        padding: 0 48px;
    }

    /* Wrapper constrains both bubble and metadata to same width */
    .user-message .message-wrapper {
        display: flex;
        flex-direction: column;
        max-width: 85%;
    }

    .user-message .message-bubble {
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        padding: 12px 20px;
        position: relative;
    }

    /* Main content row */
    .user-message .message-main {
        display: flex;
        align-items: flex-start;
    }

    /* Dark theme styles */
    .user-message.theme-dark .message-bubble {
        background-color: #424242;
    }

    .user-message.theme-dark .message-text {
        color: #ffffff;
    }

    /* Light theme styles */
    .user-message.theme-light .message-bubble {
        background-color: #e0e0e0;
    }

    .user-message.theme-light .message-text {
        color: #212121;
    }

    .user-message .message-content {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .user-message .attached-files {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    /* Image attachments grid */
    .user-message .attached-images {
        display: flex;
        gap: 8px;
        margin-bottom: 4px;
    }

    .user-message .attached-images.single .image-attachment {
        max-width: 200px;
    }

    .user-message .attached-images.double {
        display: flex;
    }

    .user-message .attached-images.double .image-attachment {
        max-width: 150px;
    }

    .user-message .attached-images.grid {
        display: flex;
        flex-wrap: wrap;
    }

    .user-message .attached-images.grid .image-attachment {
        max-width: 120px;
    }

    .user-message .image-attachment {
        border-radius: 8px;
        overflow: hidden;
    }

    .user-message .image-attachment.deleted {
        opacity: 0.6;
    }

    .user-message .deleted-image-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        padding: 16px;
        min-width: 80px;
        min-height: 60px;
        color: var(--mud-palette-text-secondary);
    }

    .user-message .deleted-image-placeholder .deleted-text {
        font-size: 0.7rem;
        margin-top: 4px;
    }

    .user-message .message-text {
        font-size: 1rem;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* User message markdown styling */
    .user-message .user-markdown p {
        margin: 0 0 0.5em 0;
    }

    .user-message .user-markdown p:last-child {
        margin-bottom: 0;
    }

    /* Inline code */
    .user-message .user-markdown code {
        background-color: rgba(0, 0, 0, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9em;
    }

    /* Code blocks */
    .user-message .user-markdown pre {
        background-color: rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        padding: 12px;
        overflow-x: auto;
        margin: 8px 0;
    }

    .user-message .user-markdown pre code {
        background-color: transparent;
        padding: 0;
    }

    /* Code block wrapper (from MarkdownService) */
    .user-message .user-markdown .code-block-wrapper {
        margin: 8px 0;
        border-radius: 8px;
        overflow: hidden;
        background-color: rgba(0, 0, 0, 0.1);
    }

    .user-message .user-markdown .code-block-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 12px;
        background-color: rgba(0, 0, 0, 0.05);
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .user-message .user-markdown .code-language {
        font-size: 0.75rem;
        color: var(--mud-palette-text-secondary);
        text-transform: uppercase;
    }

    .user-message .user-markdown .code-copy-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border: none;
        background: transparent;
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        border-radius: 4px;
        font-size: 0.75rem;
    }

    .user-message .user-markdown .code-copy-btn:hover {
        background-color: rgba(0, 0, 0, 0.1);
    }

    /* Lists */
    .user-message .user-markdown ul,
    .user-message .user-markdown ol {
        margin: 4px 0;
        padding-left: 20px;
    }

    .user-message .user-markdown li {
        margin-bottom: 2px;
    }

    /* Links */
    .user-message .user-markdown a {
        color: var(--mud-palette-primary);
        text-decoration: none;
    }

    .user-message .user-markdown a:hover {
        text-decoration: underline;
    }

    /* Bold and italic */
    .user-message .user-markdown strong {
        font-weight: 600;
    }

    .user-message .user-markdown em {
        font-style: italic;
    }

    /* Blockquotes */
    .user-message .user-markdown blockquote {
        border-left: 3px solid var(--mud-palette-primary);
        margin: 8px 0;
        padding: 4px 12px;
        opacity: 0.9;
    }

    /* Theme-specific adjustments for dark mode */
    .user-message.theme-dark .user-markdown code {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .user-message.theme-dark .user-markdown pre,
    .user-message.theme-dark .user-markdown .code-block-wrapper {
        background-color: rgba(0, 0, 0, 0.3);
    }

    .user-message.theme-dark .user-markdown .code-block-header {
        background-color: rgba(0, 0, 0, 0.2);
        border-bottom-color: rgba(255, 255, 255, 0.1);
    }

    /* Message metadata - outside bubble, right-aligned, visible on row hover */
    .user-message .message-metadata {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        margin-top: 4px;
        padding-right: 8px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    /* Show metadata on row hover (not just bubble hover) */
    .user-message:hover .message-metadata {
        opacity: 1;
    }

    /* Timestamp styling */
    .user-message .message-timestamp {
        font-size: 0.65rem;
        color: var(--mud-palette-text-secondary);
        opacity: 0.6;
    }

    /* Message Actions */
    .user-message .message-actions {
        display: flex;
        align-items: center;
        gap: 2px;
    }

    .user-message .action-btn {
        color: var(--mud-palette-text-secondary);
        width: 32px;
        height: 32px;
    }

    .user-message .action-btn:hover {
        background-color: rgba(0, 0, 0, 0.08);
    }

    .user-message .action-btn.copied {
        color: #10B981 !important;
    }

    /* Re-run text button */
    .user-message .action-text {
        cursor: pointer;
        padding: 4px 8px;
        font-size: 0.875rem;
        color: var(--mud-palette-text-secondary);
        border-radius: 4px;
    }

    .user-message .action-text:hover {
        color: var(--mud-palette-primary);
        background-color: rgba(0, 0, 0, 0.04);
    }

    /* Edit mode styling */
    .user-message .edit-mode {
        width: 100%;
        min-width: 300px;
    }

    .user-message .edit-textarea {
        background: rgba(255, 255, 255, 0.05);
    }

    .user-message .edit-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 8px;
    }
</style>

@code {
    [Parameter]
    public required AesirChatMessage Message { get; set; }

    [Parameter]
    public string UserDisplayName { get; set; } = "blangford@gmail.com";

    [Parameter]
    public Guid? ConversationId { get; set; }

    /// <summary>
    /// List of files that currently exist in the conversation.
    /// Used to determine if a file has been deleted and whether thumbnails are available.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ConversationFile> ExistingFiles { get; set; } = [];

    /// <summary>
    /// Whether the files list has been loaded from the API.
    /// Used to distinguish between "not loaded yet" and "loaded but empty".
    /// </summary>
    [Parameter]
    public bool FilesLoaded { get; set; }

    /// <summary>
    /// Set of filenames that were recently uploaded (within grace period).
    /// These won't be marked as deleted even if not yet in ExistingFiles,
    /// to handle the race condition where API hasn't synced yet.
    /// </summary>
    [Parameter]
    public IReadOnlySet<string>? RecentlyUploadedFiles { get; set; }

    /// <summary>
    /// Index of this message in the conversation (used for edit operations).
    /// </summary>
    [Parameter]
    public int MessageIndex { get; set; }

    /// <summary>
    /// Event callback when user wants to edit this message.
    /// Returns the message index and new content.
    /// </summary>
    [Parameter]
    public EventCallback<(int Index, string NewContent)> OnEdit { get; set; }

    /// <summary>
    /// Event callback when user wants to re-run this message without editing.
    /// Returns the message index.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnRerun { get; set; }

    /// <summary>
    /// Whether a response is currently streaming (disables edit/re-run).
    /// </summary>
    [Parameter]
    public bool IsStreaming { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeClass => IsDarkMode ? "theme-dark" : "theme-light";

    /// <summary>
    /// Whether this message is currently in edit mode.
    /// </summary>
    private bool _isEditing;

    /// <summary>
    /// The edited content while in edit mode.
    /// </summary>
    private string _editedContent = string.Empty;

    /// <summary>
    /// Whether the copy action succeeded (for visual feedback).
    /// </summary>
    private bool _copied;

    /// <summary>
    /// Image file attachments for this message.
    /// </summary>
    private List<string> ImageFiles => Message.GetFileNames()
        .Where(f => FileTypeHelper.IsImage(f))
        .ToList();

    /// <summary>
    /// Non-image file attachments for this message.
    /// </summary>
    private List<string> OtherFiles => Message.GetFileNames()
        .Where(f => !FileTypeHelper.IsImage(f))
        .ToList();

    /// <summary>
    /// Checks if the specified file attached to this message has been deleted.
    /// </summary>
    private bool IsFileDeleted(string fileName)
    {
        if (string.IsNullOrEmpty(fileName))
            return false;

        // If the files list hasn't been loaded yet, assume files exist
        // to avoid showing false "deleted" states during initial load
        if (!FilesLoaded)
            return false;

        // Grace period: don't mark recently uploaded files as deleted
        // This handles the race condition where the API hasn't synced yet
        if (RecentlyUploadedFiles?.Contains(fileName) == true)
            return false;

        // File is deleted if it's not in the existing files list
        return !ExistingFiles.Any(f =>
            f.DisplayName.Equals(fileName, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Gets the thumbnail URL for a file if it has a thumbnail available.
    /// </summary>
    private string? GetThumbnailUrl(string fileName)
    {
        if (string.IsNullOrEmpty(fileName) || !ConversationId.HasValue)
            return null;

        // Find the file in the existing files list
        var file = ExistingFiles.FirstOrDefault(f =>
            f.DisplayName.Equals(fileName, StringComparison.OrdinalIgnoreCase));

        // Return thumbnail URL only if the file has a thumbnail
        if (file?.HasThumbnail == true)
        {
            return DocumentService.GetThumbnailUrl(ConversationId.Value, fileName);
        }

        return null;
    }

    private string GetDisplayContent()
    {
        if (Message.HasFile())
        {
            return Message.GetContentWithoutFileName() ?? Message.Content;
        }
        return Message.Content;
    }

    private async Task HandleFileClick(string fileName)
    {
        if (!ConversationId.HasValue || string.IsNullOrEmpty(fileName))
            return;

        try
        {
            var downloadUrl = DocumentService.GetDownloadUrl(ConversationId.Value, fileName);
            await JSRuntime.InvokeVoidAsync("downloadFile", downloadUrl, fileName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to download file: {ex.Message}");
        }
    }

    /// <summary>
    /// Formats the message timestamp for display using humanized format.
    /// Today: "11:39 AM", Yesterday: "Yesterday 11:39 AM", This year: "Dec 12", Older: "Dec 12, 2024"
    /// </summary>
    private string FormatTimestamp()
    {
        if (!Message.CreatedAt.HasValue)
            return string.Empty;

        var local = Message.CreatedAt.Value.ToLocalTime();
        var now = DateTimeOffset.Now;
        var today = now.Date;
        var messageDate = local.Date;

        // Today: just show time
        if (messageDate == today)
            return local.ToString("h:mm tt");

        // Yesterday: show "Yesterday" with time
        if (messageDate == today.AddDays(-1))
            return $"Yesterday {local.ToString("h:mm tt")}";

        // This year: month and day only
        if (local.Year == now.Year)
            return local.ToString("MMM d");

        // Different year: include year
        return local.ToString("MMM d, yyyy");
    }

    /// <summary>
    /// Enters edit mode with current message content.
    /// </summary>
    private void StartEdit()
    {
        _editedContent = GetDisplayContent();
        _isEditing = true;
    }

    /// <summary>
    /// Cancels edit mode without saving.
    /// </summary>
    private void CancelEdit()
    {
        _isEditing = false;
        _editedContent = string.Empty;
    }

    /// <summary>
    /// Submits the edited message.
    /// </summary>
    private async Task SubmitEdit()
    {
        if (string.IsNullOrWhiteSpace(_editedContent))
            return;

        _isEditing = false;

        if (OnEdit.HasDelegate)
        {
            await OnEdit.InvokeAsync((MessageIndex, _editedContent.Trim()));
        }

        _editedContent = string.Empty;
    }

    /// <summary>
    /// Handles keyboard events in edit mode.
    /// </summary>
    private async Task HandleEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CancelEdit();
        }
        else if (e.Key == "Enter" && e.CtrlKey && !string.IsNullOrWhiteSpace(_editedContent))
        {
            await SubmitEdit();
        }
    }

    /// <summary>
    /// Gets the CSS class for the copy button.
    /// </summary>
    private string GetCopyButtonClass()
    {
        return _copied ? "action-btn copied" : "action-btn";
    }

    /// <summary>
    /// Copies the message content to clipboard.
    /// </summary>
    private async Task CopyToClipboard()
    {
        var content = GetDisplayContent();
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", content);

        _copied = true;
        StateHasChanged();

        // Reset after 2 seconds
        await Task.Delay(2000);
        _copied = false;
        StateHasChanged();
    }

    /// <summary>
    /// Re-runs this message without editing.
    /// </summary>
    private async Task HandleRerun()
    {
        if (IsStreaming)
            return;

        if (OnRerun.HasDelegate)
        {
            await OnRerun.InvokeAsync(MessageIndex);
        }
    }
}
