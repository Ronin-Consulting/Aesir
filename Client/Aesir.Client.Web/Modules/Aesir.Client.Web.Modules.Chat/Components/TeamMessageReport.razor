@code {
    private ResearchReportBase? _fullReport;
    private bool _isLoading = true;
    private string? _loadError;
    private HashSet<int> _expandedEvidence = new();

    [Parameter]
    public required ResearchReportSummaryBase Report { get; set; }

    [Parameter]
    public Guid? SessionId { get; set; }

    [Inject]
    private IResearchSessionApiService? ResearchApi { get; set; }

    [Inject]
    private IMarkdownService? MarkdownService { get; set; }

    [Inject]
    private IJSRuntime? JSRuntime { get; set; }

    [Inject]
    private ISnackbar? Snackbar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadFullReport();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload if Report ID changes
        if (_fullReport != null && _fullReport.Id != Report.Id)
        {
            _fullReport = null;
            _expandedEvidence.Clear();
            await LoadFullReport();
        }
    }

    private async Task LoadFullReport()
    {
        if (ResearchApi == null)
        {
            _loadError = "API service not available";
            _isLoading = false;
            return;
        }

        _isLoading = true;
        _loadError = null;

        try
        {
            // Use SessionId if provided, otherwise use Report.Id
            var idToFetch = SessionId ?? Report.Id;
            var result = await ResearchApi.GetReportAsync(idToFetch);

            if (result.IsSuccess && result.Value != null)
            {
                _fullReport = result.Value;
            }
            else
            {
                _loadError = "Unable to load full report details";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load full report: {ex.Message}");
            _loadError = "Failed to load report";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleEvidence(int findingIndex)
    {
        if (_expandedEvidence.Contains(findingIndex))
        {
            _expandedEvidence.Remove(findingIndex);
        }
        else
        {
            _expandedEvidence.Add(findingIndex);
        }
    }

    private async Task HandleDownload()
    {
        if (ResearchApi == null || JSRuntime == null) return;

        try
        {
            var idToFetch = SessionId ?? Report.Id;
            var result = await ResearchApi.GetReportMarkdownAsync(idToFetch);
            if (result.IsSuccess && result.Value != null)
            {
                var fileName = $"research-report-{idToFetch:N}.md";
                await JSRuntime.InvokeVoidAsync("downloadText", result.Value, fileName, "text/markdown");
                Snackbar?.Add("Report downloaded", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to download report: {ex.Message}");
            Snackbar?.Add("Failed to download report", Severity.Error);
        }
    }

    private async Task HandleCopy()
    {
        if (JSRuntime == null || _fullReport == null) return;

        try
        {
            var textToCopy = _fullReport.FullMarkdown ?? _fullReport.ExecutiveSummary ?? Report.Title;
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", textToCopy);
            Snackbar?.Add("Report copied to clipboard", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to copy report: {ex.Message}");
            Snackbar?.Add("Failed to copy report", Severity.Error);
        }
    }
}
