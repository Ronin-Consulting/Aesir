@using Aesir.Client.Web.Modules.Chat.Models
@using Aesir.Client.Web.Modules.Chat.Services
@inject ICitationStateService CitationStateService
@inject ICitationLinkParser CitationLinkParser
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@* This is a headless component that handles citation link clicks from JavaScript *@

@code {
    private DotNetObjectReference<CitationHandler>? _dotNetRef;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("aesirCitationHandler.initialize", _dotNetRef);
        }
    }

    /// <summary>
    /// Called from JavaScript when a citation link is clicked.
    /// </summary>
    [JSInvokable]
    public async Task HandleCitationClick(CitationClickInfo clickInfo)
    {
        if (clickInfo == null)
        {
            return;
        }

        // Parse the file extension to determine file type
        var fileType = CitationLinkParser.GetFileType(clickInfo.FileExtension ?? string.Empty);

        var citation = new CitationInfo
        {
            ConversationId = clickInfo.ConversationId ?? string.Empty,
            FileName = clickInfo.FileName ?? string.Empty,
            FileExtension = clickInfo.FileExtension ?? string.Empty,
            PageNumber = clickInfo.PageNumber,
            FileType = fileType,
            OriginalUrl = $"file:///{clickInfo.ConversationId}/{clickInfo.FileName}"
        };

        await CitationStateService.OpenCitationAsync(citation);
    }

    /// <summary>
    /// Called from JavaScript when the Escape key is pressed while the viewer is open.
    /// </summary>
    [JSInvokable]
    public void HandleEscapeKey()
    {
        if (CitationStateService.IsViewerOpen)
        {
            CitationStateService.CloseCitation();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef != null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("aesirCitationHandler.dispose");
            }
            catch (JSDisconnectedException)
            {
                // Ignore - browser has disconnected
            }

            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    /// <summary>
    /// DTO for citation click info from JavaScript.
    /// </summary>
    public class CitationClickInfo
    {
        public string? ConversationId { get; set; }
        public string? FileName { get; set; }
        public string? FileExtension { get; set; }
        public int? PageNumber { get; set; }
    }
}
