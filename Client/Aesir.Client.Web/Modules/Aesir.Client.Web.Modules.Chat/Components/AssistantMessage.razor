@using Aesir.Common.Models
@using Aesir.Client.Web.Modules.Chat.Services
@inject IMarkdownService MarkdownService
@inject IJSRuntime JSRuntime

<div class="assistant-message @ThemeClass">
    <div class="message-container">
            @* Collapsible Tool Calls Section *@
            @if (ShowToolCalls && ToolCalls?.Count > 0)
            {
                <ToolCallsSection ToolCalls="ToolCalls" IsStreaming="IsStreaming" AutoExpandWhenActive="true" />
            }
            @* Collapsible Thinking Section (Claude-style) *@
            @if (ShowThinking && !string.IsNullOrEmpty(Message.ThoughtsContent))
            {
                <div class="thinking-section">
                    <div class="thinking-toggle @(_thinkingExpanded ? "expanded" : "")" @onclick="ToggleThinking">
                        <MudIcon Icon="@(_thinkingExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Size="Size.Small" Class="toggle-icon" />
                        <span class="thinking-summary">@GetThinkingSummary()</span>
                    </div>
                    @if (_thinkingExpanded)
                    {
                        <div class="thinking-content">
                            @((MarkupString)MarkdownService.ToHtml(Message.ThoughtsContent))
                        </div>
                    }
                </div>
            }
            @* Main Message Content (clean, minimal style like Claude) *@
            <div class="message-content markdown-body">
                @((MarkupString)MarkdownService.ToHtml(Message.Content))
            </div>
            @* Response Footer with Actions - Claude style: right-aligned icons *@
            <div class="response-footer">
                <div class="response-actions">
                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                   Size="Size.Small"
                                   Class="action-btn"
                                   Title="Copy response"
                                   OnClick="CopyToClipboard" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ThumbUpOffAlt"
                                   Size="Size.Small"
                                   Class="action-btn"
                                   Title="Good response" />
                    <MudIconButton Icon="@Icons.Material.Outlined.ThumbDownOffAlt"
                                   Size="Size.Small"
                                   Class="action-btn"
                                   Title="Bad response" />
                    <MudText Typo="Typo.body2" Class="action-text" @onclick="HandleRetry" title="Retry">Retry</MudText>
                </div>
            </div>
    </div>
    @* AESIR Brand Icon - Only shows on latest message, large and prominent with ready message *@
    @if (IsLatestMessage)
    {
        <div class="brand-section-large">
            <AesirBrandIcon IconSize="AesirBrandIcon.BrandIconSize.ExtraLarge" ShowReadyMessage="true" />
        </div>
    }
    @if (ShowDisclaimer)
    {
        <div class="disclaimer">
            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                ÆSIR can make mistakes. Please double-check responses.
            </MudText>
        </div>
    }
</div>

<style>
    .assistant-message {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 8px;
        padding: 0 48px;
        max-width: 100%;
    }

    /* Message Container with subtle background */
    .assistant-message .message-container {
        background-color: rgba(84, 169, 255, 0.03);
        border: 1px solid rgba(84, 169, 255, 0.1);
        border-radius: 12px;
        padding: 16px;
        width: 100%;
    }

    /* Theme variations for container */
    .assistant-message.theme-dark .message-container {
        background-color: rgba(84, 169, 255, 0.04);
        border-color: rgba(84, 169, 255, 0.12);
    }

    .assistant-message.theme-light .message-container {
        background-color: rgba(84, 169, 255, 0.025);
        border-color: rgba(84, 169, 255, 0.1);
    }

    /* Collapsible Thinking Section */
    .assistant-message .thinking-section {
        width: 100%;
        margin-bottom: 12px;
    }

    .assistant-message .thinking-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 8px 12px;
        background-color: rgba(84, 169, 255, 0.1);
        border-radius: 8px;
        transition: background-color 0.2s ease;
    }

    .assistant-message .thinking-toggle:hover {
        background-color: rgba(84, 169, 255, 0.15);
    }

    .assistant-message .thinking-toggle .toggle-icon {
        color: #54A9FF;
        transition: transform 0.2s ease;
    }

    .assistant-message .thinking-toggle.expanded .toggle-icon {
        transform: rotate(0deg);
    }

    .assistant-message .thinking-summary {
        font-size: 0.875rem;
        color: var(--mud-palette-text-secondary);
        font-style: italic;
    }

    .assistant-message .thinking-content {
        font-size: 0.85rem;
        color: var(--mud-palette-text-secondary);
        background-color: rgba(84, 169, 255, 0.05);
        border-radius: 0 0 8px 8px;
        padding: 12px 16px;
        margin-top: -4px;
        border-left: 2px solid #54A9FF;
        animation: fadeIn 0.2s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-4px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Message Content - Clean minimal style */
    .assistant-message .message-content {
        word-wrap: break-word;
        overflow-wrap: break-word;
        line-height: 1.6;
        color: var(--mud-palette-text-primary);
    }

    /* Response Footer */
    .assistant-message .response-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 8px;
        width: 100%;
    }

    /* Response Actions */
    .assistant-message .response-actions {
        display: flex;
        align-items: center;
        gap: 2px;
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .assistant-message:hover .response-actions {
        opacity: 1;
    }

    .assistant-message .action-btn {
        color: var(--mud-palette-text-secondary);
        width: 32px;
        height: 32px;
    }

    .assistant-message .action-btn:hover {
        color: var(--mud-palette-text-primary);
        background-color: rgba(255, 255, 255, 0.1);
    }

    .assistant-message .action-text {
        color: var(--mud-palette-text-secondary);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .assistant-message .action-text:hover {
        color: var(--mud-palette-text-primary);
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Large Brand Section - Only on latest message */
    .assistant-message .brand-section-large {
        margin-top: 16px;
        opacity: 0.5;
    }

    /* Disclaimer */
    .assistant-message .disclaimer {
        margin-top: 8px;
        text-align: center;
    }

    /* Markdown styling */
    .assistant-message .markdown-body p {
        margin: 0 0 0.75em 0;
    }

    .assistant-message .markdown-body p:last-child {
        margin-bottom: 0;
    }

    /* Code block wrapper with copy button */
    .assistant-message .markdown-body .code-block-wrapper {
        position: relative;
        margin: 12px 0;
        border-radius: 8px;
        overflow: hidden;
        background-color: #1e1e2e;
    }

    .assistant-message .markdown-body .code-block-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 12px;
        background-color: rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .assistant-message .markdown-body .code-language {
        font-size: 0.75rem;
        color: #a0a0a0;
        text-transform: uppercase;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .assistant-message .markdown-body .code-copy-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        color: #a0a0a0;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .assistant-message .markdown-body .code-copy-btn:hover {
        background-color: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.3);
        color: #e0e0e0;
    }

    .assistant-message .markdown-body .code-copy-btn.copied {
        background-color: rgba(16, 185, 129, 0.2);
        border-color: rgba(16, 185, 129, 0.5);
        color: #10B981;
    }

    .assistant-message .markdown-body .code-copy-btn svg {
        width: 14px;
        height: 14px;
    }

    .assistant-message .markdown-body .code-block-wrapper pre {
        margin: 0;
        border-radius: 0;
        background-color: transparent;
    }

    .assistant-message .markdown-body .code-block-wrapper pre code {
        color: #e0e0e0;
    }

    .assistant-message .markdown-body pre {
        background-color: #1e1e2e;
        border-radius: 8px;
        padding: 16px;
        overflow-x: auto;
        margin: 12px 0;
        color: #e0e0e0;
    }

    .assistant-message .markdown-body code {
        background-color: rgba(0, 0, 0, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
        font-size: 0.9em;
    }

    .assistant-message .markdown-body pre code {
        background-color: transparent;
        padding: 0;
        color: #e0e0e0;
    }

    /* List styling - enhanced */
    .assistant-message .markdown-body ul,
    .assistant-message .markdown-body ol {
        margin: 8px 0;
        padding-left: 24px;
    }

    .assistant-message .markdown-body li {
        margin-bottom: 4px;
        line-height: 1.6;
    }

    .assistant-message .markdown-body li:last-child {
        margin-bottom: 0;
    }

    /* Nested list indentation */
    .assistant-message .markdown-body ul ul,
    .assistant-message .markdown-body ol ol,
    .assistant-message .markdown-body ul ol,
    .assistant-message .markdown-body ol ul {
        margin: 4px 0;
        padding-left: 20px;
    }

    /* Unordered list bullets - using disc/circle/square for nesting levels */
    .assistant-message .markdown-body ul {
        list-style-type: disc;
    }

    .assistant-message .markdown-body ul ul {
        list-style-type: circle;
    }

    .assistant-message .markdown-body ul ul ul {
        list-style-type: square;
    }

    /* Ordered list styling */
    .assistant-message .markdown-body ol {
        list-style-type: decimal;
    }

    .assistant-message .markdown-body ol ol {
        list-style-type: lower-alpha;
    }

    .assistant-message .markdown-body ol ol ol {
        list-style-type: lower-roman;
    }

    /* List marker color */
    .assistant-message .markdown-body li::marker {
        color: var(--mud-palette-text-secondary);
    }

    /* Blockquote styling - refined */
    .assistant-message .markdown-body blockquote {
        border-left: 4px solid var(--mud-palette-primary);
        margin: 12px 0;
        padding: 8px 16px;
        color: var(--mud-palette-text-secondary);
    }

    .assistant-message .markdown-body blockquote p {
        margin: 0;
    }

    .assistant-message .markdown-body blockquote blockquote {
        margin: 8px 0;
    }

    /* Horizontal rule styling - gradient fade */
    .assistant-message .markdown-body hr {
        border: none;
        height: 1px;
        background: linear-gradient(
            to right,
            transparent,
            var(--mud-palette-lines-default),
            transparent
        );
        margin: 24px 0;
    }

    /* Table styling - enhanced with striping and hover */
    .assistant-message .markdown-body table {
        border-collapse: collapse;
        width: 100%;
        margin: 12px 0;
        border-radius: 8px;
        overflow: hidden;
    }

    .assistant-message .markdown-body th,
    .assistant-message .markdown-body td {
        border: 1px solid var(--mud-palette-lines-default);
        padding: 10px 14px;
        text-align: left;
    }

    .assistant-message .markdown-body th {
        background-color: rgba(255, 255, 255, 0.05);
        font-weight: 600;
    }

    /* Striped rows */
    .assistant-message .markdown-body tr:nth-child(odd) td {
        background-color: rgba(255, 255, 255, 0.02);
    }

    /* Row hover effect */
    .assistant-message .markdown-body tr:hover td {
        background-color: rgba(84, 169, 255, 0.05);
    }

    /* Table overflow container for wide tables */
    .assistant-message .markdown-body .table-wrapper {
        overflow-x: auto;
        margin: 12px 0;
    }

    .assistant-message .markdown-body a {
        color: #54A9FF;
        text-decoration: none;
    }

    .assistant-message .markdown-body a:hover {
        text-decoration: underline;
    }

    /* External link indicator - subtle arrow for links that open in new tab */
    .assistant-message .markdown-body a.external-link::after {
        content: '↗';
        font-size: 0.75em;
        margin-left: 2px;
        opacity: 0.5;
        vertical-align: super;
    }

    .assistant-message .markdown-body a.external-link:hover::after {
        opacity: 0.8;
    }

    /* Citation Link Styling - Base */
    .assistant-message .markdown-body .citation-link {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin: 2px 4px;
        padding: 3px 10px;
        background-color: rgba(117, 117, 117, 0.1);
        border: 1px solid rgba(117, 117, 117, 0.25);
        border-radius: 14px;
        color: #757575;
        font-size: 0.85em;
        text-decoration: none;
        transition: all 0.15s ease;
        cursor: pointer;
        vertical-align: middle;
    }

    .assistant-message .markdown-body .citation-link:hover {
        background-color: rgba(117, 117, 117, 0.18);
        border-color: rgba(117, 117, 117, 0.4);
        text-decoration: none;
        transform: translateY(-1px);
    }

    .assistant-message .markdown-body .citation-link .citation-icon {
        flex-shrink: 0;
        opacity: 0.85;
    }

    .assistant-message .markdown-body .citation-link .citation-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
        font-weight: 500;
    }

    .assistant-message .markdown-body .citation-link .citation-page {
        font-size: 0.75em;
        padding: 1px 5px;
        background-color: rgba(0, 0, 0, 0.08);
        border-radius: 8px;
        margin-left: 2px;
    }

    .assistant-message .markdown-body .citation-link:active {
        transform: scale(0.97);
    }

    /* File type specific colors - PDF (Blue) */
    .assistant-message .markdown-body .citation-link.citation-pdf {
        background-color: rgba(84, 169, 255, 0.1);
        border-color: rgba(84, 169, 255, 0.3);
        color: #54A9FF;
    }
    .assistant-message .markdown-body .citation-link.citation-pdf:hover {
        background-color: rgba(84, 169, 255, 0.18);
        border-color: rgba(84, 169, 255, 0.45);
    }

    /* Image (Blue) */
    .assistant-message .markdown-body .citation-link.citation-image {
        background-color: rgba(84, 169, 255, 0.1);
        border-color: rgba(84, 169, 255, 0.3);
        color: #54A9FF;
    }
    .assistant-message .markdown-body .citation-link.citation-image:hover {
        background-color: rgba(84, 169, 255, 0.18);
        border-color: rgba(84, 169, 255, 0.45);
    }

    /* Document (Green) */
    .assistant-message .markdown-body .citation-link.citation-document {
        background-color: rgba(16, 185, 129, 0.1);
        border-color: rgba(16, 185, 129, 0.3);
        color: #10B981;
    }
    .assistant-message .markdown-body .citation-link.citation-document:hover {
        background-color: rgba(16, 185, 129, 0.18);
        border-color: rgba(16, 185, 129, 0.45);
    }

    /* Data (Orange) */
    .assistant-message .markdown-body .citation-link.citation-data {
        background-color: rgba(245, 158, 11, 0.1);
        border-color: rgba(245, 158, 11, 0.3);
        color: #F59E0B;
    }
    .assistant-message .markdown-body .citation-link.citation-data:hover {
        background-color: rgba(245, 158, 11, 0.18);
        border-color: rgba(245, 158, 11, 0.45);
    }

    /* Code (Purple) */
    .assistant-message .markdown-body .citation-link.citation-code {
        background-color: rgba(142, 36, 170, 0.1);
        border-color: rgba(142, 36, 170, 0.3);
        color: #8E24AA;
    }
    .assistant-message .markdown-body .citation-link.citation-code:hover {
        background-color: rgba(142, 36, 170, 0.18);
        border-color: rgba(142, 36, 170, 0.45);
    }

    /* Archive (Brown) */
    .assistant-message .markdown-body .citation-link.citation-archive {
        background-color: rgba(109, 76, 65, 0.1);
        border-color: rgba(109, 76, 65, 0.3);
        color: #6D4C41;
    }
    .assistant-message .markdown-body .citation-link.citation-archive:hover {
        background-color: rgba(109, 76, 65, 0.18);
        border-color: rgba(109, 76, 65, 0.45);
    }

    .assistant-message .markdown-body h1,
    .assistant-message .markdown-body h2,
    .assistant-message .markdown-body h3,
    .assistant-message .markdown-body h4 {
        margin-top: 16px;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .assistant-message .markdown-body h1 { font-size: 1.5em; }
    .assistant-message .markdown-body h2 { font-size: 1.3em; }
    .assistant-message .markdown-body h3 { font-size: 1.1em; }

    /* h5 and h6 styling */
    .assistant-message .markdown-body h5 {
        font-size: 0.95em;
        font-weight: 600;
        margin: 14px 0 6px 0;
    }

    .assistant-message .markdown-body h6 {
        font-size: 0.85em;
        font-weight: 600;
        margin: 12px 0 6px 0;
        color: var(--mud-palette-text-secondary);
    }

    /* Strong and emphasis styling */
    .assistant-message .markdown-body strong {
        font-weight: 600;
        color: var(--mud-palette-text-primary);
    }

    .assistant-message .markdown-body em {
        font-style: italic;
    }

    /* Image styling */
    .assistant-message .markdown-body img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 12px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .assistant-message .markdown-body img:only-child {
        display: block;
    }
</style>

@code {
    private bool _thinkingExpanded = false;

    [Parameter]
    public required AesirChatMessage Message { get; set; }

    [Parameter]
    public string? AgentName { get; set; }

    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private string ThemeClass => IsDarkMode ? "theme-dark" : "theme-light";

    [Parameter]
    public bool ShowThinking { get; set; } = true;

    [Parameter]
    public bool ShowTimestamp { get; set; } = false;

    [Parameter]
    public DateTimeOffset? Timestamp { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public bool ShowDisclaimer { get; set; } = false;

    [Parameter]
    public bool IsLatestMessage { get; set; } = false;

    [Parameter]
    public IReadOnlyList<AesirToolCallInfo>? ToolCalls { get; set; }

    [Parameter]
    public bool ShowToolCalls { get; set; } = true;

    [Parameter]
    public bool IsStreaming { get; set; } = false;

    private void ToggleThinking()
    {
        _thinkingExpanded = !_thinkingExpanded;
    }

    private string GetThinkingSummary()
    {
        if (string.IsNullOrEmpty(Message.ThoughtsContent)) return "View thinking";

        // Generate a summary similar to Claude's style
        var content = Message.ThoughtsContent.Trim();
        var firstLine = content.Split('\n').FirstOrDefault() ?? "";

        // Clean up and truncate
        firstLine = firstLine.TrimStart('#', ' ', '-', '*');
        if (firstLine.Length > 60)
        {
            firstLine = firstLine[..57] + "...";
        }

        return string.IsNullOrWhiteSpace(firstLine)
            ? "Analyzed the request and formulated a response."
            : firstLine;
    }

    private async Task CopyToClipboard()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Message.Content);
    }

    private async Task HandleRetry()
    {
        if (OnRetry.HasDelegate)
        {
            await OnRetry.InvokeAsync();
        }
    }
}
