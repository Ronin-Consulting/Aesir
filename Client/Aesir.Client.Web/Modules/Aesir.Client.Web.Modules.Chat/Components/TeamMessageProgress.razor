@using Aesir.Common.Models
@using Aesir.Client.Web.Modules.Research.Services

<div class="research-progress">
    @* Overall Progress Section (Top) *@
    <div class="overall-progress-section">
        <div class="progress-header">
            <div class="phase-indicator">
                <MudIcon Icon="@GetPhaseIcon()" Size="Size.Small" Class="phase-icon" />
                <span class="phase-name">@GetPhaseName()</span>
            </div>
            <span class="progress-percent">@ProgressPercent%</span>
        </div>
        <div class="progress-bar-container">
            <MudProgressLinear Value="@ProgressPercent"
                               Color="Color.Secondary"
                               Striped="true"
                               Size="Size.Medium"
                               Class="progress-bar" />
        </div>
    </div>

    @* Agent Activity Section - Multi-Agent Display *@
    @if (HasActiveAgents)
    {
        <div class="agent-activity-section multi-agent">
            @foreach (var agent in ActiveAgents)
            {
                <div class="agent-row">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" Class="agent-spinner" />
                    <div class="agent-info">
                        <span class="agent-name">@agent.RoleName</span>
                        <span class="agent-activity-text">@FormatAgentActivity(agent)</span>
                    </div>
                </div>
            }
        </div>
    }
    else if (IsAgentActive && !string.IsNullOrEmpty(AgentActivity))
    {
        @* Fallback for legacy single-agent mode *@
        <div class="agent-activity-section">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" Class="agent-spinner" />
            <span class="agent-activity-text">@AgentActivity</span>
        </div>
    }

    @* Phase Steps (Bottom) *@
    <div class="phase-steps">
        @foreach (var phase in _phases)
        {
            var status = GetPhaseStatus(phase.Phase);
            <div class="phase-step @status">
                <div class="step-indicator">
                    @if (status == "completed")
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    }
                    else if (status == "active")
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" Class="step-spinner" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Circle" Size="Size.Small" />
                    }
                </div>
                <span class="step-name">@phase.Name</span>
            </div>
        }
    </div>
</div>

<style>
    .research-progress {
        background-color: rgba(156, 39, 176, 0.05);
        border-radius: 8px;
        padding: 16px;
        margin: 8px 0;
    }

    /* Overall Progress Section */
    .research-progress .overall-progress-section {
        margin-bottom: 12px;
    }

    /* Progress Header */
    .research-progress .progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .research-progress .phase-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .research-progress .phase-icon {
        color: var(--aesir-accent);
    }

    .research-progress .phase-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--mud-palette-text-primary);
    }

    .research-progress .progress-percent {
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--aesir-accent);
    }

    /* Progress Bar */
    .research-progress .progress-bar-container {
        margin-bottom: 0;
    }

    .research-progress .progress-bar {
        border-radius: 4px;
    }

    /* Agent Activity Section - Base */
    .research-progress .agent-activity-section {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background-color: rgba(var(--aesir-accent-rgb), 0.08);
        border-radius: 6px;
        margin-bottom: 12px;
        margin-top: 12px;
    }

    /* Multi-Agent Activity Section */
    .research-progress .agent-activity-section.multi-agent {
        flex-direction: column;
        gap: 8px;
        align-items: stretch;
    }

    .research-progress .agent-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .research-progress .agent-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
    }

    .research-progress .agent-name {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--aesir-accent);
    }

    .research-progress .agent-spinner {
        flex-shrink: 0;
    }

    .research-progress .agent-activity-text {
        font-size: 0.8rem;
        color: var(--mud-palette-text-secondary);
        font-weight: 400;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Single agent mode - larger text */
    .research-progress .agent-activity-section:not(.multi-agent) .agent-activity-text {
        font-size: 0.85rem;
        color: var(--mud-palette-text-primary);
        font-weight: 500;
    }

    /* Phase Steps */
    .research-progress .phase-steps {
        display: flex;
        justify-content: space-between;
        gap: 4px;
        padding-top: 12px;
        border-top: 1px solid rgba(156, 39, 176, 0.1);
    }

    .research-progress .phase-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        flex: 1;
        min-width: 0;
    }

    .research-progress .step-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
    }

    .research-progress .step-spinner {
        flex-shrink: 0;
        width: 20px !important;
        height: 20px !important;
    }

    .research-progress .phase-step.pending .step-indicator {
        color: var(--mud-palette-text-disabled);
    }

    .research-progress .phase-step.active .step-indicator {
        color: var(--aesir-accent);
    }

    .research-progress .phase-step.completed .step-indicator {
        color: var(--aesir-success);
    }

    .research-progress .step-name {
        font-size: 0.65rem;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    .research-progress .phase-step.pending .step-name {
        color: var(--mud-palette-text-disabled);
    }

    .research-progress .phase-step.active .step-name {
        color: var(--aesir-accent);
        font-weight: 600;
    }

    .research-progress .phase-step.completed .step-name {
        color: var(--aesir-success);
    }

    /* Responsive: hide step names on small screens */
    @@media (max-width: 600px) {
        .research-progress .step-name {
            display: none;
        }
    }
</style>

@code {
    [Parameter]
    public required ResearchSessionBase Session { get; set; }

    [Parameter]
    public string? ProgressMessage { get; set; }

    [Parameter]
    public int ProgressPercent { get; set; }

    /// <summary>
    /// List of currently active agents with their activities.
    /// When non-empty, displays multi-agent progress UI.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ActiveAgentInfo>? ActiveAgents { get; set; }

    /// <summary>
    /// Legacy single agent activity text.
    /// Used as fallback when ActiveAgents is empty.
    /// </summary>
    [Parameter]
    public string? AgentActivity { get; set; }

    /// <summary>
    /// Legacy flag for single agent active state.
    /// Used as fallback when ActiveAgents is empty.
    /// </summary>
    [Parameter]
    public bool IsAgentActive { get; set; }

    /// <summary>
    /// Whether any agents are currently active (multi-agent aware).
    /// </summary>
    private bool HasActiveAgents => ActiveAgents != null && ActiveAgents.Count > 0;

    private readonly List<(ResearchPhaseBase Phase, string Name)> _phases = new()
    {
        (ResearchPhaseBase.Planning, "Planning"),
        (ResearchPhaseBase.Research, "Research"),
        (ResearchPhaseBase.Anonymization, "Anonymize"),
        (ResearchPhaseBase.PeerReview, "Review"),
        (ResearchPhaseBase.Synthesis, "Synthesis")
    };

    /// <summary>
    /// Formats the agent activity for display.
    /// Uses the Activity from the agent info, or generates a default based on role.
    /// </summary>
    private string FormatAgentActivity(ActiveAgentInfo agent)
    {
        if (!string.IsNullOrWhiteSpace(agent.Activity))
            return agent.Activity;

        // Default activity based on current phase
        return Session.CurrentPhase switch
        {
            ResearchPhaseBase.Planning => "Planning research approach...",
            ResearchPhaseBase.Research => "Conducting research...",
            ResearchPhaseBase.Anonymization => "Preparing submission...",
            ResearchPhaseBase.PeerReview => "Reviewing submissions...",
            ResearchPhaseBase.Synthesis => "Synthesizing findings...",
            _ => "Working..."
        };
    }

    private string GetPhaseIcon()
    {
        if (Session.CurrentPhase == null)
            return Icons.Material.Filled.HourglassTop;

        return Session.CurrentPhase switch
        {
            ResearchPhaseBase.Clarification => Icons.Material.Filled.QuestionAnswer,
            ResearchPhaseBase.Planning => Icons.Material.Filled.EditNote,
            ResearchPhaseBase.Research => Icons.Material.Filled.Search,
            ResearchPhaseBase.Anonymization => Icons.Material.Filled.VisibilityOff,
            ResearchPhaseBase.PeerReview => Icons.Material.Filled.RateReview,
            ResearchPhaseBase.Synthesis => Icons.Material.Filled.AutoAwesome,
            _ => Icons.Material.Filled.HourglassTop
        };
    }

    private string GetPhaseName()
    {
        if (Session.CurrentPhase == null)
            return "Initializing";

        return Session.CurrentPhase switch
        {
            ResearchPhaseBase.Clarification => "Clarification",
            ResearchPhaseBase.Planning => "Planning Research",
            ResearchPhaseBase.Research => "Conducting Research",
            ResearchPhaseBase.Anonymization => "Anonymizing Work",
            ResearchPhaseBase.PeerReview => "Peer Review",
            ResearchPhaseBase.Synthesis => "Synthesizing Report",
            _ => "Processing"
        };
    }

    private string GetPhaseStatus(ResearchPhaseBase phase)
    {
        if (Session.CurrentPhase == null)
            return "pending";

        var currentPhaseOrder = GetPhaseOrder(Session.CurrentPhase.Value);
        var checkPhaseOrder = GetPhaseOrder(phase);

        if (checkPhaseOrder < currentPhaseOrder)
            return "completed";
        else if (checkPhaseOrder == currentPhaseOrder)
            return "active";
        else
            return "pending";
    }

    private int GetPhaseOrder(ResearchPhaseBase phase)
    {
        return phase switch
        {
            ResearchPhaseBase.Clarification => 0,
            ResearchPhaseBase.Planning => 1,
            ResearchPhaseBase.Research => 2,
            ResearchPhaseBase.Anonymization => 3,
            ResearchPhaseBase.PeerReview => 4,
            ResearchPhaseBase.Synthesis => 5,
            _ => 0
        };
    }
}
