@* AESIR Processing Indicator - Animated brand icon with shimmering status text *@

<div class="aesir-processing">
    <div class="aesir-icon @(_isActive ? "active" : "")">
        <img src="images/logo-blue.svg" alt="AESIR" class="brand-icon-animated" />
    </div>
    @if (_isActive && !string.IsNullOrEmpty(_currentStatus))
    {
        <span class="status-text">
            <span class="shimmer-text">@_currentStatus</span>
        </span>
    }
</div>

<style>
    .aesir-processing {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 16px 24px;
    }

    .aesir-icon {
        width: 60px;
        height: 60px;
        flex-shrink: 0;
        opacity: 0.5;
    }

    .aesir-icon .brand-icon-animated {
        width: 100%;
        height: 100%;
    }

    /* Active state animations */
    .aesir-icon.active .brand-icon-animated {
        animation: pulse 1.5s ease-in-out infinite, gentle-spin 4s ease-in-out infinite;
        transform-origin: center;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    @@keyframes gentle-spin {
        0%, 100% { transform: rotate(-5deg); }
        50% { transform: rotate(5deg); }
    }

    /* Shimmer text effect */
    .status-text {
        position: relative;
        overflow: hidden;
    }

    .shimmer-text {
        font-size: 0.875rem;
        font-style: italic;
        color: var(--mud-palette-text-secondary);
        background: linear-gradient(
            90deg,
            var(--mud-palette-text-secondary) 0%,
            #54A9FF 25%,
            var(--mud-palette-text-secondary) 50%,
            #54A9FF 75%,
            var(--mud-palette-text-secondary) 100%
        );
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shimmer var(--shimmer-duration, 2s) linear infinite;
    }

    @@keyframes shimmer {
        0% { background-position: 200% center; }
        100% { background-position: -200% center; }
    }
</style>

@code {
    private bool _isActive;
    private string _currentStatus = string.Empty;
    private int _statusIndex;
    private System.Timers.Timer? _statusTimer;
    private Random _random = new();

    private readonly string[] _statusMessages =
    [
        "Thinking...",
        "Ruminating...",
        "Contemplating...",
        "Processing...",
        "Analyzing...",
        "Formulating...",
        "Synthesizing...",
        "Reflecting...",
        "Pondering...",
        "Considering...",
        "Reasoning...",
        "Cogitating...",
        "Deliberating...",
        "Examining...",
        "Evaluating...",
        "Researching...",
        "Connecting ideas...",
        "Weighing options...",
        "Gathering thoughts...",
        "Piecing together...",
        "Working through it...",
        "Almost there...",
        "Diving deeper...",
        "Exploring possibilities...",
        "Crafting response...",
        "Refining thoughts...",
        "Building context...",
        "Assembling insights...",
        "Mapping concepts...",
        "Distilling wisdom..."
    ];

    [Parameter]
    public bool IsProcessing { get; set; }

    [Parameter]
    public string? CustomStatus { get; set; }

    protected override void OnParametersSet()
    {
        if (IsProcessing && !_isActive)
        {
            StartProcessing();
        }
        else if (!IsProcessing && _isActive)
        {
            StopProcessing();
        }
    }

    private void StartProcessing()
    {
        _isActive = true;
        _statusIndex = _random.Next(_statusMessages.Length);
        _currentStatus = CustomStatus ?? _statusMessages[_statusIndex];

        // Rotate status messages at varying intervals
        _statusTimer = new System.Timers.Timer(GetRandomInterval());
        _statusTimer.Elapsed += OnStatusTimerElapsed;
        _statusTimer.AutoReset = true;
        _statusTimer.Start();
    }

    private void StopProcessing()
    {
        _isActive = false;
        _statusTimer?.Stop();
        _statusTimer?.Dispose();
        _statusTimer = null;
    }

    private void OnStatusTimerElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (!string.IsNullOrEmpty(CustomStatus)) return;

        _statusIndex = (_statusIndex + 1) % _statusMessages.Length;
        _currentStatus = _statusMessages[_statusIndex];

        // Vary the timer interval for organic feel
        if (_statusTimer != null)
        {
            _statusTimer.Interval = GetRandomInterval();
        }

        InvokeAsync(StateHasChanged);
    }

    private double GetRandomInterval()
    {
        // Random interval between 1.5 and 4 seconds
        return 1500 + _random.NextDouble() * 2500;
    }

    public void Dispose()
    {
        _statusTimer?.Stop();
        _statusTimer?.Dispose();
    }
}
