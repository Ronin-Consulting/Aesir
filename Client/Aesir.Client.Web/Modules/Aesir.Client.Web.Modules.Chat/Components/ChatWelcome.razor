@using Aesir.Client.Web.Modules.Chat.Models
@inject IChatStateService ChatState
@inject IConfigurationApiService ConfigurationApi
@inject NavigationManager Navigation

<div class="chat-welcome-container">
    @* Atmospheric gradient background *@
    <div class="welcome-atmosphere"></div>

    @if (_isLoading)
    {
        <div class="welcome-state-content">
            <div class="loading-orb">
                <img src="images/logo-blue.svg" alt="" class="loading-logo" />
            </div>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4 fade-in">Initializing...</MudText>
        </div>
    }
    else if (_apiError)
    {
        @* API Connection Error State *@
        <div class="welcome-state-content stagger-in">
            <div class="state-icon error-state">
                <MudIcon Icon="@Icons.Material.Filled.CloudOff" Style="font-size: 3rem;" />
            </div>

            <MudText Typo="Typo.h5" Align="Align.Center" Class="state-title">
                Unable to Connect
            </MudText>

            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="state-description">
                Could not connect to the ÆSIR server. Please check that the server is running.
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RetryLoadAsync"
                       Class="state-action">
                Retry Connection
            </MudButton>
        </div>
    }
    else if (!_hasAgents || !_hasInferenceEngines)
    {
        @* Setup Required State *@
        <div class="welcome-state-content stagger-in">
            <div class="state-icon warning-state">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="font-size: 3rem;" />
            </div>

            <MudText Typo="Typo.h5" Align="Align.Center" Class="state-title">
                Setup Required
            </MudText>

            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="state-description">
                @if (!_hasInferenceEngines)
                {
                    @("Connect an inference engine to get started.")
                }
                else
                {
                    @("Configure an AI agent to start chatting.")
                }
            </MudText>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.RocketLaunch"
                       Href="/setup"
                       Class="state-action">
                Run Setup Wizard
            </MudButton>
        </div>
    }
    else
    {
        @* Main Welcome View - Enhanced *@
        <div class="welcome-content">
            @* Hero Greeting Section *@
            <div class="greeting-section">
                <div class="greeting-logo-wrapper">
                    <img src="images/logo-blue.svg" alt="AESIR" class="greeting-logo" />
                    <div class="logo-glow"></div>
                </div>
                <h2 class="greeting-text">@_currentGreeting</h2>
            </div>

            @* Centered Input Area *@
            <div class="input-section">
                <MessageInput @ref="_messageInput"
                              OnSend="@SendMessage"
                              OnSendWithFiles="@SendMessageWithFiles"
                              OnAgentSelected="@SelectAgent"
                              IsDisabled="@(ChatState.SelectedAgent == null)"
                              GetConversationId="@GetConversationId"
                              AvailableTools="@AvailableTools"
                              DisabledToolIds="@DisabledToolIds"
                              OnToolToggled="@OnToolToggled"
                              AllowThinking="@AllowThinking"
                              SelectedThinkLevel="@SelectedThinkLevel"
                              DefaultThinkLevel="@DefaultThinkLevel"
                              OnThinkLevelChanged="@OnThinkLevelChanged" />
            </div>
        </div>
    }
</div>

<style>
    .chat-welcome-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        padding: 24px;
        min-height: 0;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    /* Atmospheric gradient background */
    .welcome-atmosphere {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
            radial-gradient(ellipse 80% 60% at 50% 20%, rgba(84, 169, 255, 0.08) 0%, transparent 50%),
            radial-gradient(ellipse 60% 50% at 80% 60%, rgba(123, 111, 255, 0.06) 0%, transparent 40%),
            radial-gradient(ellipse 50% 40% at 20% 70%, rgba(84, 169, 255, 0.05) 0%, transparent 40%);
        animation: atmosphereShift 20s ease-in-out infinite alternate;
    }

    @@keyframes atmosphereShift {
        0% {
            opacity: 0.7;
            transform: scale(1) translateY(0);
        }
        100% {
            opacity: 1;
            transform: scale(1.05) translateY(-10px);
        }
    }

    /* State content wrapper */
    .welcome-state-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        z-index: 1;
        max-width: 400px;
        text-align: center;
    }

    /* Loading orb animation */
    .loading-orb {
        position: relative;
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .loading-orb::before {
        content: '';
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 2px solid transparent;
        border-top-color: var(--aesir-primary);
        border-right-color: rgba(84, 169, 255, 0.3);
        animation: orbSpin 1.2s linear infinite;
    }

    .loading-orb::after {
        content: '';
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(84, 169, 255, 0.15) 0%, transparent 70%);
        animation: orbPulse 2s ease-in-out infinite;
    }

    .loading-logo {
        width: 48px;
        height: 48px;
        object-fit: contain;
        animation: logoFloat 2s ease-in-out infinite;
    }

    @@keyframes orbSpin {
        to { transform: rotate(360deg); }
    }

    @@keyframes orbPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.1); }
    }

    @@keyframes logoFloat {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-4px); }
    }

    /* State icons */
    .state-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .state-icon.error-state {
        background: rgba(239, 68, 68, 0.1);
        color: var(--aesir-error);
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .state-icon.warning-state {
        background: rgba(245, 158, 11, 0.1);
        color: var(--aesir-warning);
        border: 1px solid rgba(245, 158, 11, 0.2);
    }

    .state-title {
        font-weight: 500;
        color: var(--mud-palette-text-primary);
    }

    .state-description {
        max-width: 320px;
        line-height: 1.6;
    }

    .state-action {
        margin-top: 8px;
    }

    /* Main welcome content */
    .welcome-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 900px;
        gap: 48px;
        z-index: 1;
    }

    /* Greeting section */
    .greeting-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
    }

    .greeting-logo-wrapper {
        position: relative;
        width: 72px;
        height: 72px;
    }

    .greeting-logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
        position: relative;
        z-index: 1;
        filter: drop-shadow(0 0 20px rgba(84, 169, 255, 0.3));
    }

    .logo-glow {
        position: absolute;
        inset: -20px;
        background: radial-gradient(circle, rgba(84, 169, 255, 0.2) 0%, transparent 70%);
        animation: glowPulse 3s ease-in-out infinite;
        z-index: 0;
    }

    @@keyframes glowPulse {
        0%, 100% { opacity: 0.5; transform: scale(1); }
        50% { opacity: 0.8; transform: scale(1.1); }
    }

    .greeting-text {
        font-size: 1.75rem;
        font-weight: 400;
        letter-spacing: -0.02em;
        color: var(--mud-palette-text-primary);
        text-align: center;
        margin: 0;
    }

    .input-section {
        width: 100%;
        margin-top: 16px;
    }

    /* Staggered animation for state content */
    .stagger-in > *:nth-child(1) { animation: fadeSlideIn 0.4s ease-out 0s forwards; opacity: 0; }
    .stagger-in > *:nth-child(2) { animation: fadeSlideIn 0.4s ease-out 0.1s forwards; opacity: 0; }
    .stagger-in > *:nth-child(3) { animation: fadeSlideIn 0.4s ease-out 0.2s forwards; opacity: 0; }
    .stagger-in > *:nth-child(4) { animation: fadeSlideIn 0.4s ease-out 0.3s forwards; opacity: 0; }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fade-in {
        animation: fadeIn 0.4s ease-out forwards;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .greeting-text {
            font-size: 1.4rem;
        }

        .greeting-logo-wrapper {
            width: 60px;
            height: 60px;
        }

        .welcome-content {
            gap: 32px;
        }
    }
</style>

@code {
    [Parameter]
    public EventCallback<AesirAgentBase> OnAgentSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSend { get; set; }

    [Parameter]
    public EventCallback<(string Message, List<PendingFileUpload> Files)> OnSendWithFiles { get; set; }

    /// <summary>
    /// Callback to get the conversation ID from the parent component.
    /// Used for immediate file upload on selection.
    /// </summary>
    [Parameter]
    public Func<Guid>? GetConversationId { get; set; }

    /// <summary>
    /// The list of available tools for the current agent.
    /// </summary>
    [Parameter]
    public IReadOnlyList<AesirToolBase> AvailableTools { get; set; } = [];

    /// <summary>
    /// The set of tool IDs that are currently disabled.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid> DisabledToolIds { get; set; } = new HashSet<Guid>();

    /// <summary>
    /// Event callback when a tool is toggled on/off.
    /// </summary>
    [Parameter]
    public EventCallback<(Guid ToolId, bool Enabled)> OnToolToggled { get; set; }

    /// <summary>
    /// Whether the agent supports thinking mode.
    /// </summary>
    [Parameter]
    public bool AllowThinking { get; set; }

    /// <summary>
    /// The currently selected think level.
    /// </summary>
    [Parameter]
    public ThinkValue? SelectedThinkLevel { get; set; }

    /// <summary>
    /// The agent's default think level.
    /// </summary>
    [Parameter]
    public ThinkValue? DefaultThinkLevel { get; set; }

    /// <summary>
    /// Event callback when the think level changes.
    /// </summary>
    [Parameter]
    public EventCallback<ThinkValue?> OnThinkLevelChanged { get; set; }

    private MessageInput? _messageInput;

    /// <summary>
    /// Adds a file to the pending files list (used by drag-and-drop from parent).
    /// </summary>
    public async Task AddFileAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        if (_messageInput != null)
        {
            await _messageInput.AddFileAsync(file);
        }
    }

    /// <summary>
    /// Gets whether RAG is enabled for the current agent.
    /// </summary>
    public bool IsRagEnabled => _messageInput?.IsRagEnabled ?? false;

    private static readonly string[] Greetings =
    [
        // Original 15
        "How can I help you today?",
        "What would you like to explore?",
        "Ready to assist you",
        "What's on your mind?",
        "Let's create something amazing",
        "What can I do for you?",
        "How may I assist you?",
        "What brings you here today?",
        "Ready when you are",
        "What shall we work on?",
        "How can I be of service?",
        "What would you like to know?",
        "Let's get started",
        "At your service",
        "What can we accomplish together?",
        // Additional 15
        "What challenge can I help you solve?",
        "Let's build something great",
        "How can I make your day easier?",
        "What's the plan for today?",
        "Ready to dive in",
        "What problem shall we tackle?",
        "Let's make something happen",
        "What's next on the agenda?",
        "Here to help you succeed",
        "What ideas are we exploring?",
        "Let's turn ideas into reality",
        "What questions do you have?",
        "Ready to collaborate",
        "What's your goal for today?",
        "Let's figure this out together"
    ];

    private static readonly Random _random = new();

    private bool _isLoading = true;
    private bool _hasAgents;
    private bool _hasInferenceEngines;
    private bool _apiError;
    private List<AesirAgentBase> _agents = new();
    private string _currentGreeting = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentGreeting = GetRandomGreeting();
        await LoadConfigurationStatusAsync();
    }

    private static string GetRandomGreeting()
    {
        return Greetings[_random.Next(Greetings.Length)];
    }

    private async Task LoadConfigurationStatusAsync()
    {
        _isLoading = true;
        _apiError = false;
        StateHasChanged();

        try
        {
            // Check agents
            var agentsResult = await ConfigurationApi.GetAgentsAsync();
            agentsResult
                .OnSuccess(agents =>
                {
                    _hasAgents = agents.Any();
                    _agents = agents.ToList();

                    // Auto-select first agent if none selected
                    if (_hasAgents && ChatState.SelectedAgent == null)
                    {
                        ChatState.SelectAgent(_agents.First());
                    }
                })
                .OnFailure(_ => _apiError = true);

            // Check inference engines
            var enginesResult = await ConfigurationApi.GetInferenceEnginesAsync();
            enginesResult
                .OnSuccess(engines => _hasInferenceEngines = engines.Any())
                .OnFailure(_ => _apiError = true);
        }
        catch
        {
            _apiError = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RetryLoadAsync()
    {
        await LoadConfigurationStatusAsync();
    }

    private async Task SelectAgent(AesirAgentBase agent)
    {
        ChatState.SelectAgent(agent);
        await OnAgentSelected.InvokeAsync(agent);
        StateHasChanged();
    }

    private async Task SendMessage(string message)
    {
        await OnSend.InvokeAsync(message);
    }

    private async Task SendMessageWithFiles((string Message, List<PendingFileUpload> Files) data)
    {
        await OnSendWithFiles.InvokeAsync(data);
    }
}
