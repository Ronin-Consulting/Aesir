@page "/settings/tools"
@layout Aesir.Client.Web.Modules.Chat.Layout.ChatLayout

<PageTitle>Tools - AESIR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4">Tools</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage internal tools and view discovered MCP server tools.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Internal Tool
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    <MudStack Row="true" Class="mb-4" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle2" Class="mr-2">Filter by type:</MudText>
        <MudChipSet T="ToolType?" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="_selectedFilter" CheckMark="true">
            <MudChip T="ToolType?" Value="@((ToolType?)null)" Default="true">All</MudChip>
            <MudChip T="ToolType?" Value="ToolType.Internal" Color="Color.Primary">Internal</MudChip>
            <MudChip T="ToolType?" Value="ToolType.McpServer" Color="Color.Secondary">MCP Server</MudChip>
        </MudChipSet>
    </MudStack>

    <MudDataGrid T="AesirToolBase"
                 Items="@FilteredTools"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Elevation="0"
                 Outlined="true"
                 Loading="@_isLoading"
                 LoadingProgressColor="Color.Primary">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Type" Title="Type">
                <CellTemplate>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetTypeColor(context.Item.Type)">
                        @GetTypeDisplayName(context.Item.Type)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <TemplateColumn Title="Source" Sortable="false">
                <CellTemplate>
                    @if (context.Item.Type == ToolType.McpServer && context.Item.McpServerId.HasValue)
                    {
                        var server = _servers.FirstOrDefault(s => s.Id == context.Item.McpServerId);
                        if (server != null)
                        {
                            <MudLink Href="@($"/settings/mcp-servers")">@server.Name</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Unknown Server</MudText>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Built-in</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    @if (context.Item.Type == ToolType.Internal)
                    {
                        <MudStack Row="true" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="@(() => OpenEditDialog(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => ConfirmDelete(context.Item))" />
                        </MudStack>
                    }
                    else
                    {
                        <MudTooltip Text="MCP tools are managed by their server">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Disabled="true" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body1">No tools configured.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Add internal tools or discover them from MCP servers.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudContainer>

@code {
    [Inject] private IToolService ToolService { get; set; } = null!;
    [Inject] private IMcpServerService McpServerService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private IReadOnlyList<AesirToolBase> _tools = [];
    private IReadOnlyList<AesirMcpServerBase> _servers = [];
    private bool _isLoading = true;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Settings", href: "/settings", icon: Icons.Material.Filled.Settings),
        new BreadcrumbItem("Tools", href: null, disabled: true)
    ];
    private string? _errorMessage;
    private ToolType? _selectedFilter;

    private IEnumerable<AesirToolBase> FilteredTools =>
        _selectedFilter.HasValue
            ? _tools.Where(t => t.Type == _selectedFilter.Value)
            : _tools;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        // Load tools and servers in parallel
        var toolsTask = ToolService.GetAllAsync();
        var serversTask = McpServerService.GetAllAsync();

        await Task.WhenAll(toolsTask, serversTask);

        var toolsResult = await toolsTask;
        var serversResult = await serversTask;

        toolsResult
            .OnSuccess(tools => _tools = tools)
            .OnFailure(error => _errorMessage = error);

        serversResult
            .OnSuccess(servers => _servers = servers);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ToolEditDialog>
        {
            { x => x.Tool, new AesirToolBase { Type = ToolType.Internal } },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ToolEditDialog>("Create Internal Tool", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Tool created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirToolBase tool)
    {
        var parameters = new DialogParameters<ToolEditDialog>
        {
            { x => x.Tool, tool },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ToolEditDialog>("Edit Tool", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Tool updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirToolBase tool)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the tool \"{tool.Name}\"? This action cannot be undone." },
            { x => x.ItemName, tool.Name ?? "this tool" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && tool.Id.HasValue)
        {
            var deleteResult = await ToolService.DeleteAsync(tool.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("Tool deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadDataAsync();
        }
    }

    private static Color GetTypeColor(ToolType? type) => type switch
    {
        ToolType.Internal => Color.Primary,
        ToolType.McpServer => Color.Secondary,
        _ => Color.Default
    };

    private static string GetTypeDisplayName(ToolType? type) => type switch
    {
        ToolType.Internal => "Internal",
        ToolType.McpServer => "MCP Server",
        null => "Unknown",
        _ => type.ToString() ?? "Unknown"
    };
}
