@page "/settings"
@layout ChatLayout
@inject ISettingsTabRegistry TabRegistry

<PageTitle>Settings - AESIR</PageTitle>

<div class="settings-title-container">
    <span class="settings-title">Settings</span>
</div>

<SettingsTabs SelectedTab="@_selectedTab" OnTabChanged="HandleTabChanged">
    @switch (_selectedTab)
    {
        case "general":
            <GeneralSettingsContent />
            break;
        case "inference-engines":
            <InferenceEnginesContent />
            break;
        case "mcp-servers":
            <McpServersContent />
            break;
        case "tools":
            <ToolsContent />
            break;
        case "agents":
            <AgentsContent />
            break;
        case "research-teams":
            <ResearchTeamsContent />
            break;
        default:
            {
                // Check for dynamically registered tab
                var dynamicTab = TabRegistry.GetTab(_selectedTab);
                if (dynamicTab != null)
                {
                    <DynamicComponent Type="@dynamicTab.ContentComponentType" />
                }
                else
                {
                    <GeneralSettingsContent />
                }
            }
            break;
    }
</SettingsTabs>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string _selectedTab = "general";

    protected override void OnParametersSet()
    {
        _selectedTab = Tab ?? "general";
    }

    private void HandleTabChanged(string tabId)
    {
        _selectedTab = tabId;
        NavigationManager.NavigateTo($"/settings?tab={tabId}", replace: true);
    }
}

<style>
    .settings-title-container {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .settings-title {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--mud-palette-text-primary);
        line-height: 1;
    }
</style>
