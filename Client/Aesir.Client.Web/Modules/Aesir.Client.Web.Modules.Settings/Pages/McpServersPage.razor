@page "/settings/mcp-servers"
@layout Aesir.Client.Web.Modules.Chat.Layout.ChatLayout

<PageTitle>MCP Servers - AESIR</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4">MCP Servers</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure Model Context Protocol servers for tool integration.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Add Server
        </MudButton>
    </MudStack>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    <MudDataGrid T="AesirMcpServerBase"
                 Items="@_servers"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 Elevation="0"
                 Outlined="true"
                 Loading="@_isLoading"
                 LoadingProgressColor="Color.Primary">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Location" Title="Location">
                <CellTemplate>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetLocationColor(context.Item.Location)">
                        @GetLocationDisplayName(context.Item.Location)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Description" Title="Description" />
            <TemplateColumn Title="Connection" Sortable="false">
                <CellTemplate>
                    @if (context.Item.Location == ServerLocation.Local)
                    {
                        <MudText Typo="Typo.body2">@context.Item.Command</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@context.Item.Url</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1">
                        <MudTooltip Text="Discover Tools">
                            <MudIconButton Icon="@Icons.Material.Filled.Search"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           OnClick="@(() => DiscoverToolsAsync(context.Item))" />
                        </MudTooltip>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenEditDialog(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => ConfirmDelete(context.Item))" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body1">No MCP servers configured.</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Click "Add Server" to create your first MCP server.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudContainer>

@code {
    [Inject] private IMcpServerService McpServerService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private IReadOnlyList<AesirMcpServerBase> _servers = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Settings", href: "/settings", icon: Icons.Material.Filled.Settings),
        new BreadcrumbItem("MCP Servers", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadServersAsync();
    }

    private async Task LoadServersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await McpServerService.GetAllAsync();

        result
            .OnSuccess(servers => _servers = servers)
            .OnFailure(error => _errorMessage = error);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<McpServerEditDialog>
        {
            { x => x.Server, new AesirMcpServerBase() },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<McpServerEditDialog>("Create MCP Server", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadServersAsync();
            Snackbar.Add("MCP server created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirMcpServerBase server)
    {
        var parameters = new DialogParameters<McpServerEditDialog>
        {
            { x => x.Server, server },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<McpServerEditDialog>("Edit MCP Server", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadServersAsync();
            Snackbar.Add("MCP server updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirMcpServerBase server)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the MCP server \"{server.Name}\"? This will also remove any discovered tools. This action cannot be undone." },
            { x => x.ItemName, server.Name ?? "this server" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && server.Id.HasValue)
        {
            var deleteResult = await McpServerService.DeleteAsync(server.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("MCP server deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadServersAsync();
        }
    }

    private async Task DiscoverToolsAsync(AesirMcpServerBase server)
    {
        if (!server.Id.HasValue)
            return;

        Snackbar.Add("Discovering tools...", Severity.Info);

        var result = await McpServerService.DiscoverToolsAsync(server.Id.Value);

        result
            .OnSuccess(tools =>
            {
                Snackbar.Add($"Discovered {tools.Count} tool(s) from {server.Name}", Severity.Success);
            })
            .OnFailure(error =>
            {
                Snackbar.Add($"Failed to discover tools: {error}", Severity.Error);
            });
    }

    private static Color GetLocationColor(ServerLocation? location) => location switch
    {
        ServerLocation.Local => Color.Primary,
        ServerLocation.Remote => Color.Secondary,
        _ => Color.Default
    };

    private static string GetLocationDisplayName(ServerLocation? location) => location switch
    {
        ServerLocation.Local => "Local",
        ServerLocation.Remote => "Remote",
        null => "Unknown",
        _ => location.ToString() ?? "Unknown"
    };
}
