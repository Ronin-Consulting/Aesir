@namespace Aesir.Client.Web.Modules.Settings.Components

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.Build"
        Title="Tools"
        Description="Manage internal tools and view discovered MCP server tools."
        Badge="@(_tools.Count > 0 ? $"{_tools.Count} available" : null)"
        PrimaryActionText="Add Internal Tool"
        PrimaryActionIcon="@Icons.Material.Filled.Add"
        OnPrimaryAction="OpenCreateDialog" />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Filter Section *@
    <MudStack Row="true" Class="my-4" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.subtitle2" Class="mr-2">Filter by type:</MudText>
        <MudChipSet T="ToolType?" SelectionMode="SelectionMode.SingleSelection" @bind-SelectedValue="_selectedFilter" CheckMark="true">
            <MudChip T="ToolType?" Value="@((ToolType?)null)" Default="true">All</MudChip>
            <MudChip T="ToolType?" Value="ToolType.Internal" Color="Color.Primary">Internal</MudChip>
            <MudChip T="ToolType?" Value="ToolType.McpServer" Color="Color.Secondary">MCP Server</MudChip>
        </MudChipSet>
    </MudStack>

    @* Content Section *@
    <div class="content-body">
        <MudDataGrid T="AesirToolBase"
                     Items="@FilteredTools"
                     Dense="false"
                     Hover="true"
                     Striped="false"
                     Elevation="0"
                     Class="aesir-data-grid"
                     Loading="@_isLoading"
                     LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Tool" SortBy="x => x.Name">
                    <CellTemplate>
                        <div class="entity-name-cell">
                            <MudAvatar Size="Size.Medium"
                                       Class="entity-avatar"
                                       Style="@GetToolAvatarStyle(context.Item.Name)">
                                @(context.Item.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </MudAvatar>
                            <div class="entity-info">
                                <div class="entity-name">@context.Item.Name</div>
                                @if (!string.IsNullOrEmpty(context.Item.Description))
                                {
                                    <div class="entity-description">@context.Item.Description</div>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Type" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetTypeColor(context.Item.Type)"
                                 Variant="Variant.Text"
                                 Icon="@GetTypeIcon(context.Item.Type)">
                            @GetTypeDisplayName(context.Item.Type)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Source" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Type == ToolType.McpServer && context.Item.McpServerId.HasValue)
                        {
                            var server = _servers.FirstOrDefault(s => s.Id == context.Item.McpServerId);
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Outlined.Dns"
                                         Size="Size.Small"
                                         Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">
                                    @(server?.Name ?? "Unknown Server")
                                </MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@Icons.Material.Outlined.Inventory"
                                         Size="Size.Small"
                                         Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Built-in</MudText>
                            </MudStack>
                        }
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" CellStyle="width: 100px;">
                    <CellTemplate>
                        @if (context.Item.Type == ToolType.Internal)
                        {
                            <MudStack Row="true" Spacing="1" Class="row-actions">
                                <MudTooltip Text="Edit tool" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small"
                                                   Class="action-btn"
                                                   OnClick="@(() => OpenEditDialog(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete tool" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                   Size="Size.Small"
                                                   Class="action-btn action-btn-danger"
                                                   OnClick="@(() => ConfirmDelete(context.Item))" />
                                </MudTooltip>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" Spacing="1" Class="row-actions">
                                <MudTooltip Text="Managed by MCP server" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Lock"
                                                   Size="Size.Small"
                                                   Class="action-btn"
                                                   Disabled="true" />
                                </MudTooltip>
                            </MudStack>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="empty-state-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Build" Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="empty-state-title">No tools available</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-state-description">
                        Add internal tools or discover them from MCP servers
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="empty-state-action mt-4">
                        Add First Tool
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>

@code {
    [Inject] private IToolService ToolService { get; set; } = null!;
    [Inject] private IMcpServerService McpServerService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private IReadOnlyList<AesirToolBase> _tools = [];
    private IReadOnlyList<AesirMcpServerBase> _servers = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private ToolType? _selectedFilter;

    private IEnumerable<AesirToolBase> FilteredTools =>
        _selectedFilter.HasValue
            ? _tools.Where(t => t.Type == _selectedFilter.Value)
            : _tools;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        // Load tools and servers in parallel
        var toolsTask = ToolService.GetAllAsync();
        var serversTask = McpServerService.GetAllAsync();

        await Task.WhenAll(toolsTask, serversTask);

        var toolsResult = await toolsTask;
        var serversResult = await serversTask;

        toolsResult
            .OnSuccess(tools => _tools = tools)
            .OnFailure(error => _errorMessage = error);

        serversResult
            .OnSuccess(servers => _servers = servers);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ToolEditDialog>
        {
            { x => x.Tool, new AesirToolBase { Type = ToolType.Internal } },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ToolEditDialog>("Create Internal Tool", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Tool created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirToolBase tool)
    {
        var parameters = new DialogParameters<ToolEditDialog>
        {
            { x => x.Tool, tool },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ToolEditDialog>("Edit Tool", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Tool updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirToolBase tool)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the tool \"{tool.Name}\"? This action cannot be undone." },
            { x => x.ItemName, tool.Name ?? "this tool" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && tool.Id.HasValue)
        {
            var deleteResult = await ToolService.DeleteAsync(tool.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("Tool deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadDataAsync();
        }
    }

    private static Color GetTypeColor(ToolType? type) => type switch
    {
        ToolType.Internal => Color.Primary,
        ToolType.McpServer => Color.Secondary,
        _ => Color.Default
    };

    private static string GetTypeDisplayName(ToolType? type) => type switch
    {
        ToolType.Internal => "Internal",
        ToolType.McpServer => "MCP Server",
        null => "Unknown",
        _ => type.ToString() ?? "Unknown"
    };

    private static string GetTypeIcon(ToolType? type) => type switch
    {
        ToolType.Internal => Icons.Material.Outlined.Handyman,
        ToolType.McpServer => Icons.Material.Outlined.Extension,
        _ => Icons.Material.Outlined.QuestionMark
    };

    private static string GetToolAvatarStyle(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        // Generate consistent color based on name
        var hash = name.GetHashCode();
        var hue = Math.Abs(hash % 360);

        return $"background: hsl({hue}, 60%, 45%); color: white;";
    }
}
