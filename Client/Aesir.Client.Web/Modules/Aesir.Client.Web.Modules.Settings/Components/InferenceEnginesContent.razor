@namespace Aesir.Client.Web.Modules.Settings.Components

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.Memory"
        Title="Inference Engines"
        Description="Configure the AI backends used for chat completions."
        Badge="@(_engines.Count > 0 ? $"{_engines.Count} configured" : null)"
        PrimaryActionText="Add Engine"
        PrimaryActionIcon="@Icons.Material.Filled.Add"
        OnPrimaryAction="OpenCreateDialog" />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Content Section *@
    <div class="content-body">
        <MudDataGrid T="AesirInferenceEngineBase"
                     Items="@_engines"
                     Dense="false"
                     Hover="true"
                     Striped="false"
                     Elevation="0"
                     Class="aesir-data-grid"
                     Loading="@_isLoading"
                     LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Engine" SortBy="x => x.Name">
                    <CellTemplate>
                        <div class="entity-name-cell">
                            <MudAvatar Size="Size.Medium"
                                       Class="entity-avatar"
                                       Style="@GetEngineAvatarStyle(context.Item.Name)">
                                @(context.Item.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </MudAvatar>
                            <div class="entity-info">
                                <div class="entity-name">@context.Item.Name</div>
                                @if (!string.IsNullOrEmpty(context.Item.Description))
                                {
                                    <div class="entity-description">@context.Item.Description</div>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Type" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetTypeColor(context.Item.Type)"
                                 Variant="Variant.Text"
                                 Icon="@GetTypeIcon(context.Item.Type)">
                            @GetTypeDisplayName(context.Item.Type)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" CellStyle="width: 100px;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Class="row-actions">
                            <MudTooltip Text="Edit engine" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete engine" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               Class="action-btn action-btn-danger"
                                               OnClick="@(() => ConfirmDelete(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="empty-state-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Memory" Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="empty-state-title">No inference engines yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-state-description">
                        Configure your first AI backend to enable chat completions
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="empty-state-action mt-4">
                        Add First Engine
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>


@code {
    [Inject] private IInferenceEngineService EngineService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private IReadOnlyList<AesirInferenceEngineBase> _engines = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadEnginesAsync();
    }

    private async Task LoadEnginesAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await EngineService.GetAllAsync();

        result
            .OnSuccess(engines => _engines = engines)
            .OnFailure(error => _errorMessage = error);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<InferenceEngineEditDialog>
        {
            { x => x.Engine, new AesirInferenceEngineBase() },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<InferenceEngineEditDialog>("Create Inference Engine", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadEnginesAsync();
            Snackbar.Add("Inference engine created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirInferenceEngineBase engine)
    {
        var parameters = new DialogParameters<InferenceEngineEditDialog>
        {
            { x => x.Engine, engine },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<InferenceEngineEditDialog>("Edit Inference Engine", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadEnginesAsync();
            Snackbar.Add("Inference engine updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirInferenceEngineBase engine)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the inference engine \"{engine.Name}\"? This action cannot be undone." },
            { x => x.ItemName, engine.Name ?? "this engine" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && engine.Id.HasValue)
        {
            var deleteResult = await EngineService.DeleteAsync(engine.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("Inference engine deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadEnginesAsync();
        }
    }

    private static Color GetTypeColor(InferenceEngineType? type) => type switch
    {
        InferenceEngineType.Ollama => Color.Primary,
        InferenceEngineType.OpenAICompatible => Color.Secondary,
        _ => Color.Default
    };

    private static string GetTypeDisplayName(InferenceEngineType? type) => type switch
    {
        InferenceEngineType.Ollama => "Ollama",
        InferenceEngineType.OpenAICompatible => "OpenAI Compatible",
        null => "Unknown",
        _ => type.ToString() ?? "Unknown"
    };

    private static string GetTypeIcon(InferenceEngineType? type) => type switch
    {
        InferenceEngineType.Ollama => Icons.Material.Outlined.Pets,
        InferenceEngineType.OpenAICompatible => Icons.Material.Outlined.Cloud,
        _ => Icons.Material.Outlined.QuestionMark
    };

    private static string GetEngineAvatarStyle(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        // Generate consistent color based on name
        var hash = name.GetHashCode();
        var hue = Math.Abs(hash % 360);

        return $"background: hsl({hue}, 60%, 45%); color: white;";
    }
}
