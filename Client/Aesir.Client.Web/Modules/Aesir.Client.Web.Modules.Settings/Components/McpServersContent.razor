@namespace Aesir.Client.Web.Modules.Settings.Components

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.Dns"
        Title="MCP Servers"
        Description="Configure Model Context Protocol servers for tool integration."
        Badge="@(_servers.Count > 0 ? $"{_servers.Count} configured" : null)"
        PrimaryActionText="Add Server"
        PrimaryActionIcon="@Icons.Material.Filled.Add"
        OnPrimaryAction="OpenCreateDialog" />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Content Section *@
    <div class="content-body">
        <MudDataGrid T="AesirMcpServerBase"
                     Items="@_servers"
                     Dense="false"
                     Hover="true"
                     Striped="false"
                     Elevation="0"
                     Class="aesir-data-grid"
                     Loading="@_isLoading"
                     LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Server" SortBy="x => x.Name">
                    <CellTemplate>
                        <div class="entity-name-cell">
                            <MudAvatar Size="Size.Medium"
                                       Class="entity-avatar"
                                       Style="@GetServerAvatarStyle(context.Item.Name)">
                                @(context.Item.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </MudAvatar>
                            <div class="entity-info">
                                <div class="entity-name">@context.Item.Name</div>
                                @if (!string.IsNullOrEmpty(context.Item.Description))
                                {
                                    <div class="entity-description">@context.Item.Description</div>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Location" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetLocationColor(context.Item.Location)"
                                 Variant="Variant.Text"
                                 Icon="@GetLocationIcon(context.Item.Location)">
                            @GetLocationDisplayName(context.Item.Location)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Connection" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@(context.Item.Location == ServerLocation.Local ? Icons.Material.Outlined.Terminal : Icons.Material.Outlined.Link)"
                                     Size="Size.Small"
                                     Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Class="entity-description">
                                @(context.Item.Location == ServerLocation.Local ? context.Item.Command : context.Item.Url)
                            </MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" CellStyle="width: 140px;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Class="row-actions">
                            <MudTooltip Text="Discover tools" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Search"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => DiscoverToolsAsync(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Edit server" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete server" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               Class="action-btn action-btn-danger"
                                               OnClick="@(() => ConfirmDelete(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="empty-state-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Dns" Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="empty-state-title">No MCP servers yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-state-description">
                        Connect to Model Context Protocol servers to enable tool integration
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="empty-state-action mt-4">
                        Add First Server
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>

@code {
    [Inject] private IMcpServerService McpServerService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private IReadOnlyList<AesirMcpServerBase> _servers = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadServersAsync();
    }

    private async Task LoadServersAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var result = await McpServerService.GetAllAsync();

        result
            .OnSuccess(servers => _servers = servers)
            .OnFailure(error => _errorMessage = error);

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<McpServerEditDialog>
        {
            { x => x.Server, new AesirMcpServerBase() },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<McpServerEditDialog>("Create MCP Server", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadServersAsync();
            Snackbar.Add("MCP server created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirMcpServerBase server)
    {
        var parameters = new DialogParameters<McpServerEditDialog>
        {
            { x => x.Server, server },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<McpServerEditDialog>("Edit MCP Server", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadServersAsync();
            Snackbar.Add("MCP server updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirMcpServerBase server)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the MCP server \"{server.Name}\"? This will also remove any discovered tools. This action cannot be undone." },
            { x => x.ItemName, server.Name ?? "this server" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && server.Id.HasValue)
        {
            var deleteResult = await McpServerService.DeleteAsync(server.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("MCP server deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadServersAsync();
        }
    }

    private async Task DiscoverToolsAsync(AesirMcpServerBase server)
    {
        if (!server.Id.HasValue)
            return;

        Snackbar.Add("Discovering tools...", Severity.Info);

        var result = await McpServerService.DiscoverToolsAsync(server.Id.Value);

        result
            .OnSuccess(tools =>
            {
                Snackbar.Add($"Discovered {tools.Count} tool(s) from {server.Name}", Severity.Success);
            })
            .OnFailure(error =>
            {
                Snackbar.Add($"Failed to discover tools: {error}", Severity.Error);
            });
    }

    private static Color GetLocationColor(ServerLocation? location) => location switch
    {
        ServerLocation.Local => Color.Primary,
        ServerLocation.Remote => Color.Secondary,
        _ => Color.Default
    };

    private static string GetLocationDisplayName(ServerLocation? location) => location switch
    {
        ServerLocation.Local => "Local",
        ServerLocation.Remote => "Remote",
        null => "Unknown",
        _ => location.ToString() ?? "Unknown"
    };

    private static string GetLocationIcon(ServerLocation? location) => location switch
    {
        ServerLocation.Local => Icons.Material.Outlined.Computer,
        ServerLocation.Remote => Icons.Material.Outlined.Cloud,
        _ => Icons.Material.Outlined.QuestionMark
    };

    private static string GetServerAvatarStyle(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        // Generate consistent color based on name
        var hash = name.GetHashCode();
        var hue = Math.Abs(hash % 360);

        return $"background: hsl({hue}, 60%, 45%); color: white;";
    }
}
