@namespace Aesir.Client.Web.Modules.Settings.Components

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.SmartToy"
        Title="Agents"
        Description="Configure AI agents with model parameters, personas, and tool assignments."
        Badge="@(_agentViewModels.Count > 0 ? $"{_agentViewModels.Count} configured" : null)"
        PrimaryActionText="Add Agent"
        PrimaryActionIcon="@Icons.Material.Filled.Add"
        OnPrimaryAction="OpenCreateDialog" />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Content Section *@
    <div class="content-body">
        <MudDataGrid T="AgentViewModel"
                     Items="@_agentViewModels"
                     Dense="false"
                     Hover="true"
                     Striped="false"
                     Elevation="0"
                     Class="aesir-data-grid"
                     Loading="@_isLoading"
                     LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Agent" SortBy="x => x.Agent.Name">
                    <CellTemplate>
                        <div class="entity-name-cell">
                            <MudAvatar Size="Size.Medium"
                                       Class="entity-avatar"
                                       Style="@GetAgentAvatarStyle(context.Item.Agent.Name)">
                                @(context.Item.Agent.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </MudAvatar>
                            <div class="entity-info">
                                <div class="entity-name">@context.Item.Agent.Name</div>
                                @if (!string.IsNullOrEmpty(context.Item.Agent.Description))
                                {
                                    <div class="entity-description">@context.Item.Agent.Description</div>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Engine" Sortable="false">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Outlined.Memory"
                                     Size="Size.Small"
                                     Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">
                                @GetInferenceEngineName(context.Item.Agent.ChatInferenceEngineId)
                            </MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Tools" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Info"
                                 Variant="Variant.Text"
                                 Icon="@Icons.Material.Outlined.Build">
                            @context.Item.ToolCount
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" CellStyle="width: 100px;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Class="row-actions">
                            <MudTooltip Text="Edit agent" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => OpenEditDialog(context.Item.Agent))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete agent" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               Class="action-btn action-btn-danger"
                                               OnClick="@(() => ConfirmDelete(context.Item.Agent))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="empty-state-container">
                    <MudIcon Icon="@Icons.Material.Outlined.SmartToy" Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="empty-state-title">No agents yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-state-description">
                        Create your first AI agent to start orchestrating conversations
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="empty-state-action mt-4">
                        Create First Agent
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>


@code {
    [Inject] private IAgentService AgentService { get; set; } = null!;
    [Inject] private IInferenceEngineService InferenceEngineService { get; set; } = null!;
    [Inject] private IToolService ToolService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private List<AgentViewModel> _agentViewModels = [];
    private IReadOnlyList<AesirInferenceEngineBase> _inferenceEngines = [];
    private IReadOnlyList<AesirToolBase> _tools = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        // Load agents, inference engines, and tools in parallel
        var agentsTask = AgentService.GetAllAsync();
        var enginesTask = InferenceEngineService.GetAllAsync();
        var toolsTask = ToolService.GetAllAsync();

        await Task.WhenAll(agentsTask, enginesTask, toolsTask);

        var agentsResult = await agentsTask;
        var enginesResult = await enginesTask;
        var toolsResult = await toolsTask;

        enginesResult.OnSuccess(engines => _inferenceEngines = engines);
        toolsResult.OnSuccess(tools => _tools = tools);

        if (agentsResult.IsSuccess && agentsResult.Value is not null)
        {
            // Load tool counts for each agent
            var viewModels = new List<AgentViewModel>();
            foreach (var agent in agentsResult.Value)
            {
                var toolCount = 0;
                if (agent.Id.HasValue)
                {
                    var agentToolsResult = await AgentService.GetAgentToolsAsync(agent.Id.Value);
                    agentToolsResult.OnSuccess(agentTools => toolCount = agentTools.Count);
                }
                viewModels.Add(new AgentViewModel { Agent = agent, ToolCount = toolCount });
            }
            _agentViewModels = viewModels;
        }
        else
        {
            _errorMessage = agentsResult.Error;
        }

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<AgentEditDialog>
        {
            { x => x.Agent, new AesirAgentBase() },
            { x => x.IsNew, true },
            { x => x.InferenceEngines, _inferenceEngines },
            { x => x.AvailableTools, _tools }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AgentEditDialog>("Create Agent", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Agent created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(AesirAgentBase agent)
    {
        // Load current tool assignments
        IReadOnlyList<AesirToolBase> assignedTools = [];
        if (agent.Id.HasValue)
        {
            var toolsResult = await AgentService.GetAgentToolsAsync(agent.Id.Value);
            toolsResult.OnSuccess(tools => assignedTools = tools);
        }

        var parameters = new DialogParameters<AgentEditDialog>
        {
            { x => x.Agent, agent },
            { x => x.IsNew, false },
            { x => x.InferenceEngines, _inferenceEngines },
            { x => x.AvailableTools, _tools },
            { x => x.AssignedTools, assignedTools }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<AgentEditDialog>("Edit Agent", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Agent updated successfully", Severity.Success);
        }
    }

    private async Task ConfirmDelete(AesirAgentBase agent)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the agent \"{agent.Name}\"? This action cannot be undone." },
            { x => x.ItemName, agent.Name ?? "this agent" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && agent.Id.HasValue)
        {
            var deleteResult = await AgentService.DeleteAsync(agent.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("Agent deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadDataAsync();
        }
    }

    private string GetInferenceEngineName(Guid? engineId)
    {
        if (!engineId.HasValue)
            return "Not configured";

        var engine = _inferenceEngines.FirstOrDefault(e => e.Id == engineId);
        return engine?.Name ?? "Unknown";
    }

    private static string GetAgentAvatarStyle(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        // Generate consistent color based on name
        var hash = name.GetHashCode();
        var hue = Math.Abs(hash % 360);

        return $"background: hsl({hue}, 60%, 45%); color: white;";
    }

    private class AgentViewModel
    {
        public AesirAgentBase Agent { get; set; } = new();
        public int ToolCount { get; set; }
    }
}
