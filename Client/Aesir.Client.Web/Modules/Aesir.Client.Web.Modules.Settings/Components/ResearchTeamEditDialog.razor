@namespace Aesir.Client.Web.Modules.Settings.Components
@using Aesir.Common.Models

@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="Basic Info" Icon="@Icons.Material.Filled.Info">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_name"
                                  Label="Team Name"
                                  Required="true"
                                  RequiredError="Team name is required"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="_description"
                                  Label="Description"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  HelperText="Describe the team's purpose or configuration" />

                    <MudSwitch @bind-Value="_isActive"
                               Label="Active"
                               Color="Color.Primary" />
                </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Team Members" Icon="@Icons.Material.Filled.Group">
                <MudStack Spacing="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Assign agents to research roles. Each team requires exactly 4 members: Deep Diver, Synthesizer, Devil's Advocate, and Chairman.
                    </MudText>

                    @if (_members.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">
                            No team members configured. Add members below.
                        </MudAlert>
                    }

                    <MudExpansionPanels MultiExpansion="true" Elevation="0">
                        @foreach (var member in _members)
                        {
                            <MudExpansionPanel Dense="true" Style="border: 1px solid var(--mud-palette-lines-default); margin-bottom: 8px;">
                                <TitleContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@GetRoleIcon(member.Role)" Size="Size.Small" />
                                            <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                                @GetRoleDisplayName(member.Role)
                                            </MudText>
                                            <span @onclick:stopPropagation="true">
                                                <MudTooltip Text="@GetRoleDescription(member.Role)" Arrow="true" Placement="Placement.Top">
                                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" Style="cursor: pointer;" />
                                                </MudTooltip>
                                            </span>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                - @GetAgentName(member.AgentId)
                                            </MudText>
                                        </MudStack>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            @if (member.IsActive)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Active</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Inactive</MudChip>
                                            }
                                            <span @onclick:stopPropagation="true">
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Size="Size.Small"
                                                               Color="Color.Error"
                                                               OnClick="@(() => RemoveMember(member))" />
                                            </span>
                                        </MudStack>
                                    </MudStack>
                                </TitleContent>
                                <ChildContent>
                                    <MudStack Spacing="2" Class="pa-2">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="ResearchRoleBase"
                                                           @bind-Value="member.Role"
                                                           Label="Role"
                                                           Required="true"
                                                           Variant="Variant.Outlined"
                                                           AnchorOrigin="Origin.BottomCenter">
                                                    <MudSelectItem Value="ResearchRoleBase.DeepDiver">Deep Diver</MudSelectItem>
                                                    <MudSelectItem Value="ResearchRoleBase.Synthesizer">Synthesizer</MudSelectItem>
                                                    <MudSelectItem Value="ResearchRoleBase.DevilsAdvocate">Devil's Advocate</MudSelectItem>
                                                    <MudSelectItem Value="ResearchRoleBase.Chairman">Chairman</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>

                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="Guid"
                                                           @bind-Value="member.AgentId"
                                                           Label="Agent"
                                                           Required="true"
                                                           Variant="Variant.Outlined"
                                                           AnchorOrigin="Origin.BottomCenter">
                                                    @foreach (var agent in AvailableAgents.Where(a => a.Id.HasValue))
                                                    {
                                                        <MudSelectItem Value="@agent.Id!.Value">@agent.Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>

                                        <MudSwitch @bind-Value="member.IsActive"
                                                   Label="Active"
                                                   Color="Color.Primary"
                                                   Size="Size.Small" />

                                        <MudExpansionPanels Elevation="0">
                                            <MudExpansionPanel Text="Override Settings" Dense="true">
                                                <MudStack Spacing="2" Class="pt-2">
                                                    @if (IsReasoningModel(member.AgentId))
                                                    {
                                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                                            The selected agent uses a reasoning model which ignores creativity settings.
                                                        </MudAlert>
                                                    }
                                                    <MudStack Spacing="1">
                                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                            <MudText Typo="Typo.body2">
                                                                Creativity: @GetDisplayTemperature(member)
                                                            </MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                Role default: @GetRoleDefaultTemperature(member.Role).ToString("F1")
                                                            </MudText>
                                                        </MudStack>

                                                        <MudSlider T="double"
                                                                   Value="@GetSliderValue(member)"
                                                                   ValueChanged="@(v => SetSliderValue(member, v))"
                                                                   Min="0.0"
                                                                   Max="1.0"
                                                                   Step="0.01"
                                                                   Color="Color.Primary">
                                                            Higher = more creative, Lower = more focused
                                                        </MudSlider>

                                                        <MudButton Size="Size.Small"
                                                                   Variant="Variant.Text"
                                                                   StartIcon="@Icons.Material.Filled.Refresh"
                                                                   OnClick="@(() => ResetToDefault(member))"
                                                                   Disabled="@(member.OverrideTemperature == null)">
                                                            Reset to role default
                                                        </MudButton>
                                                    </MudStack>
                                                </MudStack>
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    </MudStack>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>

                    @if (_members.Count < MaxMembers)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddMember"
                                   FullWidth="true">
                            Add Team Member (@(_members.Count)/@MaxMembers)
                        </MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">
                            All @MaxMembers team member slots filled.
                        </MudAlert>
                    }

                    @if (!HasRequiredRoles)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            Team requires all 4 roles: Deep Diver, Synthesizer, Devil's Advocate, and Chairman.
                            Missing: @string.Join(", ", GetMissingRoles())
                        </MudAlert>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Save"
                   Disabled="@(!IsValid)">
            @(IsNew ? "Create" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int MaxMembers = 4;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public ResearchTeamBase Team { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public IReadOnlyList<AesirAgentBase> AvailableAgents { get; set; } = [];

    [Inject] private IResearchTeamApiService ResearchTeamService { get; set; } = null!;

    // Basic Info
    private string? _name;
    private string? _description;
    private bool _isActive = true;

    // Members
    private List<ResearchTeamMemberBase> _members = [];

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_name) &&
        HasRequiredRoles;

    private bool HasRequiredRoles =>
        _members.Any(m => m.Role == ResearchRoleBase.DeepDiver && m.IsActive) &&
        _members.Any(m => m.Role == ResearchRoleBase.Synthesizer && m.IsActive) &&
        _members.Any(m => m.Role == ResearchRoleBase.DevilsAdvocate && m.IsActive) &&
        _members.Any(m => m.Role == ResearchRoleBase.Chairman && m.IsActive);

    protected override void OnParametersSet()
    {
        _name = Team.Name;
        _description = Team.Description;
        _isActive = Team.IsActive;
        _members = Team.Members?.Select(m => new ResearchTeamMemberBase
        {
            Id = m.Id,
            ResearchTeamId = m.ResearchTeamId,
            Role = m.Role,
            AgentId = m.AgentId,
            IsActive = m.IsActive,
            OverrideTemperature = m.OverrideTemperature
        }).ToList() ?? [];
    }

    private void AddMember()
    {
        var defaultAgentId = AvailableAgents.FirstOrDefault(a => a.Id.HasValue)?.Id ?? Guid.Empty;
        _members.Add(new ResearchTeamMemberBase
        {
            Role = GetNextRecommendedRole(),
            AgentId = defaultAgentId,
            IsActive = true
        });
    }

    private ResearchRoleBase GetNextRecommendedRole()
    {
        // Recommend roles that are missing
        if (!_members.Any(m => m.Role == ResearchRoleBase.DeepDiver))
            return ResearchRoleBase.DeepDiver;
        if (!_members.Any(m => m.Role == ResearchRoleBase.Synthesizer))
            return ResearchRoleBase.Synthesizer;
        if (!_members.Any(m => m.Role == ResearchRoleBase.DevilsAdvocate))
            return ResearchRoleBase.DevilsAdvocate;
        if (!_members.Any(m => m.Role == ResearchRoleBase.Chairman))
            return ResearchRoleBase.Chairman;

        // Default to DeepDiver for additional members
        return ResearchRoleBase.DeepDiver;
    }

    private IEnumerable<string> GetMissingRoles()
    {
        if (!_members.Any(m => m.Role == ResearchRoleBase.DeepDiver && m.IsActive))
            yield return "Deep Diver";
        if (!_members.Any(m => m.Role == ResearchRoleBase.Synthesizer && m.IsActive))
            yield return "Synthesizer";
        if (!_members.Any(m => m.Role == ResearchRoleBase.DevilsAdvocate && m.IsActive))
            yield return "Devil's Advocate";
        if (!_members.Any(m => m.Role == ResearchRoleBase.Chairman && m.IsActive))
            yield return "Chairman";
    }

    private void RemoveMember(ResearchTeamMemberBase member)
    {
        _members.Remove(member);
    }

    private string GetAgentName(Guid agentId) =>
        AvailableAgents.FirstOrDefault(a => a.Id == agentId)?.Name ?? "Not assigned";

    private string GetRoleDisplayName(ResearchRoleBase role) => role switch
    {
        ResearchRoleBase.DeepDiver => "Deep Diver",
        ResearchRoleBase.Synthesizer => "Synthesizer",
        ResearchRoleBase.DevilsAdvocate => "Devil's Advocate",
        ResearchRoleBase.Chairman => "Chairman",
        _ => role.ToString()
    };

    private string GetRoleIcon(ResearchRoleBase role) => role switch
    {
        ResearchRoleBase.DeepDiver => Icons.Material.Filled.Search,
        ResearchRoleBase.Synthesizer => Icons.Material.Filled.AutoAwesome,
        ResearchRoleBase.DevilsAdvocate => Icons.Material.Filled.Psychology,
        ResearchRoleBase.Chairman => Icons.Material.Filled.Groups,
        _ => Icons.Material.Filled.Person
    };

    private string GetRoleDescription(ResearchRoleBase role) => role switch
    {
        ResearchRoleBase.DeepDiver => "Conducts thorough, in-depth research on specific topics. Digs deep into sources, extracts detailed information, and provides comprehensive analysis.",
        ResearchRoleBase.Synthesizer => "Combines and integrates findings from multiple sources. Creates cohesive summaries, identifies patterns, and produces unified conclusions.",
        ResearchRoleBase.DevilsAdvocate => "Challenges assumptions and findings. Questions conclusions, identifies weaknesses, and ensures research is robust and well-reasoned.",
        ResearchRoleBase.Chairman => "Coordinates the research team. Assigns tasks, manages workflow, consolidates final results, and ensures quality and completeness.",
        _ => "Research team member."
    };

    private static double GetRoleDefaultTemperature(ResearchRoleBase role) => role switch
    {
        ResearchRoleBase.DeepDiver => 0.3,
        ResearchRoleBase.Synthesizer => 0.5,
        ResearchRoleBase.DevilsAdvocate => 0.4,
        ResearchRoleBase.Chairman => 0.2,
        _ => 0.5
    };

    private string GetDisplayTemperature(ResearchTeamMemberBase member)
    {
        var value = member.OverrideTemperature ?? GetRoleDefaultTemperature(member.Role);
        var suffix = member.OverrideTemperature == null ? " (default)" : "";
        return $"{value:F2}{suffix}";
    }

    private double GetSliderValue(ResearchTeamMemberBase member) =>
        member.OverrideTemperature ?? GetRoleDefaultTemperature(member.Role);

    private void SetSliderValue(ResearchTeamMemberBase member, double value) =>
        member.OverrideTemperature = value;

    private void ResetToDefault(ResearchTeamMemberBase member) =>
        member.OverrideTemperature = null;

    private bool IsReasoningModel(Guid agentId)
    {
        var agent = AvailableAgents.FirstOrDefault(a => a.Id == agentId);
        if (agent?.ChatModel == null) return false;

        var model = agent.ChatModel.ToLowerInvariant();

        // OpenAI reasoning models: o1, o1-mini, o1-pro, o3, o3-mini, o4-mini, gpt-5, gpt-oss
        // These models either ignore temperature (reasoning) or strongly recommend temp=1 (gpt-oss)
        return model.StartsWith("o1") ||
               model.StartsWith("o3") ||
               model.StartsWith("o4") ||
               model.StartsWith("gpt-5") ||
               model.StartsWith("gpt-oss");
    }

    private async Task Save()
    {
        // Update team properties
        Team.Name = _name;
        Team.Description = _description;
        Team.IsActive = _isActive;
        Team.Members = _members;

        if (IsNew)
        {
            var createResult = await ResearchTeamService.CreateTeamAsync(Team);
            if (createResult.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(createResult.Value?.Id));
            }
            else
            {
                Snackbar.Add($"Failed to create team: {createResult.Error}", Severity.Error);
            }
        }
        else
        {
            var updateResult = await ResearchTeamService.UpdateTeamAsync(Team);
            if (updateResult.IsSuccess)
            {
                MudDialog.Close(DialogResult.Ok(Team.Id));
            }
            else
            {
                Snackbar.Add($"Failed to update team: {updateResult.Error}", Severity.Error);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
