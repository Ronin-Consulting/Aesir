@namespace Aesir.Client.Web.Modules.Settings.Components

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.Tune"
        Title="General Settings"
        Description="Configure RAG, Speech, and Search settings for the platform."
        ShowSaveCancel="true"
        HasChanges="_hasChanges"
        IsSaving="_isSaving"
        OnSave="SaveSettings"
        OnCancel="CancelChanges"
        ShowWarning="true"
        WarningText="Changes require a server restart to take effect." />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Content Section *@
    <div class="content-body">
        <MudStack Spacing="4">
            @* RAG Embedding Configuration Section *@
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.TextFields" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">RAG Embedding</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Configure the embedding model used for document retrieval and semantic search.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudSelect T="Guid?"
                                   Value="_settings.RagEmbeddingInferenceEngineId"
                                   Label="Inference Engine"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Disabled="@_isLoading"
                                   ValueChanged="OnEmbeddingEngineChanged">
                            <MudSelectItem Value="@((Guid?)null)">-- Select an engine --</MudSelectItem>
                            @foreach (var engine in _inferenceEngines)
                            {
                                <MudSelectItem Value="@engine.Id">@engine.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <ModelSelector @bind-SelectedModel="_settings.RagEmbeddingModel"
                                       InferenceEngineId="_settings.RagEmbeddingInferenceEngineId"
                                       Category="ModelCategory.Embedding"
                                       Label="Embedding Model"
                                       OnModelSelected="OnEmbeddingModelSelected" />
                    </MudStack>
                </MudCardContent>
            </MudCard>

            @* RAG Vision Configuration Section *@
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">RAG Vision</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Configure the vision model used for image understanding in document retrieval.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudSelect T="Guid?"
                                   Value="_settings.RagVisionInferenceEngineId"
                                   Label="Inference Engine"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Disabled="@_isLoading"
                                   ValueChanged="OnVisionEngineChanged">
                            <MudSelectItem Value="@((Guid?)null)">-- Select an engine --</MudSelectItem>
                            @foreach (var engine in _inferenceEngines)
                            {
                                <MudSelectItem Value="@engine.Id">@engine.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <ModelSelector @bind-SelectedModel="_settings.RagVisionModel"
                                       InferenceEngineId="_settings.RagVisionInferenceEngineId"
                                       Category="ModelCategory.Vision"
                                       Label="Vision Model"
                                       OnModelSelected="OnVisionModelSelected" />
                    </MudStack>
                </MudCardContent>
            </MudCard>

            @* Speech Configuration Section *@
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Speech Model</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Text-to-speech voice used for hands-free mode.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSelect T="string"
                               Value="@_selectedTtsModel"
                               ValueChanged="OnTtsModelChanged"
                               Label="Voice Model"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Disabled="@_isLoading"
                               HelperText="@GetTtsModelDescription()">
                        <MudSelectItem Value="@("Lessac")">Lessac (High Quality)</MudSelectItem>
                        <MudSelectItem Value="@("Joe")">Joe (Medium Quality)</MudSelectItem>
                    </MudSelect>
                </MudCardContent>
            </MudCard>

            @* Google Search Configuration Section *@
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Google Search</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Configure Google Custom Search for web search functionality in agents.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudStack Spacing="3">
                        <MudTextField @bind-Value="_settings.GoogleSearchEngineId"
                                      Label="Search Engine ID"
                                      Variant="Variant.Outlined"
                                      Placeholder="Enter your Google Custom Search Engine ID"
                                      HelperText="Create a search engine at programmablesearchengine.google.com"
                                      Immediate="true"
                                      TextChanged="OnSettingsChanged" />

                        <MudTextField @bind-Value="_settings.GoogleApiKey"
                                      Label="API Key"
                                      Variant="Variant.Outlined"
                                      InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                                      Placeholder="Enter your Google API Key"
                                      HelperText="Get your API key from console.cloud.google.com"
                                      Immediate="true"
                                      TextChanged="OnSettingsChanged"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      OnAdornmentClick="ToggleApiKeyVisibility" />
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudStack>
    </div>
</div>


@code {
    [Inject] private IGeneralSettingsService SettingsService { get; set; } = null!;
    [Inject] private IInferenceEngineService EngineService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;

    private AesirGeneralSettingsBase _settings = new();
    private AesirGeneralSettingsBase _originalSettings = new();
    private List<AesirInferenceEngineBase> _inferenceEngines = [];

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasChanges;
    private string? _errorMessage;
    private bool _showApiKey;

    // TTS Model configuration
    private const string LessacModelPath = "Assets/vits-piper-en_US-lessac-high/en_US-lessac-high.onnx";
    private const string JoeModelPath = "Assets/vits-piper-en_US-joe-medium/en_US-joe-medium.onnx";
    private string _selectedTtsModel = "Lessac";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            // Load inference engines for dropdowns
            var enginesResult = await EngineService.GetAllAsync();
            if (enginesResult.IsSuccess && enginesResult.Value != null)
            {
                _inferenceEngines = enginesResult.Value.ToList();
            }

            // Load current settings
            var settingsResult = await SettingsService.GetSettingsAsync();
            if (settingsResult.IsSuccess && settingsResult.Value != null)
            {
                _settings = settingsResult.Value;

                // Default to Lessac if no TTS model is configured
                if (string.IsNullOrEmpty(_settings.TtsModelPath))
                {
                    _settings.TtsModelPath = LessacModelPath;
                }

                _originalSettings = CloneSettings(_settings);
                _selectedTtsModel = GetTtsModelDisplayName();
                _hasChanges = false;
            }
            else
            {
                _errorMessage = settingsResult.Error ?? "Failed to load settings";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnEmbeddingEngineChanged(Guid? engineId)
    {
        _settings.RagEmbeddingInferenceEngineId = engineId;
        // Clear model when engine changes (ModelSelector will auto-select)
        _settings.RagEmbeddingModel = null;
        CheckForChanges();
    }

    private void OnVisionEngineChanged(Guid? engineId)
    {
        _settings.RagVisionInferenceEngineId = engineId;
        // Clear model when engine changes (ModelSelector will auto-select)
        _settings.RagVisionModel = null;
        CheckForChanges();
    }

    private void OnEmbeddingModelSelected(AesirModelInfo? model)
    {
        _settings.RagEmbeddingModel = model?.Id;
        CheckForChanges();
    }

    private void OnVisionModelSelected(AesirModelInfo? model)
    {
        _settings.RagVisionModel = model?.Id;
        CheckForChanges();
    }

    private void OnSettingsChanged(string _)
    {
        CheckForChanges();
    }

    private void OnTtsModelChanged(string model)
    {
        _selectedTtsModel = model;
        _settings.TtsModelPath = model switch
        {
            "Lessac" => LessacModelPath,
            "Joe" => JoeModelPath,
            _ => _settings.TtsModelPath
        };
        CheckForChanges();
    }

    private void CheckForChanges()
    {
        _hasChanges =
            _settings.RagEmbeddingInferenceEngineId != _originalSettings.RagEmbeddingInferenceEngineId ||
            _settings.RagEmbeddingModel != _originalSettings.RagEmbeddingModel ||
            _settings.RagVisionInferenceEngineId != _originalSettings.RagVisionInferenceEngineId ||
            _settings.RagVisionModel != _originalSettings.RagVisionModel ||
            _settings.TtsModelPath != _originalSettings.TtsModelPath ||
            _settings.GoogleSearchEngineId != _originalSettings.GoogleSearchEngineId ||
            _settings.GoogleApiKey != _originalSettings.GoogleApiKey;

        StateHasChanged();
    }

    private async Task SaveSettings()
    {
        _isSaving = true;
        _errorMessage = null;

        try
        {
            var result = await SettingsService.UpdateSettingsAndReloadAsync(_settings);

            if (result.IsSuccess)
            {
                _originalSettings = CloneSettings(_settings);
                _hasChanges = false;
                Snackbar.Add("Settings saved successfully. Configuration has been reloaded.", Severity.Success);
            }
            else
            {
                _errorMessage = result.Error ?? "Failed to save settings";
                Snackbar.Add(_errorMessage, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error saving settings: {ex.Message}";
            Snackbar.Add(_errorMessage, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CancelChanges()
    {
        if (_hasChanges)
        {
            var result = await DialogService.ShowMessageBox(
                "Discard Changes?",
                "You have unsaved changes. Are you sure you want to discard them?",
                yesText: "Discard",
                cancelText: "Keep Editing");

            if (result == true)
            {
                _settings = CloneSettings(_originalSettings);
                _hasChanges = false;
            }
        }
    }

    private void ToggleApiKeyVisibility()
    {
        _showApiKey = !_showApiKey;
    }

    private static AesirGeneralSettingsBase CloneSettings(AesirGeneralSettingsBase source)
    {
        return new AesirGeneralSettingsBase
        {
            RagEmbeddingInferenceEngineId = source.RagEmbeddingInferenceEngineId,
            RagEmbeddingModel = source.RagEmbeddingModel,
            RagVisionInferenceEngineId = source.RagVisionInferenceEngineId,
            RagVisionModel = source.RagVisionModel,
            TtsModelPath = source.TtsModelPath,
            SttModelPath = source.SttModelPath,
            VadModelPath = source.VadModelPath,
            GoogleSearchEngineId = source.GoogleSearchEngineId,
            GoogleApiKey = source.GoogleApiKey
        };
    }

    private string GetTtsModelDisplayName()
    {
        if (string.IsNullOrEmpty(_settings.TtsModelPath))
            return "Not Configured";

        if (_settings.TtsModelPath.Contains("lessac", StringComparison.OrdinalIgnoreCase))
            return "Lessac";

        if (_settings.TtsModelPath.Contains("joe", StringComparison.OrdinalIgnoreCase))
            return "Joe";

        return "Unknown";
    }

    private string GetTtsModelDescription()
    {
        var model = GetTtsModelDisplayName();
        return model switch
        {
            "Lessac" => "Professional female voice with clear articulation. Best for general use.",
            "Joe" => "Natural male voice with conversational tone. Faster processing.",
            _ => "Voice model information unavailable."
        };
    }
}
