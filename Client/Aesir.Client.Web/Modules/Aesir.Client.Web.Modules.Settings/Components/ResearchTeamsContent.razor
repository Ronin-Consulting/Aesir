@namespace Aesir.Client.Web.Modules.Settings.Components
@using Aesir.Common.Models

<div class="settings-content-container">
    <SettingsContentHeader
        Icon="@Icons.Material.Filled.Diversity3"
        Title="Research Teams"
        Description="Configure multi-agent research teams with role assignments and parameter overrides."
        Badge="@(_teams.Count > 0 ? $"{_teams.Count} teams" : null)"
        PrimaryActionText="Add Team"
        PrimaryActionIcon="@Icons.Material.Filled.Add"
        OnPrimaryAction="OpenCreateDialog" />

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="my-2" ShowCloseIcon="true" CloseIconClicked="() => _errorMessage = null">
            @_errorMessage
        </MudAlert>
    }

    @* Content Section *@
    <div class="content-body">
        <MudDataGrid T="ResearchTeamBase"
                     Items="@_teams"
                     Dense="false"
                     Hover="true"
                     Striped="false"
                     Elevation="0"
                     Class="aesir-data-grid"
                     Loading="@_isLoading"
                     LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Team" SortBy="x => x.Name">
                    <CellTemplate>
                        <div class="entity-name-cell">
                            <MudAvatar Size="Size.Medium"
                                       Class="entity-avatar"
                                       Style="@GetTeamAvatarStyle(context.Item.Name)">
                                @(context.Item.Name?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </MudAvatar>
                            <div class="entity-info">
                                <div class="entity-name">@context.Item.Name</div>
                                @if (!string.IsNullOrEmpty(context.Item.Description))
                                {
                                    <div class="entity-description">@context.Item.Description</div>
                                }
                            </div>
                        </div>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Members" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Info"
                                 Variant="Variant.Text"
                                 Icon="@Icons.Material.Outlined.Group">
                            @(context.Item.Members?.Count ?? 0)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(context.Item.IsActive ? Color.Success : Color.Default)"
                                 Variant="Variant.Text"
                                 Icon="@(context.Item.IsActive ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.PauseCircle)">
                            @(context.Item.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" CellStyle="width: 140px;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Class="row-actions">
                            <MudTooltip Text="Edit team" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => OpenEditDialog(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Duplicate team" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy"
                                               Size="Size.Small"
                                               Class="action-btn"
                                               OnClick="@(() => DuplicateTeam(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete team" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                               Size="Size.Small"
                                               Class="action-btn action-btn-danger"
                                               OnClick="@(() => ConfirmDelete(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="empty-state-container">
                    <MudIcon Icon="@Icons.Material.Outlined.Diversity3" Class="empty-state-icon" />
                    <MudText Typo="Typo.h6" Class="empty-state-title">No research teams yet</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="empty-state-description">
                        Configure multi-agent teams for collaborative research tasks
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="empty-state-action mt-4">
                        Create First Team
                    </MudButton>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>

@code {
    [Inject] private IResearchTeamApiService ResearchTeamService { get; set; } = null!;
    [Inject] private IAgentService AgentService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private List<ResearchTeamBase> _teams = [];
    private IReadOnlyList<AesirAgentBase> _agents = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        // Load teams and agents in parallel
        var teamsTask = ResearchTeamService.GetTeamsAsync();
        var agentsTask = AgentService.GetAllAsync();

        await Task.WhenAll(teamsTask, agentsTask);

        var teamsResult = await teamsTask;
        var agentsResult = await agentsTask;

        agentsResult.OnSuccess(agents => _agents = agents);

        if (teamsResult.IsSuccess && teamsResult.Value is not null)
        {
            _teams = teamsResult.Value.ToList();
        }
        else
        {
            _errorMessage = teamsResult.Error;
        }

        _isLoading = false;
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ResearchTeamEditDialog>
        {
            { x => x.Team, new ResearchTeamBase { IsActive = true, Members = [] } },
            { x => x.IsNew, true },
            { x => x.AvailableAgents, _agents }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ResearchTeamEditDialog>("Create Research Team", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Research team created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(ResearchTeamBase team)
    {
        if (!team.Id.HasValue)
        {
            Snackbar.Add("Cannot edit team: ID is missing", Severity.Error);
            return;
        }

        // Fetch the full team with members
        var teamResult = await ResearchTeamService.GetTeamAsync(team.Id.Value);
        if (!teamResult.IsSuccess || teamResult.Value is null)
        {
            Snackbar.Add($"Failed to load team: {teamResult.Error}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<ResearchTeamEditDialog>
        {
            { x => x.Team, teamResult.Value },
            { x => x.IsNew, false },
            { x => x.AvailableAgents, _agents }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ResearchTeamEditDialog>("Edit Research Team", parameters, options);
        var dialogResult = await dialog.Result;

        if (!dialogResult!.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Research team updated successfully", Severity.Success);
        }
    }

    private async Task DuplicateTeam(ResearchTeamBase team)
    {
        if (!team.Id.HasValue) return;

        var parameters = new DialogParameters<InputDialog>
        {
            { x => x.ContentText, $"Enter a name for the copy of \"{team.Name}\":" },
            { x => x.DefaultValue, $"{team.Name} (Copy)" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<InputDialog>("Duplicate Team", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is string newName && !string.IsNullOrWhiteSpace(newName))
        {
            var duplicateResult = await ResearchTeamService.DuplicateTeamAsync(team.Id.Value, newName);

            duplicateResult
                .OnSuccess(duplicatedTeam =>
                {
                    Snackbar.Add($"Team duplicated as \"{newName}\"", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to duplicate: {error}", Severity.Error);
                });

            await LoadDataAsync();
        }
    }

    private async Task ConfirmDelete(ResearchTeamBase team)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.ContentText, $"Are you sure you want to delete the research team \"{team.Name}\"? This action cannot be undone." },
            { x => x.ItemName, team.Name ?? "this team" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (!result!.Canceled && team.Id.HasValue)
        {
            var deleteResult = await ResearchTeamService.DeleteTeamAsync(team.Id.Value);

            deleteResult
                .OnSuccess(() =>
                {
                    Snackbar.Add("Research team deleted successfully", Severity.Success);
                })
                .OnFailure(error =>
                {
                    Snackbar.Add($"Failed to delete: {error}", Severity.Error);
                });

            await LoadDataAsync();
        }
    }

    private static string GetTeamAvatarStyle(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "";

        // Generate consistent color based on name
        var hash = name.GetHashCode();
        var hue = Math.Abs(hash % 360);

        return $"background: hsl({hue}, 60%, 45%); color: white;";
    }
}
