{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AESIR-POC",
  "version": "0.1.0",
  "identifier": "com.aesir.client.poc",
  "build": {
    "frontendDist": "../bin/Release/net10.0/publish/wwwroot",
    "devUrl": "http://localhost:5050",
    "beforeBuildCommand": "dotnet publish -c Release -o bin/Release/net10.0/publish"
  },
  "app": {
    "windows": [
      {
        "title": "AESIR Web Client POC",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
